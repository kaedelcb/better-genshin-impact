<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.MojangBlackListConfigWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:viewModels="clr-namespace:BetterGenshinImpact.ViewModel.Windows"
                 Width="620"
                 Height="680"
                 MinWidth="520"
                 MinHeight="480"
                 Title="本体模板拾取名单"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Auto"
                 WindowStartupLocation="CenterOwner"
                 FontFamily="{DynamicResource TextThemeFontFamily}"
                 mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="本体模板拾取名单">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="CheckmarkCircle24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border Grid.Row="1"
                Margin="20,12,20,12"
                Padding="14"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
            <TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap">
                <Run Text="判定优先级：配置组黑名单 &gt; 配置组白名单 &gt; 全局黑名单 &gt; 有图即拾取。" /><LineBreak />
                <Run Text="背包满自动加入黑名单的物品在“全局黑名单”中。" /><LineBreak />
                <Run Text="未收录的旧名单项仍会保留；勾选所有/取消勾选所有只作用于当前筛选结果。" />
            </TextBlock>
        </Border>

        <TabControl Grid.Row="2"
                    SelectedIndex="{Binding InitialTabIndex, Mode=OneWay}"
                    Margin="20,0,20,0">
            <TabControl.Resources>
                <DataTemplate x:Key="ListPanelTemplate"
                              DataType="{x:Type viewModels:MojangListViewModel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Margin="0,0,12,0"
                                        PlaceholderText="搜索交互名"
                                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Grid.Column="1"
                                      Width="96"
                                      Margin="0,0,8,0"
                                      ItemsSource="{Binding StatusFilters}"
                                      SelectedItem="{Binding StatusFilter, Mode=TwoWay}" />
                            <ComboBox Grid.Column="2"
                                      Width="96"
                                      Margin="0,0,8,0"
                                      ItemsSource="{Binding ColorFilters}"
                                      SelectedItem="{Binding ColorFilter, Mode=TwoWay}" />
                            <ui:Button Grid.Column="3"
                                       Margin="0,0,8,0"
                                       Command="{Binding SelectAllCommand}"
                                       Content="勾选所有" />
                            <ui:Button Grid.Column="4"
                                       Command="{Binding ClearAllCommand}"
                                       Content="取消勾选所有" />
                        </Grid>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding ItemsView}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,8,0,4"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DataTemplate>
            </TabControl.Resources>

            <TabItem Header="全局黑名单"
                     Visibility="{Binding IsGlobalScope, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ContentControl Content="{Binding GlobalList}"
                                ContentTemplate="{StaticResource ListPanelTemplate}" />
            </TabItem>

            <TabItem Visibility="{Binding IsGroupScope, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="白名单" />
                        <TextBlock Text="{Binding GroupName, StringFormat='（{0}）'}" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding GroupWhiteList}"
                                ContentTemplate="{StaticResource ListPanelTemplate}" />
            </TabItem>

            <TabItem Visibility="{Binding IsGroupScope, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="黑名单" />
                        <TextBlock Text="{Binding GroupName, StringFormat='（{0}）'}" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding GroupBlackList}"
                                ContentTemplate="{StaticResource ListPanelTemplate}" />
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="20,16,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                       Margin="0,0,12,0"
                       TextWrapping="Wrap"
                       Text="{Binding SaveHint}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button MinWidth="88"
                           Margin="0,0,10,0"
                           Command="{Binding CancelCommand}"
                           Content="取消"
                           IsCancel="True" />
                <ui:Button MinWidth="88"
                           Appearance="Primary"
                           Command="{Binding SaveCommand}"
                           Content="保存"
                           IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
