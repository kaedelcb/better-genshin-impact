                                              Grid.Column="0"
                                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                              Text="与手动次数取最小值，避免超过树脂可用次数。"
                                              TextWrapping="Wrap" />
                                <ui:ToggleSwitch Grid.Row="0"
                                                 Grid.RowSpan="2"
                                                 Grid.Column="1"
                                                 Margin="0,0,20,0"
                                                 IsChecked="{Binding SelectedConfig.LeyLineOpenModeCountMin, Mode=TwoWay}" />
                            </Grid>
                        </ui:CardControl.Header>
                    </ui:CardControl>

