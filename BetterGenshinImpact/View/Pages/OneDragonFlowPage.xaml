                                        <b:EventTrigger EventName="DropDownOpened">
                                            <b:InvokeCommandAction Command="{Binding StrategyDropDownOpenedCommand}"
                                                                   CommandParameter="Combat" />
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </ComboBox>
