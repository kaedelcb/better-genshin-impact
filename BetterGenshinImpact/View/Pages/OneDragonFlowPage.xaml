                                              Grid.Column="0"
                                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                              Text="留空则不更换队伍"
                                              TextWrapping="Wrap" />
                                <ui:TextBox Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="1"
                                            Width="200"
                                            Margin="0,0,36,0"
                                            Text="{Binding SelectedConfig.AutoBossTeamName, Mode=TwoWay}"
