<UserControl x:Class="BetterGenshinImpact.View.Pages.OneDragonFlowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:controls="clr-namespace:BetterGenshinImpact.View.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:behavior="clr-namespace:BetterGenshinImpact.View.Behavior"
             xmlns:helpers="clr-namespace:BetterGenshinImpact.Helpers"
             xmlns:local="clr-namespace:BetterGenshinImpact.View.Pages"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:oneDragon="clr-namespace:BetterGenshinImpact.ViewModel.Pages.OneDragon"
             xmlns:oneDragonView="clr-namespace:BetterGenshinImpact.View.Pages.OneDragon"
             xmlns:pages="clr-namespace:BetterGenshinImpact.ViewModel.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
             d:DataContext="{d:DesignInstance Type=pages:OneDragonFlowViewModel}"
             d:DesignHeight="1000"
             d:DesignWidth="800"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="{StaticResource TextThemeFontFamily}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" CommandParameter="{Binding}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    
    <Grid Margin="22,16,18,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="300" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!--  左侧任务列表  -->
       <DockPanel Grid.Column="0">
           <DockPanel.ContextMenu>
               <ContextMenu Width="90" MinWidth="90" MaxWidth="200" Visibility="{Binding FilteredConfigList.IsEmpty, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                   <MenuItem Command="{Binding AddTaskGroupCommand}" Header="新增任务" HorizontalAlignment="Center"/>
                   <MenuItem Command="{Binding DeleteTaskGroupCommand}"
                             CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                             Header="删除任务" HorizontalAlignment="Center"/>
                   <MenuItem Command="{Binding NextTaskGroupCommand}"
                             CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                             Header="从此执行" HorizontalAlignment="Center"/>
                   <MenuItem Command="{Binding ClearNextTaskGroupCommand}"
                             CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                             Header="清除标记" HorizontalAlignment="Center" />
               </ContextMenu>
           </DockPanel.ContextMenu>
       <Grid DockPanel.Dock="Top"
        Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
           
           
           <Button Command="{Binding ShowAndSwitchPlanCommand}"
                   Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                   Background="Transparent"
                   BorderThickness="0,0,0,0"
                   HorizontalContentAlignment="Left">
               <TextBlock Text="{Binding Config.SelectedOneDragonFlowPlanName, StringFormat='未选择计划', Mode=OneWay}" 
                          ToolTip="{Binding Config.SelectedOneDragonFlowPlanName, StringFormat='当前一条龙计划表: {0}'}"
                          Margin="-14,0,0,0"
                          FontSize="13"
                          TextTrimming="WordEllipsis"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"/>
           </Button>
           <ui:Button
               Grid.Column="1"
               Grid.Row="0"
               Margin="0,0,10,0"
               Appearance="Primary"
               IsEnabled="{Binding FilteredConfigList.IsEmpty, Converter={StaticResource InverseBooleanConverter}}"
               Icon="{ui:SymbolIcon PlayMultiple16}"
               Command="{Binding OneKeyContinuousExecutionOneKeyCommand}">
               <ui:Button.ToolTip>
                   <ToolTip Content="连续执行多个配置单一条龙" />
               </ui:Button.ToolTip>
           </ui:Button>
           
           <ui:Button
               Grid.Column="2"
               Grid.Row="0"
               IsEnabled="{Binding FilteredConfigList.IsEmpty, Converter={StaticResource InverseBooleanConverter}}"
               Margin="0,0,10,0"
               Appearance="Primary"
               Icon="{ui:SymbolIcon Play24}"
               Command="{Binding OneKeyExecuteCommand}">
               <ui:Button.ToolTip>
                   <ToolTip Content="执行单个配置单一条龙" />
               </ui:Button.ToolTip>
           </ui:Button>
        
            <ui:Button
                IsEnabled="{Binding FilteredConfigList.IsEmpty, Converter={StaticResource InverseBooleanConverter}}"
                Grid.Column="3"
                Grid.Row="0"
                Margin="0,0,10,0"
                Icon="{ui:SymbolIcon Add24}"
                Command="{Binding AddTaskGroupCommand}" />
         </Grid>
           
        <Grid DockPanel.Dock="Top"
            Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Separator Grid.Row="0"  Margin="0,0.5,6,0" BorderThickness="0,1,0,0" />
            
            <Button
                Grid.Row="1"
                Grid.Column="0"
                Height="300"
                Command="{Binding AddConfigCommand}"
                    Visibility="{Binding FilteredConfigList.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                    Background="Transparent"
                    BorderThickness="0,20,0,0"
                    VerticalAlignment="Top"
                    HorizontalContentAlignment="Left">
                <TextBlock Text="计划表为空 / 点击添加配置单" 
                           Margin="-14,0,0,0"
                           FontSize="13"
                           Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                           TextTrimming="WordEllipsis"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
            </Button>
        </Grid>
       
        <ContentControl Visibility="{Binding FilteredConfigList.IsEmpty, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Content">
                        <Setter.Value>
                            <ui:ListView dd:DragDrop.IsDragSource="True"
                                         dd:DragDrop.IsDropTarget="True"
                                         dd:DragDrop.UseDefaultDragAdorner="True"
                                         dd:DragDrop.SelectDroppedItems="True"
                                         ItemsSource="{Binding TaskList}"
                                         SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionMode="Single">
                                <ui:ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card 
                                            Margin="0,2,14,2">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" MaxHeight="20"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- <ui:FontIcon Grid.Column="0" -->
                                                <!--              Glyph="&#xe411;" -->
                                                <!--              Style="{StaticResource FaFontIconStyleForOneDragon}" /> -->
                                                <Button Grid.Column="0"
                                                        MaxWidth="20"
                                                        GotFocus="ConfigRow_GotFocus"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,0,0,0"
                                                        Command="{Binding Path=DataContext.ScriptControlPageCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                                    <ui:FontIcon Glyph="&#xe411;"
                                                                 GotFocus="ConfigRow_GotFocus"
                                                                 Margin="-10,0,0,0"
                                                                 VerticalAlignment="Center"
                                                                 HorizontalAlignment="Center"
                                                                 Style="{StaticResource FaFontIconStyleForOneDragon}"
                                                                 Foreground="White" />
                                                </Button>
                                                <!-- <Ellipse Grid.Column="1" -->
                                                <!--          Width="10" -->
                                                <!--          Height="10" -->
                                                <!--          Margin="0,0,8,0" -->
                                                <!--          Fill="{Binding StatusColor}" -->
                                                <!--          IsHitTestVisible="False" /> -->
                                               <TextBlock Grid.Column="2"
                                                       GotFocus="ConfigRow_GotFocus"
                                                       HorizontalAlignment="Stretch"
                                                       Background="Transparent"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name, Mode=OneWay}"
                                                       Margin="0,0,3,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" /> <!-- 默认颜色 -->
                                                        <Style.Triggers>
                                                           <DataTrigger Binding="{Binding IsNextTask, Mode=OneWay}" Value="true">
                                                                <Setter Property="Foreground" Value="DodgerBlue" /> 
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                                <ui:ToggleSwitch Grid.Column="3" GotFocus="ConfigRow_GotFocus" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ui:ListView.ItemTemplate>
                                <ui:ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <!--  添加以下设置来禁用选中效果  -->
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                                    <Border x:Name="Bd"
                                                            Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}"
                                                            SnapsToDevicePixels="true">
                                                        <ContentPresenter
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsEnabled" Value="false">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ui:ListView.ItemContainerStyle>
                            </ui:ListView>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TaskList.Count}" Value="0">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,0,0"
                                                   Text="      ± 鼠标右击添加或删除任务       "
                                                   VerticalAlignment="Top"
                                                   HorizontalAlignment="Left"
                                                   FontSize="14"
                                                   Height="800"
                                                   Width="200"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                
            </ContentControl.Style>
        </ContentControl>
    </DockPanel>

        
        
            <!--    右侧顶部 -->  
            <DockPanel Grid.Column="1" Margin="7,0,0,0">
                <StackPanel Margin="0,0,0,10" DockPanel.Dock="Top">
                    <Grid Margin="0,0,9,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <Grid.Resources>
                            <Storyboard x:Key="TextFadeStoryboard">
                                <!-- 文字逐渐出现 -->
                                <DoubleAnimation Storyboard.TargetName="ConfigTextBlock"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0"
                                                 To="1"
                                                 Duration="0:0:1" 
                                                 BeginTime="0:0:0" />
                                <!-- 文字逐渐消失 -->
                                <DoubleAnimation Storyboard.TargetName="ConfigTextBlock"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="1"
                                                 To="0"
                                                 Duration="0:0:0"
                                                 BeginTime="0:0:3" />
                                <!-- 文字逐渐出现 -->
                                <DoubleAnimation Storyboard.TargetName="ConfigTextBlock"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0"
                                                 To="1"
                                                 Duration="0:0:1" 
                                                 BeginTime="0:0:3" />
                                <!-- 文字逐渐消失 -->
                                <DoubleAnimation Storyboard.TargetName="ConfigTextBlock"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="1"
                                                 To="0"
                                                 Duration="0:0:1"
                                                 BeginTime="0:0:6" />
                                <!-- 文字直接隐藏 -->
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ConfigTextBlock"
                                                               Storyboard.TargetProperty="(UIElement.Visibility)">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:8">
                                        <DiscreteObjectKeyFrame.Value>
                                            <Visibility>Collapsed</Visibility>
                                        </DiscreteObjectKeyFrame.Value>
                                    </DiscreteObjectKeyFrame>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </Grid.Resources>

                        
                        
                        <TextBlock  Visibility="{Binding IsChecked, ElementName=PlanToggle, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Grid.Column="0"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                    VerticalAlignment="Center"
                                    Text="计划表编辑器" />
                        <TextBlock Grid.Column="0"
                                   Visibility="{Binding IsChecked, ElementName=PlanToggle, Converter={StaticResource BooleanToVisibilityRevertConverter}}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Text="配置单" 
                                   x:Name="ConfigListGrid"/>
                        
                        <TextBlock Grid.Column="1"
                                   Visibility="{Binding IsChecked, ElementName=PlanToggle, Converter={StaticResource BooleanToVisibilityRevertConverter}}"
                                   Margin="10,0,0,0"
                                   Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding SelectedConfig.GenshinUid, StringFormat='已绑定UID：{0}', Mode=OneWay}" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedConfig.AccountBinding}" Value="True"/>
                                                <Condition Binding="{Binding SelectedConfig.GenshinUid, TargetNullValue=''}" Value=""/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="未输入UID"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedConfig.AccountBinding}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="未绑定UID"/>
                                        </MultiDataTrigger>
                                        
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        
                        <TextBlock x:Name="ConfigTextBlock"
                                   Grid.Column="2"
                                   Margin="5,0,5,0"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="切换配置单编辑页面-->"
                                   Opacity="0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedConfig.AccountBinding}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="未绑定UID"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="TextBlock.Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource TextFadeStoryboard}" />
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                        <!-- 切换按钮 -->
                        <ui:Button
                            Grid.Column="5"
                            Icon="{ui:SymbolIcon CameraSwitch20}"
                            Margin="5,0,5,0"
                            Command="{Binding ShowAndSwitchPlanCommand}" />
                        
                        <ui:ToggleSwitch
                            Grid.Column="4"
                            Margin="5,0,5,0"
                            x:Name="PlanToggle" IsChecked="False"/>
                        <ComboBox Grid.Column="6"
                                  MaxWidth="150"
                                  Height="34"
                                  Margin="5,0,0,0"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding FilteredConfigList}"
                                  SelectedItem="{Binding SelectedConfig, Mode=TwoWay}"
                                  Text="{Binding SelectedConfigCache.Name, FallbackValue='未选择', TargetNullValue='未选择'}"
                                  MaxDropDownHeight="400"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="SelectionChanged">
                                    <b:InvokeCommandAction Command="{Binding ConfigDropDownChangedCommand}"
                                                           CommandParameter="GeniusInvocation" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </ComboBox>
                    </Grid>
                    <Separator Margin="0,5,5,0" BorderThickness="0,1,0,0" />
                </StackPanel>
           
                <!-- 右侧下方 -->
                <ScrollViewer 
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsEnabled="{Binding FilteredConfigList.IsEmpty ,Converter={StaticResource InverseBooleanConverter}}"
                    Visibility="{Binding IsChecked, ElementName=PlanToggle, Converter={StaticResource BooleanToVisibilityRevertConverter}}">
                    <Grid
                        Margin="0,0,8,0">
                        <StackPanel 
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                        Margin="0,0,1,0">
                       
                        <!--  合成树脂  -->
                        <Expander IsExpanded="{Binding SelectedConfig.IsCraftingResinExpanded, Mode=TwoWay}" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock FontSize="14"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                           Text="合成树脂"/>
                            </Expander.Header>
                            <StackPanel>
                                <ui:CardControl Margin="0,4,0,12" Icon="{ui:SymbolIcon WeatherMoon24}">
                                    <ui:CardControl.Header>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBlock Grid.Row="0"
                                                          Grid.Column="0"
                                                          Width="Auto"
                                                          HorizontalAlignment="Left"
                                                          FontTypography="Body"
                                                          Text="合成树脂合成台"
                                                          TextWrapping="Wrap" />
                                            <ui:TextBlock Grid.Row="1"
                                                          Grid.Column="0"
                                                          Margin=" 0,0,0,0"
                                                          Width="Auto"
                                                          HorizontalAlignment="Left"
                                                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                          Text="指定地区合成树脂"
                                                          TextWrapping="Wrap" />
                                            <ComboBox 
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Grid.RowSpan="2" 
                                                      Margin="18,0,0,0"
                                                      Width="Auto"
                                                      HorizontalContentAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      SelectedItem="{Binding SelectedConfig.CraftingBenchCountry, Mode=TwoWay}"
                                                      ItemsSource="{Binding CraftingBenchCountry}" />
                                            
                                            <ui:TextBlock Grid.Row="0"
                                                          Grid.Column="2"
                                                          Width="Auto"
                                                          Margin=" 15,0,0,0"
                                                          HorizontalAlignment="Left"
                                                          FontTypography="Body"
                                                          Text="合成后保留"
                                                          TextWrapping="Wrap" />
                                            <ui:TextBlock Grid.Row="1"
                                                          Grid.Column="2"
                                                          Margin=" 15,0,0,0"
                                                          Width="Auto"
                                                          HorizontalAlignment="Left"
                                                          Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                          Text="原粹树脂数量"
                                                          TextWrapping="Wrap" />
                                            <TextBox Grid.Row="0"
                                                     Grid.Column="3"
                                                     Grid.RowSpan="2" 
                                                     Margin="8,0,0,0" 
                                                     Width="Auto"
                                                     HorizontalContentAlignment="Center"
                                                     Text="{Binding SelectedConfig.MinResinToKeep, Mode=TwoWay, TargetNullValue=-1}"
                                                     Height="{Binding ElementName=combinedTextBlocks, Path=ActualHeight}"/>
                                        </Grid>
                                    </ui:CardControl.Header>
                                </ui:CardControl>
                            </StackPanel>
                        </Expander>

                        <!--  自动秘境  -->
                        <Expander IsExpanded="{Binding SelectedConfig.IsAutoDomainExpanded, Mode=TwoWay}" Margin="0,0,0,8">
                            <Expander.Header>
                                <TextBlock FontSize="14"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                           Text="自动秘境"/>
                            </Expander.Header>
                            <StackPanel>
                        <ui:CardExpander Margin="0,0,0,12" ContentPadding="0">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon Glyph="&#xf073;" Style="{StaticResource FaFontIconStyle}" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Grid.Row="0"
                                                  Grid.Column="0"
                                                  FontTypography="Body"
                                                  Text="每日秘境刷取配置"
                                                  TextWrapping="Wrap" />
                                    <ui:TextBlock Grid.Row="1"
                                                  Grid.Column="0"
                                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                  Text="前往指定秘境消耗树脂，并自动领取奖励"
                                                  TextWrapping="Wrap">
                                    </ui:TextBlock>
                                    <ui:ToggleSwitch Grid.Row="0"
                                                     Grid.RowSpan="2"
                                                     Grid.Column="1"
                                                     Margin="0,0,20,0"
                                                     IsChecked="{Binding SelectedConfig.WeeklyDomainEnabled, Converter={StaticResource InverseBooleanConverter}, Mode=TwoWay}" />
                                </Grid>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <Grid Margin="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Grid.Row="0"
                                                  Grid.Column="0"
                                                  FontTypography="Body"
                                                  Text="自动秘境中切换的队伍名称"
                                                  TextWrapping="Wrap" />
                                    <ui:TextBlock Grid.Row="1"
                                                  Grid.Column="0"
                                                  Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                                  Text="此项对自定义配置组任务无效"
                                                  TextWrapping="Wrap" />
                                    <ui:TextBox Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Grid.Column="1"
                                                MinWidth="150"
                                                MaxWidth="800"
                                                Margin="20,0,36,0"
                                                Text="{Binding SelectedConfig.PartyName, Mode=TwoWay}"
                                                PlaceholderText="填写队伍名称"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                </Grid>

                                <Grid Margin="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Grid.Row="0"
                                                  Grid.Column="0"
                                                  FontTypography="Body"
                                                  HorizontalAlignment="Left"
                                                  Text="选择秘境"
                                                  Width="Auto"
                                                  TextWrapping="Wrap" />
