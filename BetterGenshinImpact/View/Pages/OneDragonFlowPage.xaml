                                              Grid.Column="0"
                                              Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                              Text="每轮领取后识别奖励名称与数量，任务结束打印汇总"
                                              TextWrapping="Wrap" />
                            </Grid>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch
                            Margin="0,0,36,0"
                            IsChecked="{Binding Config.AutoDomainConfig.RewardRecognitionEnabled, Mode=TwoWay}" />
                    </ui:CardControl>

