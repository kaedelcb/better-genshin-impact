	<!-- 编译后复制助手全部输出到 BGI 输出目录下的 Tools\MultiplayerHoeingAssistant 子目录（用 $(Configuration) 兼容 Debug/Release） -->
  <Target Name="CopyMultiplayerHoeingAssistant" AfterTargets="Build">
    <Message Text="CopyMultiplayerHoeingAssistant: 复制助手全部输出到 $(OutDir)Tools\MultiplayerHoeingAssistant" Importance="high" />
    <!-- 重新编译并部署助手（已实测可靠）：
         1) 此处不可用嵌套(MSBuild Targets=Rebuild)或单个 dotnet build，因其会受 MSBuild Server 的
            内存增量缓存返回"已最新"而跳过真正C#重编，导致助手改动（版本号/功能/UI）不进入 Tools；
         2) 原方案用 dotnet clean 和 dotnet build 虽能强制重编，但 dotnet clean 是外层 shell 独立进程，
            与随后 dotnet build 之间会被 MSBuild Server 缓存判定绕过：clean 删掉了助手的
            .runtimeconfig.json / .deps.json（它们在 build 序列中生成较晚），而内层 build 若被缓存判定为
            已最新而跳过不重新生成，则 BGI 的 Copy 步骤复制这些 json 时找不到，反复报 MSB3030。
         3) 根治：改用单个 dotnet build 加 no-incremental 参数（等效于 /t:Rebuild，同一 MSBuild
            上下文内 Clean 与 Build 强绑定，Clean 删后 Build 必在同一流程重编），保证 json 始终
            重新生成，且规避 MSBuild Server 增量缓存。 -->
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\..\MultiplayerHoeingAssistant\MultiplayerHoeingAssistant.csproj&quot; -c $(Configuration) --no-incremental"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <!-- 清理 BGI 输出目录根的历史残留助手文件（早期 ProjectReference 默认复制留下的 exe/deps/runtimeconfig）。
         现在一律只允许存在于 Tools\MultiplayerHoeingAssistant 子目录，
         根目录的不属于本版本部署结构，删除以免与 Tools 副本混淆、防止手误运行错 exe。 -->
    <ItemGroup>
      <StaleAssistRoot Include="$(OutDir)MultiplayerHoeingAssistant.exe" />
      <StaleAssistRoot Include="$(OutDir)MultiplayerHoeingAssistant.dll" />
      <StaleAssistRoot Include="$(OutDir)MultiplayerHoeingAssistant.pdb" />
      <StaleAssistRoot Include="$(OutDir)MultiplayerHoeingAssistant.deps.json" />
      <StaleAssistRoot Include="$(OutDir)MultiplayerHoeingAssistant.runtimeconfig.json" />
    </ItemGroup>
    <Delete Files="@(StaleAssistRoot)" />
    <!-- 排除 assistant-config.json：它是用户运行配置（存免责同意/密码/UID/快捷绑定），
         绝不随构建覆盖到 Tools，否则每次构建都会把免责同意标记等配置复位。 -->
    <ItemGroup>
      <AssistOutput Include="$(MSBuildProjectDirectory)\..\MultiplayerHoeingAssistant\bin\$(Configuration)\net8.0-windows\**\*" Exclude="$(MSBuildProjectDirectory)\..\MultiplayerHoeingAssistant\bin\$(Configuration)\net8.0-windows\**\assistant-config.json" />
    </ItemGroup>
    <!-- 复制到 bin\Debug\...\Tools\（无 x64 平台目录） -->
    <Copy SourceFiles="@(AssistOutput)"
          DestinationFiles="@(AssistOutput->'$(OutDir)Tools\MultiplayerHoeingAssistant\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <!-- 复制到 bin\x64\Debug\...\Tools\（带 x64 平台目录，用户实际运行路径） -->
    <Copy SourceFiles="@(AssistOutput)"
          DestinationFiles="@(AssistOutput->'$(MSBuildProjectDirectory)\..\BetterGenshinImpact\bin\x64\$(Configuration)\net8.0-windows10.0.22621.0\Tools\MultiplayerHoeingAssistant\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

	<!-- 编译后复制 AutoHoeingUpdater 工具到 BGI 输出目录下的 Tools\AutoHoeingUpdater 子目录（含空目录结构） -->
	<Target Name="CopyAutoHoeingUpdater" AfterTargets="Build">
		<Message Text="CopyAutoHoeingUpdater: 复制 AutoHoeingUpdater 到 $(OutDir)Tools\AutoHoeingUpdater" Importance="high" />
		<ItemGroup>
			<UpdaterOutput Include="$(MSBuildProjectDirectory)\..\AutoHoeingUpdater\**\*" />
			<UpdaterDirs Include="$(MSBuildProjectDirectory)\..\AutoHoeingUpdater\01首次使用注意备份" />
			<UpdaterDirs Include="$(MSBuildProjectDirectory)\..\AutoHoeingUpdater\02未选择仅下载会清空所有路线" />
			<UpdaterDirs Include="$(MSBuildProjectDirectory)\..\AutoHoeingUpdater\03参考队伍与设置（截图）" />
			<UpdaterDirs Include="$(MSBuildProjectDirectory)\..\AutoHoeingUpdater\04配置组添加自动脚本即实现自动更新" />
			<UpdaterDirs Include="$(MSBuildProjectDirectory)\..\AutoHoeingUpdater\05自动更新脚本（自己修改路径）" />
		</ItemGroup>
		<MakeDir Directories="@(UpdaterDirs->'$(OutDir)Tools\AutoHoeingUpdater\%(Filename)%(Extension)')" />
		<Copy SourceFiles="@(UpdaterOutput)"
		      DestinationFiles="@(UpdaterOutput->'$(OutDir)Tools\AutoHoeingUpdater\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />
	</Target>

