<UserControl x:Class="MultiplayerHoeingAssistant.Views.TimeOfDayPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d:DesignWidth="110" d:DesignHeight="28"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <!-- 弹窗式时间选择：点击显示框弹出 时/分/秒 三列滚选列表，点选即生效；
         「现在」一键取当前时间，「完成」关闭并触发 Submitted（宿主接"搜索"等动作）。
         全程不需要键盘输入。 -->
    <Grid>
        <ToggleButton x:Name="DropButton" Cursor="Hand" Background="Transparent" BorderThickness="0"
                      ToolTip="点击弹出时间选择">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="#2A1C1640" BorderBrush="#80D4AF37"
                            BorderThickness="1" CornerRadius="7" Padding="10,4" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ValueText" FontSize="12" FontWeight="Medium"
                                       Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Foreground="#FFFFFF" VerticalAlignment="Center"
                                       FontFamily="Consolas"/>
                            <TextBlock Text="▾" FontSize="10" Foreground="#D4AF37"
                                       VerticalAlignment="Center" Margin="6,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#38251040"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3B2E1A40"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#F0E8C96D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="PickerPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=DropButton, Mode=TwoWay}"
               Opened="PickerPopup_Opened">
            <Border Background="#232048" BorderBrush="#80D4AF37" BorderThickness="1"
                    CornerRadius="8" Padding="8" Margin="0,4,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 三列滚选：时(00-23) / 分(00-59) / 秒(00-59) -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="时" FontSize="10" Foreground="#9C97C0" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <ListBox x:Name="HourList" Width="46" MaxHeight="150" Background="Transparent"
                                     BorderThickness="1" BorderBrush="#40D4AF37"
                                     FontSize="12" Foreground="#F4F2FA" SelectionChanged="List_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#3DD4AF37"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#D4AF37"/>
                                                            <Setter Property="Foreground" Value="#1E2230"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="分" FontSize="10" Foreground="#9C97C0" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <ListBox x:Name="MinuteList" Width="46" MaxHeight="150" Background="Transparent"
                                     BorderThickness="1" BorderBrush="#40D4AF37"
                                     FontSize="12" Foreground="#F4F2FA" SelectionChanged="List_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#3DD4AF37"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#D4AF37"/>
                                                            <Setter Property="Foreground" Value="#1E2230"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                            <TextBlock Text="秒" FontSize="10" Foreground="#9C97C0" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <ListBox x:Name="SecondList" Width="46" MaxHeight="150" Background="Transparent"
                                     BorderThickness="1" BorderBrush="#40D4AF37"
                                     FontSize="12" Foreground="#F4F2FA" SelectionChanged="List_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" HorizontalAlignment="Center" FontFamily="Consolas"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#3DD4AF37"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#D4AF37"/>
                                                            <Setter Property="Foreground" Value="#1E2230"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="现在" Click="NowButton_Click" Margin="0,0,3,0"
                                Background="#2A1C1640" Foreground="#F4F2FA" BorderBrush="#80D4AF37" BorderThickness="1"
                                Padding="0,4" FontSize="11" Cursor="Hand" ToolTip="填入当前时间并确认">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#38251040"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="1" Content="完成" Click="ConfirmButton_Click" Margin="3,0,0,0"
                                Background="#D4AF37" Foreground="#1E2230" BorderThickness="0" FontWeight="SemiBold"
                                Padding="0,4" FontSize="11" Cursor="Hand" ToolTip="确认所选时间">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E0BC45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
