<Window x:Class="MultiplayerHoeingAssistant.Views.FlowPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="槲寄生 · 流程预览"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a2e"
        Foreground="#e0e0e0">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText"
                   FontSize="15" FontWeight="Bold" Foreground="#d4af37" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Lines">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}">
                            <TextBlock Text="{Binding Icon, Mode=OneWay}" FontSize="11" Width="18" VerticalAlignment="Center"/>
                            <TextBlock FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap">
                                <Run Text="{Binding Name, Mode=OneWay}" Foreground="#e0e0e0"/>
                                <Run Text="{Binding Suffix, Mode=OneWay}" Foreground="#8a8a9e" FontSize="10.5"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="关 闭" Width="90" Height="30"
                    Background="#3a3a55" Foreground="White" BorderThickness="0" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
