<Window x:Class="MultiplayerHoeingAssistant.Views.PetStatusPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="奥黛塔 · 任务状态"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="CanResize"
        MinWidth="220" MinHeight="200"
        Width="300" Height="330"
        Topmost="True"
        FontFamily="pack://application:,,,/MultiplayerHoeingAssistant;component/Assets/Fonts/#HarmonyOS Sans SC, Segoe UI, Microsoft YaHei">

    <!-- 奥黛塔任务状态详情面板：长方形专属区域，显示锄地任务状态全部信息。
         可独立拖动（标题栏）/ 调大小（8 边手动缩放，透明窗口下 WindowChrome 原生缩放不生效）/
         单独关闭（✕，写回设置）/ ◐ 循环调透明度（写回 PanelOpacity，与设置页滑条互通）。
         右键菜单与托盘/桌宠同款三选项（穿透模式下桌宠点不到，面板是另一个可见操作面）。 -->

    <Window.ContextMenu>
        <!-- ContextMenu 不在可视树内，经 PlacementTarget 接回窗口 DataContext（PetViewModel） -->
        <ContextMenu Background="#F0201C30" BorderBrush="#80D4AF37" BorderThickness="1" Padding="4"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="显示奥黛塔" IsCheckable="True" IsChecked="{Binding Enabled, Mode=TwoWay}"
                      Foreground="#F2E8D5" FontSize="13" Padding="10,6"/>
            <MenuItem Header="免打扰穿透（解锁走托盘）" IsCheckable="True" IsChecked="{Binding ClickThrough, Mode=TwoWay}"
                      Foreground="#F2E8D5" FontSize="13" Padding="10,6"/>
            <MenuItem Header="任务状态面板" IsCheckable="True" IsChecked="{Binding PanelEnabled, Mode=TwoWay}"
                      Foreground="#F2E8D5" FontSize="13" Padding="10,6"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <Border Background="#E0141C28" BorderBrush="#99D4AF37" BorderThickness="1" CornerRadius="10" Padding="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏（拖动区） -->
                <Border Grid.Row="0" Background="#22D4AF37" CornerRadius="7" Margin="6,6,6,4"
                        MouseLeftButtonDown="OnHeaderDrag">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="奥黛塔 · 任务状态" FontSize="13" FontWeight="Medium"
                                   Foreground="#F2E3B6" VerticalAlignment="Center" Margin="10,6,0,6"/>
                        <Button Grid.Column="1" Content="◐" Click="OnOpacityCycleClick" Cursor="Hand"
                                FontSize="13" Foreground="#C0F2E8D5" Background="Transparent" BorderThickness="0"
                                Margin="0,0,4,0" Padding="6,2"
                                ToolTip="循环调节面板透明度（也可在设置页精调）"/>
                        <Button Grid.Column="2" Content="✕" Click="OnCloseClick" Cursor="Hand"
                                FontSize="13" Foreground="#C0F2E8D5" Background="Transparent" BorderThickness="0"
                                Margin="0,0,6,0" Padding="6,2"
                                ToolTip="关闭面板（可从设置页或托盘重新打开）"/>
                    </Grid>
                </Border>

                <!-- 数据行（代码填充，每秒刷新）；内容不满一屏时垂直居中（上下留白均衡），超高时顶对齐+滚动。
                     ScrollViewer 以无限高度测量内容，子元素自身对齐对不齐视口——
                     居中靠代码把 RowsHostWrap 高度设为视口高、内部 RowsHost 居中实现 -->
                <ScrollViewer x:Name="RowsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,2,8,8"
                              Style="{DynamicResource GoldScrollViewer}">
                    <Grid x:Name="RowsHostWrap">
                        <StackPanel x:Name="RowsHost" VerticalAlignment="Center"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 手动缩放边（8 条透明命中条，覆盖在内容之上；AllowsTransparency 窗口无原生非客户区，
             WindowChrome.ResizeBorderThickness 与 ResizeGrip 均不生效，必须自绘缩放） -->
        <Rectangle x:Name="EdgeN" VerticalAlignment="Top" Height="6" Margin="6,0,6,0" Fill="Transparent"
                   Cursor="SizeNS" MouseLeftButtonDown="OnResizeEdgeDown" Tag="N"/>
        <Rectangle x:Name="EdgeS" VerticalAlignment="Bottom" Height="6" Margin="6,0,6,0" Fill="Transparent"
                   Cursor="SizeNS" MouseLeftButtonDown="OnResizeEdgeDown" Tag="S"/>
        <Rectangle x:Name="EdgeW" HorizontalAlignment="Left" Width="6" Margin="0,6,0,6" Fill="Transparent"
                   Cursor="SizeWE" MouseLeftButtonDown="OnResizeEdgeDown" Tag="W"/>
        <Rectangle x:Name="EdgeE" HorizontalAlignment="Right" Width="6" Margin="0,6,0,6" Fill="Transparent"
                   Cursor="SizeWE" MouseLeftButtonDown="OnResizeEdgeDown" Tag="E"/>
        <Rectangle x:Name="EdgeNW" HorizontalAlignment="Left" VerticalAlignment="Top" Width="12" Height="12" Fill="Transparent"
                   Cursor="SizeNWSE" MouseLeftButtonDown="OnResizeEdgeDown" Tag="NW"/>
        <Rectangle x:Name="EdgeNE" HorizontalAlignment="Right" VerticalAlignment="Top" Width="12" Height="12" Fill="Transparent"
                   Cursor="SizeNESW" MouseLeftButtonDown="OnResizeEdgeDown" Tag="NE"/>
        <Rectangle x:Name="EdgeSW" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="12" Height="12" Fill="Transparent"
                   Cursor="SizeNESW" MouseLeftButtonDown="OnResizeEdgeDown" Tag="SW"/>
        <Rectangle x:Name="EdgeSE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Fill="Transparent"
                   Cursor="SizeNWSE" MouseLeftButtonDown="OnResizeEdgeDown" Tag="SE"/>
    </Grid>
</Window>
