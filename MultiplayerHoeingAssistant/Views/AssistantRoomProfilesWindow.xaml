<Window x:Class="MultiplayerHoeingAssistant.Views.AssistantRoomProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="助手房间档案" Width="700" Height="654" MinWidth="570" MinHeight="490"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False" Background="#191735" Foreground="#F4F2FA"
        FontFamily="pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC, Segoe UI, Microsoft YaHei"
        FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="RoomSurface" Color="#26234E"/>
        <SolidColorBrush x:Key="RoomInputSurface" Color="#171630"/>
        <SolidColorBrush x:Key="RoomEdge" Color="#476B659C"/>
        <SolidColorBrush x:Key="RoomMuted" Color="#C2BCD9"/>
        <SolidColorBrush x:Key="RoomWarning" Color="#F3B29E"/>
        <LinearGradientBrush x:Key="RoomPrimary" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EFD68A" Offset="0"/><GradientStop Color="#D4AF37" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="RoomAction" TargetType="Button">
            <Setter Property="Background" Value="#2E6E6EB4"/>
            <Setter Property="BorderBrush" Value="{StaticResource RoomEdge}"/>
            <Setter Property="Foreground" Value="{StaticResource GoldText}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="7" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoomMainAction" TargetType="Button" BasedOn="{StaticResource RoomAction}">
            <Setter Property="Background" Value="{StaticResource RoomPrimary}"/>
            <Setter Property="Foreground" Value="#302511"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RoomFormLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource GoldText}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource RoomInputSurface}"/>
            <Setter Property="Foreground" Value="#F4F2FA"/>
            <Setter Property="BorderBrush" Value="{StaticResource RoomEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource GoldText}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinHeight" Value="33"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger>
                <Trigger Property="IsReadOnly" Value="True"><Setter Property="Foreground" Value="{StaticResource RoomMuted}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource RoomInputSurface}"/>
            <Setter Property="Foreground" Value="#F4F2FA"/>
            <Setter Property="BorderBrush" Value="{StaticResource RoomEdge}"/>
            <Setter Property="CaretBrush" Value="{StaticResource GoldText}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="33"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.75"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RoomProfileRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="7" BorderThickness="1"
                                Background="#26234E" BorderBrush="{StaticResource RoomEdge}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#343065"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#413650"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource GoldLine}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource GoldLine}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="{StaticResource RoomSurface}" BorderBrush="{StaticResource RoomEdge}" BorderThickness="0,0,0,1" Padding="16,12"
                    MouseLeftButtonDown="DragHeader">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource RoomAction}" IsCancel="True"/>
                    <StackPanel>
                        <TextBlock Text="助手房间档案" Foreground="{StaticResource GoldText}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="服务器、成员和联机设置按房间保存" Foreground="{StaticResource RoomMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1" Margin="16,14,16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,14,0">
                    <Button DockPanel.Dock="Top" Content="添加房间" Style="{StaticResource RoomAction}" Click="NewProfileClick" Margin="0,0,0,10"/>
                    <ListBox x:Name="ProfilesList" Background="Transparent" BorderThickness="0" Foreground="#F4F2FA"
                             ItemContainerStyle="{StaticResource RoomProfileRow}" SelectionChanged="ProfileChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="已保存房间">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding RoomCode}" Foreground="{StaticResource GoldText}" FontSize="11" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding ServerUrl}" Foreground="{StaticResource RoomMuted}" FontSize="11" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ServerUrl}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource GoldScrollViewer}">
                    <StackPanel x:Name="Editor" Margin="0,0,10,5">
                        <TextBlock x:Name="EditorTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource GoldText}"/>
                        <TextBlock x:Name="EditorHint" Foreground="{StaticResource RoomMuted}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                        <Label Content="档案名称" Target="{Binding ElementName=RoomNameBox}" Style="{StaticResource RoomFormLabel}"/>
                        <TextBox x:Name="RoomNameBox" MaxLength="64"/>
                        <Label Content="助手控制服务器地址" Target="{Binding ElementName=ServerBox}" Style="{StaticResource RoomFormLabel}" Margin="0,11,0,5"/>
                        <TextBox x:Name="ServerBox"/>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <Label Content="房间号" Target="{Binding ElementName=RoomCodeBox}" Style="{StaticResource RoomFormLabel}"/>
                                <TextBox x:Name="RoomCodeBox" MaxLength="6" CharacterCasing="Upper"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <Label Content="房间密码" Target="{Binding ElementName=RoomPasswordBox}" Style="{StaticResource RoomFormLabel}"/>
                                <PasswordBox x:Name="RoomPasswordBox" MaxLength="128"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="102"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <Label Content="成员 UID（逗号分隔）" Target="{Binding ElementName=MemberUidsBox}" Style="{StaticResource RoomFormLabel}"/>
                                <TextBox x:Name="MemberUidsBox" TextWrapping="Wrap" MinHeight="48" VerticalContentAlignment="Top"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="预期开锄人数" Target="{Binding ElementName=ExpectedCountBox}" Style="{StaticResource RoomFormLabel}"/>
                                <ComboBox x:Name="ExpectedCountBox" Style="{StaticResource GoldComboBox}" Height="33"/>
                            </StackPanel>
                        </Grid>
                        <Border x:Name="HoeingDetails" Background="{StaticResource RoomSurface}" BorderBrush="{StaticResource RoomEdge}"
                                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="房间的联机设置" Foreground="{StaticResource GoldText}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HoeingSummary" Foreground="{StaticResource RoomMuted}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0" LineHeight="17"/>
                                <TextBlock Text="绑定、定时、完成后动作和快捷指令，切到此房间后可在耕地机页修改。" FontSize="11"
                                           Foreground="{StaticResource RoomMuted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="2" Background="{StaticResource RoomSurface}" BorderBrush="{StaticResource RoomEdge}" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="{StaticResource RoomWarning}" Margin="0,0,0,8"
                               Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    <DockPanel Grid.Row="1" LastChildFill="False">
                        <Button x:Name="RemoveProfileButton" DockPanel.Dock="Left" Content="移除本机档案" Style="{StaticResource RoomAction}"
                                Foreground="{StaticResource RoomWarning}" Click="RemoveProfileClick"/>
                        <Button x:Name="SaveProfileButton" DockPanel.Dock="Right" Content="保存档案" Style="{StaticResource RoomMainAction}"
                                Click="SaveProfileClick" IsDefault="True"/>
                        <Button x:Name="CreateRoomButton" DockPanel.Dock="Right" Content="建房并保存" Style="{StaticResource RoomAction}"
                                Click="CreateRoomClick" Margin="0,0,8,0"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
