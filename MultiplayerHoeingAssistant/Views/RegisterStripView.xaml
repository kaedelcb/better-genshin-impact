<UserControl x:Class="MultiplayerHoeingAssistant.Views.RegisterStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MultiplayerHoeingAssistant.Views"
             VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="寄存器" Foreground="{DynamicResource Dim}" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,8,0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact,RelativeSource={RelativeSource AncestorType={x:Type views:RegisterStripView}}}" Value="True">
                            <Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,0,5,0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Padding="0"
                            Content="{Binding ValueText}" ToolTip="{Binding ToolTip}" ToolTipService.ShowOnDisabled="True"
                            IsEnabled="{Binding Available}" AutomationProperties.Name="{Binding Label}" Click="CellClick">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/>
                                <Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,4,0"/>
                                <Setter Property="Foreground" Value="#BDB6D2" />
                                <Setter Property="Background" Value="#211E3C" />
                                <Setter Property="BorderBrush" Value="#514B69" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate></Setter.Value></Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact,RelativeSource={RelativeSource AncestorType={x:Type views:RegisterStripView}}}" Value="True">
                                        <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
                                        <Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,2,0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOne}" Value="True">
                                        <Setter Property="Foreground" Value="#FFE4A2" /><Setter Property="Background" Value="#30E8C96D" />
                                        <Setter Property="BorderBrush" Value="#E8C96D" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#FFE6A4" /></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FFFFFF" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="ResetAllButton" Content="全归零" IsEnabled="{Binding CanReset}" Click="ResetAllClick"
                ToolTip="{Binding ResetStatus}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="全部寄存器归零">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Width" Value="42"/><Setter Property="Height" Value="22"/>
                    <Setter Property="Margin" Value="2,0,0,0"/><Setter Property="Padding" Value="2,0"/>
                    <Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Background" Value="#353052"/><Setter Property="Foreground" Value="#EAD391"/>
                    <Setter Property="BorderBrush" Value="#837044"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#E8C96D"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact,RelativeSource={RelativeSource AncestorType={x:Type views:RegisterStripView}}}" Value="True">
                            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="18"/><Setter Property="FontSize" Value="10"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </StackPanel>
</UserControl>
