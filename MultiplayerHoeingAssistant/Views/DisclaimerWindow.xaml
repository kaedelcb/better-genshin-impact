<Window x:Class="MultiplayerHoeingAssistant.Views.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用风险与开源许可"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1a1a2e"
        Foreground="#e0e0e0">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nexus BGI（联机助手）--- 使用风险与开源许可"
                   FontSize="20" FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,16"
                   TextWrapping="Wrap" TextAlignment="Center"/>

        <!-- 可滚动声明文本 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Background="#16213e" Padding="16" Margin="0,0,0,16">
            <TextBlock x:Name="DisclaimerText"
                       TextWrapping="Wrap" LineHeight="24" FontSize="13"
                       Foreground="#d0d0d0" MinHeight="260"/>
        </ScrollViewer>

        <!-- 仅确认风险知悉，不要求接受 GPL -->
        <CheckBox x:Name="AgreeCheckBox" Grid.Row="2"
                  Foreground="#90caf9" FontSize="12" Margin="0,0,0,4" VerticalAlignment="Top"
                  Checked="AgreeCheckBox_Changed" Unchecked="AgreeCheckBox_Changed">
            <TextBlock Text="我已阅读并了解上述使用风险；本勾选不改变开源许可证授予的权利。"
                       TextWrapping="Wrap" Foreground="#90caf9" FontSize="12"/>
        </CheckBox>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="开源许可" Width="110" Height="36" Margin="0,0,12,0"
                    Background="#546e7a" Foreground="White" BorderThickness="0" Click="OpenLicenses_Click"/>
            <Button Content="继续使用" x:Name="AcceptButton" Width="120" Height="36" Margin="0,0,12,0"
                    Background="#42a5f5" Foreground="White" BorderThickness="0" Click="AcceptButton_Click"/>
            <Button Content="退出" x:Name="RejectButton" Width="120" Height="36"
                    Background="#546e7a" Foreground="White" BorderThickness="0" Click="RejectButton_Click"/>
        </StackPanel>
    </Grid>
</Window>