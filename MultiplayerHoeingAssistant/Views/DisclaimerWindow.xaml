<Window x:Class="MultiplayerHoeingAssistant.Views.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="风险说明与免责声明"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1a1a2e"
        Foreground="#e0e0e0">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nexus BGI（联机助手）--- 风险说明与免责声明"
                   FontSize="20" FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,16"
                   TextWrapping="Wrap" TextAlignment="Center"/>

        <!-- 可滚动声明文本 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Background="#16213e" Padding="16" Margin="0,0,0,16">
            <TextBlock x:Name="DisclaimerText"
                       TextWrapping="Wrap" LineHeight="24" FontSize="13"
                       Foreground="#d0d0d0" MinHeight="260"/>
        </ScrollViewer>

        <!-- 我已阅读并同意 -->
        <CheckBox x:Name="AgreeCheckBox" Grid.Row="2"
                  Foreground="#90caf9" FontSize="12" Margin="0,0,0,4" VerticalAlignment="Top"
                  Checked="AgreeCheckBox_Changed" Unchecked="AgreeCheckBox_Changed">
            <TextBlock Text="我已阅读并理解以上风险说明，同意承担使用本工具的一切风险，并同意免责声明条款。"
                       TextWrapping="Wrap" Foreground="#90caf9" FontSize="12"/>
        </CheckBox>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="同意并继续" x:Name="AcceptButton" Width="120" Height="36" Margin="0,0,12,0"
                    Background="#42a5f5" Foreground="White" BorderThickness="0" Click="AcceptButton_Click"/>
            <Button Content="拒绝并退出" x:Name="RejectButton" Width="120" Height="36"
                    Background="#546e7a" Foreground="White" BorderThickness="0" Click="RejectButton_Click"/>
        </StackPanel>
    </Grid>
</Window>