<Window x:Class="MultiplayerHoeingAssistant.Views.RemoteProgramPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择执行端上的程序" Width="650" Height="480" MinWidth="500" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#201D35" Foreground="#F4F2FA"
        Loaded="ViewLoaded">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="浏览的是执行端电脑；选中的路径将在执行端运行。" Foreground="#D4AF37" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="上级目录" Click="ParentClick" Padding="9,4" Margin="7,0,0,0"/>
            <TextBox x:Name="PathBox" Background="#302A49" Foreground="#F4F2FA" BorderBrush="#655B82" KeyDown="PathBoxKeyDown"/>
        </DockPanel>
        <ListBox x:Name="Entries" Grid.Row="2" Background="#29243F" Foreground="#F4F2FA" BorderBrush="#655B82"
                 DisplayMemberPath="Label" MouseDoubleClick="EntriesDoubleClick"/>
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="Feedback" VerticalAlignment="Center" Foreground="#F3B48B" TextWrapping="Wrap"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="CancelClick" Padding="10,4" Margin="0,0,7,0"/>
                <Button x:Name="SelectButton" Content="选择程序" Click="SelectClick" Padding="10,4"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
