<Window x:Class="MultiplayerHoeingAssistant.Views.RemoteLogRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="协助房间日志" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#211D40"
        Foreground="#F4F2FA" FontFamily="Microsoft YaHei">
    <Window.Resources>
        <!-- 与助手页面的 GoldInput 同款：暗紫底、金色细描边，聚焦时描边变亮。
             弹窗自行声明，避免依赖调用页合并进来的页面级资源。 -->
        <Style x:Key="RoomInput" TargetType="TextBox">
            <Setter Property="Background" Value="#2A1C1640"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#80D4AF37"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#E8C96D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#F0E8C96D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoomPasswordInput" TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A1C1640"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#80D4AF37"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#E8C96D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#F0E8C96D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="查看其他房间成员日志" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource Gold}"/>
        <TextBlock Text="仅切换日志面板，自己的联机和任务继续运行。" TextWrapping="Wrap"
                   FontSize="12" Foreground="{DynamicResource Dim}" Margin="0,8,0,12"/>
        <StackPanel x:Name="HistoryPanel" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="已记录房间" Margin="0,0,0,4"/>
            <DockPanel>
                <Button x:Name="DeleteHistoryButton" Content="删除此记录" DockPanel.Dock="Right"
                        Click="DeleteHistory_Click" Style="{DynamicResource BtnGhost}" Padding="8,4" Margin="8,0,0,0"/>
                <ComboBox x:Name="HistoryRoomsBox" TextSearch.TextPath="DisplayName" Height="30"
                          SelectionChanged="HistoryRooms_SelectionChanged" AutomationProperties.Name="已记录房间"
                          Style="{DynamicResource GoldComboBox}" ItemContainerStyle="{DynamicResource GoldComboItem}"
                          ToolTip="选择曾协助过的房间，自动填入备注、房间号和密码">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>
        </StackPanel>
        <TextBlock x:Name="RoomNoteLabel" Text="备注（选填）" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,10">
            <Button x:Name="SaveNoteButton" Content="保存备注" DockPanel.Dock="Right"
                    Visibility="{Binding Visibility, ElementName=HistoryPanel}"
                    IsEnabled="{Binding IsEnabled, ElementName=DeleteHistoryButton}"
                    Click="SaveNote_Click" Style="{DynamicResource BtnGhost}" Padding="8,4" Margin="8,0,0,0"/>
            <TextBox x:Name="RoomNoteBox" Style="{DynamicResource RoomInput}"
                     AutomationProperties.LabeledBy="{Binding ElementName=RoomNoteLabel}"/>
        </DockPanel>
        <TextBlock Text="被协助房间号" Margin="0,0,0,4"/>
        <TextBox x:Name="RoomCodeBox" Style="{DynamicResource RoomInput}"/>
        <TextBlock Text="房间密码" Margin="0,10,0,4"/>
        <PasswordBox x:Name="RoomPasswordBox" Style="{DynamicResource RoomPasswordInput}"/>
        <TextBlock Text="成功连接后自动记录，可随时删除。" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource Dim}" Margin="0,8,0,0"/>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource Gold}"
                   FontSize="12" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" IsCancel="True" Style="{DynamicResource BtnGhost}" Padding="14,5"/>
            <Button x:Name="ConnectButton" Content="连接" IsDefault="True" Click="Connect_Click"
                    Style="{DynamicResource BtnGhost}" Padding="14,5" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
