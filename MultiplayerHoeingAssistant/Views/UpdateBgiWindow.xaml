<Window x:Class="MultiplayerHoeingAssistant.Views.UpdateBgiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MultiplayerHoeingAssistant.Views"
        xmlns:services="clr-namespace:MultiplayerHoeingAssistant.Services"
        Title="Nexus-BGI - 更新BGI"
        Width="950" SizeToContent="Height"
        MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC, Segoe UI, Microsoft YaHei"
        FontSize="13" Foreground="#F4F2FA"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStyle="SingleBorderWindow">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
            <GradientStop Color="#141534" Offset="0"/>
            <GradientStop Color="#221F4E" Offset="0.56"/>
            <GradientStop Color="#1B1943" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <local:UpdateBgiWideLayoutConverter x:Key="WideLayout"/>
        <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC, Segoe UI, Microsoft YaHei</FontFamily>
        <SolidColorBrush x:Key="Ink" Color="#F4F2FA"/>
        <SolidColorBrush x:Key="Dim" Color="#BAB3D4"/>
        <SolidColorBrush x:Key="Gold" Color="#E8C96D"/>
        <SolidColorBrush x:Key="GoldText" Color="#F2E3B6"/>
        <SolidColorBrush x:Key="GoldEdge" Color="#48D4AF37"/>
        <SolidColorBrush x:Key="Stroke" Color="#618C80A9"/>
        <SolidColorBrush x:Key="InputBg" Color="#181733"/>
        <Geometry x:Key="FolderIcon">M 1,4 L 6,4 L 8,6 L 15,6 L 15,13 L 1,13 Z M 1,7 L 15,7</Geometry>
        <Geometry x:Key="ArchiveIcon">M 2,1 L 12,1 L 12,15 L 2,15 Z M 7,1 L 7,4 L 9,4 L 9,6 L 7,6 L 7,9 L 9,9 M 6,11 L 9,11 L 9,13 L 6,13 Z</Geometry>
        <Geometry x:Key="ShieldIcon">M 8,1 L 14,4 L 14,8 C 14,12 11,14 8,16 C 5,14 2,12 2,8 L 2,4 Z M 5,8 L 7,10 L 11,6</Geometry>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#DC26234E"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource GoldText}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Txt" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#30756CB2"/>
            <Setter Property="Foreground" Value="#E4DEF1"/>
            <Setter Property="BorderBrush" Value="#4F9C97C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#C8B5A2DC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="#3A2F16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EFD68A" Offset="0"/>
                        <GradientStop Color="#D4AF37" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SourceEditorHeader" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="Foreground" Value="#D9D1ED"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="FocusBorder" BorderBrush="Transparent" BorderThickness="1"
                                Background="Transparent" CornerRadius="5" Padding="3,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource Dim}"
                                      StrokeThickness="1.4" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0,4 L 4,0 L 8,4"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.46"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SourceExpander" TargetType="Expander">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BackupToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="FocusBorder" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                CornerRadius="5" Padding="0,2">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" Background="{StaticResource InputBg}"
                                        BorderBrush="#9B8CAF" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Path x:Name="Tick" Data="M 0,3 L 3,6 L 8,0" Stroke="#382C13" StrokeThickness="1.4"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Gold}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Gold}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource Gold}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FocusBorder" Property="Opacity" Value="0.46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PackageItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" Background="#26234D" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#363153"/>
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#AAD4AF37"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Gold}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DirectoryList" TargetType="ItemsControl">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="#353054" BorderBrush="#8C7CA080" BorderThickness="1" CornerRadius="6"
                                Padding="8,3" Margin="0,0,6,6" ToolTip="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#EEE7F7" VerticalAlignment="Center"
                                           MaxWidth="245" TextWrapping="Wrap"/>
                                <Button Content="✕" FontSize="10" Padding="4,0" Margin="5,0,0,0" Style="{StaticResource Btn}" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" Foreground="#DDD3EE" Click="RemoveDirectoryButton_Click"
                                        AutomationProperties.Name="{Binding StringFormat='移除 {0}'}"
                                        Tag="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Style="{DynamicResource GoldScrollViewer}" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,17,13,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.94*"/>
                        <ColumnDefinition Width="1.06*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 左栏按内容测量，不受右栏安装包条目数量影响。 -->
                    <StackPanel x:Name="UpdateSettingsColumn" VerticalAlignment="Top">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, ElementName=LayoutRoot, Converter={StaticResource WideLayout}}" Value="True">
                                        <Setter Property="Grid.ColumnSpan" Value="1"/>
                                        <Setter Property="Margin" Value="0,0,12,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource FolderIcon}" Width="17" Height="17" Stretch="Uniform"
                                              Stroke="{StaticResource Gold}" StrokeThickness="1.25" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="更新位置" Style="{StaticResource Heading}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="#76181631" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                            CornerRadius="8" Padding="8,3" Margin="8,0,0,0"
                                            ToolTip="显示所选 BGI 目录下 BetterGI.exe 的版本；更换目录或更新成功后会刷新。">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="当前版本" FontSize="12" Foreground="{StaticResource Dim}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="CurrentVersionText" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource GoldText}" Text="未知" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" MaxWidth="200"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <TextBlock Text="BGI 目录（解压覆盖目标）" Style="{StaticResource Lbl}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BgiDirBox" Style="{StaticResource Txt}" Grid.Column="0" Margin="0,0,6,0"/>
                                    <Button x:Name="BrowseBgiDirButton" Content="浏览" Grid.Column="1" Width="56" Height="32" Style="{StaticResource Btn}" Click="BrowseBgiDirButton_Click"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="默认取 BetterGI.exe 所在目录；关闭运行中的 BGI 前会询问。"/>

                                <TextBlock Text="安装包目录（.7z）" Style="{StaticResource Lbl}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PackageDirBox" Style="{StaticResource Txt}" Grid.Column="0" Margin="0,0,6,0"/>
                                    <Button x:Name="BrowsePackageDirButton" Content="浏览" Grid.Column="1" Width="56" Height="32" Style="{StaticResource Btn}" Click="BrowsePackageDirButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <Path Data="{StaticResource ShieldIcon}" Width="17" Height="17" Stretch="Uniform"
                                          Stroke="{StaticResource Gold}" StrokeThickness="1.25" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="排除与备份" Style="{StaticResource Heading}"/>
                                </StackPanel>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Lbl}" Margin="0" VerticalAlignment="Center">
                                        <Run Text="排除目录"/><Run Text="  更新时不覆盖" FontSize="12" FontWeight="Normal" Foreground="{StaticResource Dim}"/>
                                    </TextBlock>
                                    <Button x:Name="AddExcludeButton" Content="＋ 添加目录…" Grid.Column="1" Height="30" Padding="12,0" Style="{StaticResource Btn}" AutomationProperties.Name="添加排除目录" Click="AddExcludeButton_Click"/>
                                </Grid>
                                <ItemsControl x:Name="ExcludeList" Style="{StaticResource DirectoryList}"/>
                                <TextBlock Text="未设置排除目录" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,1,0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=ExcludeList}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="一般无需排除。跳过 BGI 需要更新的目录，可能导致功能缺失。按住 Ctrl 可多选。"/>
                                <Border Background="{StaticResource Stroke}" Height="1" Margin="0,9,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="备份目录" Style="{StaticResource Lbl}" Margin="0" VerticalAlignment="Center"/>
                                    <Button x:Name="AddBackupButton" Content="＋ 添加目录…" Grid.Column="1" Height="30" Padding="12,0"
                                            Style="{StaticResource Btn}" AutomationProperties.Name="添加备份目录" Click="AddBackupButton_Click"/>
                                </Grid>
                                <ItemsControl x:Name="BackupList" Style="{StaticResource DirectoryList}"/>
                                <CheckBox x:Name="BackupCheckBox" Content="更新前备份" IsChecked="True" Margin="0,6,0,0" Cursor="Hand"
                                          FontSize="13" FontWeight="SemiBold" Style="{StaticResource BackupToggle}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="勾选后，解压前复制到 _update_backup；成功更新后清理超过 10 天的更新备份。按住 Ctrl 可多选。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Grid.Row" Value="1"/>
                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                <Setter Property="Margin" Value="0,10,0,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, ElementName=LayoutRoot, Converter={StaticResource WideLayout}}" Value="True">
                                        <Setter Property="Grid.Row" Value="0"/>
                                        <Setter Property="Grid.Column" Value="1"/>
                                        <Setter Property="Grid.ColumnSpan" Value="1"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Height" Value="{Binding ActualHeight, ElementName=UpdateSettingsColumn}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,4">
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource ArchiveIcon}" Width="17" Height="17" Stretch="Uniform"
                                              Stroke="{StaticResource Gold}" StrokeThickness="1.25" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="安装包" Style="{StaticResource Heading}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Margin="9,0,0,0"
                                               VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Text="解压覆盖同路径文件，不删除个人文件"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </Grid>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="下载来源" Style="{StaticResource Lbl}" Margin="0" VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="SourceEditorToggle" Grid.Column="1" Content="管理自定义下载源"
                                                  Style="{StaticResource SourceEditorHeader}" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsExpanded, ElementName=SourceEditor, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsEnabled, ElementName=SourceEditor}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="SourceBox" DisplayMemberPath="Label" Height="34" FontSize="13" VerticalContentAlignment="Center"
                                              Style="{DynamicResource GoldComboBox}" ItemContainerStyle="{DynamicResource GoldComboItem}"
                                              AutomationProperties.Name="下载来源" SelectionChanged="SourceBox_SelectionChanged" Margin="0,0,6,0">
                                        <ComboBox.Resources>
                                            <DataTemplate DataType="{x:Type services:BgiUpdateSource}">
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.Resources>
                                    </ComboBox>
                                    <Button x:Name="RefreshPackagesButton" Content="刷新" Grid.Column="1" Width="56" Height="32"
                                            Style="{StaticResource Btn}" Click="RefreshPackagesButton_Click"/>
                                </Grid>
                                <Expander x:Name="SourceEditor" Style="{StaticResource SourceExpander}">
                                    <StackPanel Margin="0,4,0,0">
                                        <TextBlock Text="名称（可选）" Style="{StaticResource Hint}"/>
                                        <TextBox x:Name="SourceNameBox" Style="{StaticResource Txt}" MaxLength="80" AutomationProperties.Name="自定义源名称"/>
                                        <TextBlock Text="HTTPS 更新清单网址（例如 https://mirror.example.com/bgi-update/latest.json）" Style="{StaticResource Hint}"/>
                                        <TextBox x:Name="SourceUrlBox" Style="{StaticResource Txt}" MaxLength="2048" AutomationProperties.Name="HTTPS 更新清单网址"/>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button Content="添加并选中" Height="28" Style="{StaticResource Btn}" Click="AddSourceButton_Click"/>
                                            <Button x:Name="RemoveSourceButton" Content="移除当前自定义源" Height="28" Margin="6,0,0,0"
                                                    Style="{StaticResource Btn}" Click="RemoveSourceButton_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="SourceEditorStatus" TextWrapping="Wrap" Foreground="#F0BE82" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="安装包列表" Style="{StaticResource Lbl}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border Grid.Row="1" Background="{StaticResource InputBg}" BorderBrush="{StaticResource Stroke}"
                                    BorderThickness="1" CornerRadius="8">
                                <ListBox x:Name="PackageList"
                                         Background="Transparent" Foreground="{StaticResource Ink}" BorderThickness="0"
                                         Padding="5" SelectionChanged="PackageList_SelectionChanged" ItemContainerStyle="{StaticResource PackageItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="安装包列表">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualWidth, ElementName=LayoutRoot, Converter={StaticResource WideLayout}}" Value="False">
                                                    <Setter Property="MinHeight" Value="132"/>
                                                    <Setter Property="MaxHeight" Value="360"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <ScrollViewer x:Name="PART_ScrollViewer" Style="{DynamicResource GoldScrollViewer}"
                                                          Focusable="False" Padding="{TemplateBinding Padding}"
                                                          CanContentScroll="True"
                                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="7" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        Background="#27D4AF37" BorderBrush="{StaticResource GoldEdge}" BorderThickness="1">
                                                    <Path Data="{StaticResource ArchiveIcon}" Width="17" Height="17" Stretch="Uniform"
                                                          Stroke="{StaticResource Gold}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" ToolTip="{Binding FullPath}"/>
                                                    <TextBlock FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,3,0,0">
                                                        <Run Text="{Binding SourceTagText, Mode=OneWay}" Foreground="{StaticResource GoldText}"/>
                                                        <Run Text="  "/><Run Text="{Binding NameInfo.VersionSummary, Mode=OneWay}"/>
                                                        <Run Text=" · "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                                                        <LineBreak/><Run Text="{Binding ModifiedTimeText, Mode=OneWay}"/>
                                                        <Run Text="{Binding BuildText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding DirectoryText}" FontSize="11" Foreground="{StaticResource Dim}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DirectoryText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Source}" Value="PickedManually">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="2" Width="17" Height="17" CornerRadius="9" VerticalAlignment="Center" Margin="8,0,0,0"
                                                        BorderBrush="{StaticResource Gold}" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Path Data="M 0,3 L 3,6 L 8,0" Stroke="{StaticResource Gold}" StrokeThickness="1.3"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PackageListHint" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Text="点击「刷新」扫描目录中的 .7z 安装包。只列出茶包版（名称必须含 +lcb. 段），防止误升级到其他版本 BGI。"/>
                                <Button x:Name="PickPackageFileButton" Content="选择指定压缩包…" Grid.Column="1" Height="30" Padding="10,0"
                                        Margin="10,0,0,0" Style="{StaticResource Btn}" VerticalAlignment="Center"
                                        ToolTip="不经目录扫描，直接弹窗选择一个安装包（同样要求文件名符合规范）"
                                        Click="PickPackageFileButton_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="#60D4AF37" BorderThickness="0,1,0,0" Background="#191735" Padding="18,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center"
                           TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                            <Setter Property="Margin" Value="0,0,0,5"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding ActualWidth, ElementName=LayoutRoot, Converter={StaticResource WideLayout}, ConverterParameter=620}" Value="True">
                                    <Setter Property="Grid.ColumnSpan" Value="1"/>
                                    <Setter Property="Margin" Value="0,0,12,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Grid.Row" Value="1"/>
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActualWidth, ElementName=LayoutRoot, Converter={StaticResource WideLayout}, ConverterParameter=620}" Value="True">
                                    <Setter Property="Grid.Row" Value="0"/>
                                    <Setter Property="Grid.Column" Value="1"/>
                                    <Setter Property="Grid.ColumnSpan" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button x:Name="CloseButton" Content="关闭" Width="75" Height="35" Margin="0,0,7,0"
                            Style="{StaticResource Btn}" Click="CloseButton_Click"/>
                    <Button x:Name="DownloadButton" Content="仅下载" IsEnabled="False" Width="83" Height="35" Margin="0,0,7,0"
                            Style="{StaticResource Btn}" Click="DownloadButton_Click"/>
                    <Button x:Name="UpdateButton" Content="更新" Width="94" Height="35"
                            Style="{StaticResource PrimaryBtn}" Click="UpdateButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
