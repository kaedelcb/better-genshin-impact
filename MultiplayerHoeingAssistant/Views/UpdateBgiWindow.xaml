<Window x:Class="MultiplayerHoeingAssistant.Views.UpdateBgiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus-BGI - 更新BGI"
        Width="560" Height="700"
        MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F6F2E8"
        FontFamily="pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC, Segoe UI, Microsoft YaHei"
        WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Txt" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="BorderBrush" Value="#D1D1D6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#E9E9EB"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="DirectoryList" TargetType="ItemsControl">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="#EFEAE0" BorderBrush="#D8D2C4" BorderThickness="1" CornerRadius="6"
                                Padding="8,3" Margin="0,0,6,6" ToolTip="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#1D1D1F" VerticalAlignment="Center"
                                           MaxWidth="380" TextWrapping="Wrap"/>
                                <Button Content="✕" FontSize="10" Padding="4,0" Margin="5,0,0,0" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" Foreground="#6E6E73" Click="RemoveDirectoryButton_Click"
                                        AutomationProperties.Name="{Binding StringFormat='移除 {0}'}"
                                        Tag="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD7CC" BorderThickness="0,1,0,0" Padding="20,10,20,14">
            <StackPanel>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="#6E6E73" TextWrapping="Wrap" Text=""/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="CloseButton" Content="关闭" Width="90" Height="34" Margin="0,0,10,0" Style="{StaticResource Btn}" Click="CloseButton_Click"/>
                    <Button x:Name="DownloadButton" Content="仅下载" IsEnabled="False" Width="96" Height="34" Margin="0,0,10,0"
                            Style="{StaticResource Btn}" Click="DownloadButton_Click"/>
                    <Button x:Name="UpdateButton" Content="更新" Width="110" Height="34"
                            Background="#007AFF" Foreground="White" BorderThickness="0" Cursor="Hand" Click="UpdateButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,20">
            <TextBlock Text="更新 BGI" FontSize="18" FontWeight="SemiBold" Foreground="#1D1D1F"/>
            <TextBlock Text="更新会将茶包版安装包（.7z）解压到 BGI 目录，不会删除个人文件。只有路径与包内文件相同的文件会被覆盖。"
                       FontSize="12" Foreground="#6E6E73" TextWrapping="Wrap" Margin="0,4,0,4"/>

            <!-- 第一行：当前 BGI 版本 -->
            <TextBlock Text="当前 BGI 版本" Style="{StaticResource Lbl}"/>
            <Border Background="White" CornerRadius="6" BorderBrush="#D1D1D6" BorderThickness="1" Padding="10,7">
                <TextBlock x:Name="CurrentVersionText" FontSize="13" Foreground="#1D1D1F" Text="未知"/>
            </Border>
            <TextBlock Style="{StaticResource Hint}" Text="优先取运行中 BGI 上报的版本；BGI 未运行时读 exe 内记录的版本。更新完成后自动刷新。"/>

            <!-- 第二行：BGI 目录 -->
            <TextBlock Text="BGI 目录（解压覆盖目标）" Style="{StaticResource Lbl}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="BgiDirBox" Style="{StaticResource Txt}" Grid.Column="0" Margin="0,0,6,0"/>
                <Button x:Name="BrowseBgiDirButton" Content="浏览" Grid.Column="1" Width="56" Height="32" Style="{StaticResource Btn}" Click="BrowseBgiDirButton_Click"/>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="默认取设置里 BetterGI.exe 所在目录。覆盖前会检查并（经你确认后）自动关闭该目录下正在运行的 BGI。"/>

            <TextBlock Text="安装包目录（.7z）" Style="{StaticResource Lbl}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PackageDirBox" Style="{StaticResource Txt}" Grid.Column="0" Margin="0,0,6,0"/>
                <Button x:Name="BrowsePackageDirButton" Content="浏览" Grid.Column="1" Width="56" Height="32" Style="{StaticResource Btn}" Click="BrowsePackageDirButton_Click"/>
            </Grid>

            <TextBlock Text="下载来源" Style="{StaticResource Lbl}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SourceBox" DisplayMemberPath="Label" Height="32" FontSize="13" VerticalContentAlignment="Center"
                          AutomationProperties.Name="下载来源" SelectionChanged="SourceBox_SelectionChanged" Margin="0,0,6,0"/>
                <Button x:Name="RefreshPackagesButton" Content="刷新" Grid.Column="1" Width="56" Height="32"
                        Style="{StaticResource Btn}" Click="RefreshPackagesButton_Click"/>
            </Grid>
            <Expander x:Name="SourceEditor" Header="管理自定义下载源" Margin="0,8,0,0" FontSize="12">
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="名称（可选）" Style="{StaticResource Hint}"/>
                    <TextBox x:Name="SourceNameBox" Style="{StaticResource Txt}" MaxLength="80" AutomationProperties.Name="自定义源名称"/>
                    <TextBlock Text="HTTPS 更新清单网址（例如 https://mirror.example.com/bgi-update/latest.json）" Style="{StaticResource Hint}"/>
                    <TextBox x:Name="SourceUrlBox" Style="{StaticResource Txt}" MaxLength="2048" AutomationProperties.Name="HTTPS 更新清单网址"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="添加并选中" Height="28" Style="{StaticResource Btn}" Click="AddSourceButton_Click"/>
                        <Button x:Name="RemoveSourceButton" Content="移除当前自定义源" Height="28" Margin="6,0,0,0"
                                Style="{StaticResource Btn}" Click="RemoveSourceButton_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="SourceEditorStatus" TextWrapping="Wrap" Foreground="#8A5B10" Margin="0,3,0,0"/>
                </StackPanel>
            </Expander>

            <!-- 安装包列表 -->
            <ListBox x:Name="PackageList" Height="132" Margin="0,8,0,0" Background="White" SelectionChanged="PackageList_SelectionChanged"
                     BorderBrush="#D1D1D6" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,3" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <!-- 来源标签：目录（灰）/指定（蓝）/网络（橙，预留服务器下载） -->
                                <Border CornerRadius="4" Padding="4,1" Margin="0,0,5,0" BorderThickness="1" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#148E8E93"/>
                                            <Setter Property="BorderBrush" Value="#448E8E93"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source}" Value="PickedManually">
                                                    <Setter Property="Background" Value="#1F007AFF"/>
                                                    <Setter Property="BorderBrush" Value="#55007AFF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Source}" Value="Network">
                                                    <Setter Property="Background" Value="#1FE8A84E"/>
                                                    <Setter Property="BorderBrush" Value="#55E8A84E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SourceTagText}" FontSize="9">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#8E8E93"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source}" Value="PickedManually">
                                                        <Setter Property="Foreground" Value="#007AFF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Source}" Value="Network">
                                                        <Setter Property="Foreground" Value="#E8A84E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" Foreground="#1D1D1F"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                            </StackPanel>
                            <TextBlock FontSize="10" Foreground="#8E8E93" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding NameInfo.VersionSummary, Mode=OneWay}"/>
                                <Run Text=" · "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                                <Run Text=" · "/><Run Text="{Binding ModifiedTimeText, Mode=OneWay}"/>
                                <Run Text="{Binding BuildText, Mode=OneWay}"/>
                            </TextBlock>
                            <!-- 手动指定的包：额外显示其所在目录（可能不在安装包目录内） -->
                            <TextBlock Text="{Binding DirectoryText}" FontSize="9" Foreground="#9A9AA0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DirectoryText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source}" Value="PickedManually">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PackageListHint" Style="{StaticResource Hint}" VerticalAlignment="Center"
                           Text="点击「刷新」扫描目录中的 .7z 安装包。只列出茶包版（名称必须含 +lcb. 段），防止误升级到其他版本 BGI。"/>
                <Button x:Name="PickPackageFileButton" Content="选择指定压缩包…" Grid.Column="1" Height="26" Padding="10,0"
                        Margin="10,0,0,0" Style="{StaticResource Btn}" VerticalAlignment="Center"
                        ToolTip="不经目录扫描，直接弹窗选择一个安装包（同样要求文件名符合规范）"
                        Click="PickPackageFileButton_Click"/>
            </Grid>

            <!-- 排除目录 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="排除目录（更新时不覆盖）" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                <Button x:Name="AddExcludeButton" Content="添加目录…" Grid.Column="1" Height="28" Padding="12,0" Style="{StaticResource Btn}" Click="AddExcludeButton_Click"/>
            </Grid>
            <ItemsControl x:Name="ExcludeList" Style="{StaticResource DirectoryList}"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="通常留空即可。选中的目录会在解压时整个跳过；请勿排除 BGI 需要更新的目录，否则部分功能可能缺失或无法使用。按住 Ctrl 可多选。"/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="备份目录" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                <Button x:Name="AddBackupButton" Content="添加目录…" Grid.Column="1" Height="28" Padding="12,0"
                        Style="{StaticResource Btn}" AutomationProperties.Name="添加备份目录" Click="AddBackupButton_Click"/>
            </Grid>
            <ItemsControl x:Name="BackupList" Style="{StaticResource DirectoryList}"/>
            <CheckBox x:Name="BackupCheckBox" Content="更新前备份" IsChecked="True" Margin="0,6,0,0" Cursor="Hand"
                      FontSize="12" FontWeight="SemiBold" Foreground="#1D1D1F"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="按住 Ctrl 可多选。勾选后，解压前将所选目录复制到 BGI 目录下的 _update_backup。每次成功更新后清理超过 10 天的更新备份。"/>

        </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>
