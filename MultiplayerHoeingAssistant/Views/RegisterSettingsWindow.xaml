<Window x:Class="MultiplayerHoeingAssistant.Views.RegisterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MultiplayerHoeingAssistant.ViewModels"
        Title="{Binding Title}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#24203F" Foreground="#F4F2FA"
        FontFamily="pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC, Segoe UI, Microsoft YaHei" FontSize="13">
    <Window.Resources><BooleanToVisibilityConverter x:Key="Visible" /></Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{DynamicResource GoldScrollViewer}">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title}" FontSize="19" Foreground="#F2E3B6" Margin="0,0,0,8" />
        <TextBlock Text="{Binding CurrentState}" FontSize="11" Foreground="#B2ACCD" TextWrapping="Wrap" Margin="0,0,0,20" />
        <TextBlock Text="寄存器名称" Foreground="#F2E3B6" Margin="0,0,0,8" />
        <TextBox AutomationProperties.Name="寄存器名称" MaxLength="40" Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"
                 Style="{DynamicResource GoldInput}" Background="#211D35" Foreground="#F4F2FA" BorderBrush="#837044" Padding="8,5"
                 ToolTip="最多40字；不填写时显示R1–R10。改名不会改变节点引用的位号。" />
        <TextBlock Text="自动重置为0" Foreground="#F2E3B6" Margin="0,22,0,8" />
        <ComboBox AutomationProperties.Name="重置规则" SelectedIndex="{Binding ModeIndex}" Style="{DynamicResource GoldComboBox}" ItemContainerStyle="{DynamicResource GoldComboItem}">
            <ComboBoxItem Content="不自动重置" Style="{DynamicResource GoldComboItem}" />
            <ComboBoxItem Content="每天固定时间重置" Style="{DynamicResource GoldComboItem}" />
            <ComboBoxItem Content="状态变化后自动重置" Style="{DynamicResource GoldComboItem}" />
        </ComboBox>
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Visibility="{Binding IsDaily,Converter={StaticResource Visible}}">
            <ComboBox Width="72" ItemsSource="{x:Static vm:RegisterSettingsViewModel.HourChoices}" SelectedItem="{Binding Hour}"
                      Style="{DynamicResource GoldComboBox}" ItemContainerStyle="{DynamicResource GoldComboItem}" AutomationProperties.Name="固定重置小时" />
            <TextBlock Text="时" VerticalAlignment="Center" Margin="8,0,14,0" />
            <ComboBox Width="72" ItemsSource="{x:Static vm:RegisterSettingsViewModel.MinuteChoices}" SelectedItem="{Binding Minute}"
                      Style="{DynamicResource GoldComboBox}" ItemContainerStyle="{DynamicResource GoldComboItem}" AutomationProperties.Name="固定重置分钟" />
            <TextBlock Text="分" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsAfterChange,Converter={StaticResource Visible}}">
            <WrapPanel>
                <ComboBox Width="62" ItemsSource="{x:Static vm:RegisterSettingsViewModel.DayChoices}" SelectedItem="{Binding Days}" Style="{DynamicResource GoldComboBox}" ItemContainerStyle="{DynamicResource GoldComboItem}" AutomationProperties.Name="延时重置天数" />
                <TextBlock Text="天" VerticalAlignment="Center" Margin="6,0,10,0" />
                <ComboBox Width="62" ItemsSource="{x:Static vm:RegisterSettingsViewModel.HourChoices}" SelectedItem="{Binding DelayHours}" Style="{DynamicResource GoldComboBox}" ItemContainerStyle="{DynamicResource GoldComboItem}" AutomationProperties.Name="延时重置小时" />
                <TextBlock Text="时" VerticalAlignment="Center" Margin="6,0,10,0" />
                <ComboBox Width="62" ItemsSource="{x:Static vm:RegisterSettingsViewModel.MinuteChoices}" SelectedItem="{Binding DelayMinutes}" Style="{DynamicResource GoldComboBox}" ItemContainerStyle="{DynamicResource GoldComboItem}" AutomationProperties.Name="延时重置分钟" />
                <TextBlock Text="分" VerticalAlignment="Center" Margin="6,0,10,0" />
                <ComboBox Width="62" ItemsSource="{x:Static vm:RegisterSettingsViewModel.MinuteChoices}" SelectedItem="{Binding DelaySeconds}" Style="{DynamicResource GoldComboBox}" ItemContainerStyle="{DynamicResource GoldComboItem}" AutomationProperties.Name="延时重置秒数" />
                <TextBlock Text="秒" VerticalAlignment="Center" Margin="6,0,0,0" />
            </WrapPanel>
            <TextBlock Text="状态从0变为1后开始计时；重复写入1和改名不会延长计时。" Foreground="#B2ACCD" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <TextBlock Text="名称、状态与重置规则会保存；重启助手时，已到期的位会先归零。" Foreground="#B2ACCD" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0" />
        <TextBlock Text="{Binding Error}" Foreground="#E88A6F" TextWrapping="Wrap" Margin="0,10,0,0" />
        <TextBlock Text="{Binding OperationStatus}" Foreground="#A9DECB" TextWrapping="Wrap" Margin="0,4,0,0" />
        <DockPanel Margin="0,16,0,0" LastChildFill="False">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button x:Name="SetOneButton" Content="本位归一" Style="{DynamicResource BtnGhost}" Padding="10,7" Margin="0,0,6,0" Click="SetOneClick" ToolTip="立即将当前这一位置为1，沿用已保存的重置规则，不保存尚未应用的名称和规则。" />
            <Button x:Name="ResetButton" Content="本位归零" Style="{DynamicResource BtnGhost}" Padding="10,7" Margin="0,0,6,0" Click="ResetClick" ToolTip="立即将当前这一位重置为0，不保存尚未应用的名称和规则。" />
            <Button x:Name="ResetAllButton" Content="全部归零" Style="{DynamicResource BtnGhost}" Padding="10,7" Click="ResetAllClick" ToolTip="确认后将R1–R10全部重置为0，保留名称和自动重置规则。" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button x:Name="CancelButton" Content="取消" IsCancel="True" Style="{DynamicResource BtnGhost}" Padding="16,7" Margin="0,0,10,0" />
            <Button x:Name="SaveButton" Content="保存设置" IsDefault="True" Style="{DynamicResource BtnGold}" Padding="16,7" Click="SaveClick" />
          </StackPanel>
        </DockPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
