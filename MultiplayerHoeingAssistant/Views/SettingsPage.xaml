<UserControl x:Class="MultiplayerHoeingAssistant.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:MultiplayerHoeingAssistant.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignWidth="700"
             mc:Ignorable="d">

    <!-- 本页面复用 MainWindow.Resources 中定义的样式和颜色（GoldScrollViewer、QuestCard、GuildCheckBox、BtnGold、GoldText、White、Dim 等）。
         作为 UserControl 放在 MainWindow 内部，可视树继承父级资源，不需额外引用。 -->

    <!-- 自包含 ComboBox 样式（MainWindow 未定义，此处独立提供） -->
    <!-- 注意：所有 StaticResource 在 UserControl.Resources 内部引用父级 Window 资源时
         必须使用 DynamicResource，因为 StaticResource 在编译时解析，UserControl 的
         资源字典无法向上查找父级 Window 的 Resources。 -->
    <UserControl.Resources>
        <!-- 本 UserControl 的 StaticResource 无法向上找到 MainWindow 资源，转换器需自带（同 DodocoPage） -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 折叠卡片通用 Expander 模板：默认模板头部带虚线焦点框且不横向拉伸，
             此处自绘——整行可点、无焦点虚线框，头部内容（标题/右侧"设置项"）由 Header 提供 -->
        <Style x:Key="CardExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ToggleButton Grid.Row="0"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Cursor="Hand"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Background="Transparent" BorderThickness="0" Padding="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Stretch"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Grid.Row="1"
                                              Visibility="Collapsed"
                                              Content="{TemplateBinding Content}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 折叠卡片头部右侧的小箭头：展开时翻转朝上 -->
        <Style x:Key="CardChevron" TargetType="Path">
            <Setter Property="Data" Value="M 0,0 L 4,4 L 8,0"/>
            <Setter Property="Stroke" Value="{DynamicResource Dim}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,1,0,0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <RotateTransform Angle="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                    <Setter Property="LayoutTransform">
                        <Setter.Value>
                            <RotateTransform Angle="180"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 鎏金下拉选择框（原神风格）：ToggleButton 控制开合，Popup 显示下拉项 -->
        <Style x:Key="GoldComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="#2A1C1640"
                                                BorderBrush="#B0D4AF37"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="8,0,7,0">
                                            <Grid TextElement.Foreground="#FFFFFF"
                                                  TextElement.FontFamily="{DynamicResource ContentControlThemeFontFamily}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  TextElement.Foreground="#FFFFFF"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  IsHitTestVisible="False"/>
                                                <Path Grid.Column="1"
                                                      Data="M 0,0 L 4,4 L 8,0"
                                                      Stroke="{DynamicResource Gold}"
                                                      StrokeThickness="1.6"
                                                      StrokeLineJoin="Round"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3B2E1A40"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F0E8C96D"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#38251040"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   StaysOpen="False"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220" Margin="0,4,0,0">
                                    <Border Background="#232048"
                                            BorderBrush="{DynamicResource GoldLine}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="2"
                                            Effect="{DynamicResource CardShadow}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      Style="{DynamicResource GoldScrollViewer}">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 鎏金下拉选项 -->
        <Style x:Key="GoldComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="5" Padding="10,7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3DD4AF37"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B2E1A"/>
                                <Setter Property="Foreground" Value="{DynamicResource GoldText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{DynamicResource GoldScrollViewer}">
        <StackPanel Margin="0,0,0,24">

            <!-- ========== 顶栏（返回按钮） ========== -->
            <Grid Margin="0,0,0,16">
                <Button Content="←  返回" Style="{DynamicResource BtnGhost}" Padding="12,5"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Command="{Binding CloseSettingsCommand}"/>
            </Grid>

            <!-- ========== 卡片：房间设置 ========== -->
            <Border Style="{DynamicResource QuestCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="房间设置" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource White}"/>
                        <TextBlock Text="服务器地址、房间密码、玩家信息、UID、BGI 路径"
                                   FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="打开房间设置" Style="{DynamicResource BtnGold}"
                            Command="{Binding OpenRoomSettingsCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ========== 卡片：启动策略（折叠式，与桌宠卡片同款交互） ========== -->
            <Border Style="{DynamicResource QuestCard}" Margin="0,0,0,16">
                <Expander IsExpanded="False" Margin="0,0,0,4" Style="{StaticResource CardExpander}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="助手启动策略" FontSize="15" FontWeight="Medium"
                                       Foreground="{DynamicResource White}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,4,0,0">
                                <TextBlock Text="设置项" FontSize="12" Foreground="{DynamicResource Dim}"/>
                                <Path Style="{StaticResource CardChevron}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">

                    <!-- ① 随 BGI 启动 -->
                    <Border Background="#1E262660" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding AutoLaunchWithBgi, Mode=TwoWay}"
                                      Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Top" Margin="0,2,16,0" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="随 BGI 启动" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource White}"/>
                                <TextBlock Text="检测到 BGI 进程存在时自动启动助手"
                                           FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="2" Width="150"
                                      IsEnabled="{Binding AutoLaunchWithBgi}"
                                      SelectedIndex="{Binding AutoLaunchWithBgiModeIndex}"
                                      Style="{DynamicResource GoldComboBox}"
                                      VerticalAlignment="Center">
                                <!-- 闭合态显示两字短标签（Content），下拉经 ItemTemplate 显示完整选项（与启动中心同款交互） -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBoxItem Content="弹窗" Tag="弹窗启动" Style="{DynamicResource GoldComboItem}"/>
                                <ComboBoxItem Content="静默" Tag="静默缩小到托盘" Style="{DynamicResource GoldComboItem}"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- ② 开机自启动 -->
                    <Border Background="#1E262660" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding AutoLaunchOnBoot, Mode=TwoWay}"
                                      Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Top" Margin="0,2,16,0" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="开机自启动" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource White}"/>
                                <TextBlock Text="系统启动时自动启动助手"
                                           FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="2" Width="150"
                                      IsEnabled="{Binding AutoLaunchOnBoot}"
                                      SelectedIndex="{Binding AutoLaunchOnBootModeIndex}"
                                      Style="{DynamicResource GoldComboBox}"
                                      VerticalAlignment="Center">
                                <!-- 闭合态显示两字短标签（Content），下拉经 ItemTemplate 显示完整选项（与启动中心同款交互） -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBoxItem Content="弹窗" Tag="弹窗启动" Style="{DynamicResource GoldComboItem}"/>
                                <ComboBoxItem Content="静默" Tag="静默缩小到托盘" Style="{DynamicResource GoldComboItem}"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- ③ 守护 BGI（监控模式下隐藏：本机不创建 BGI 进程监控器） -->
                    <Border Background="#1E262660" CornerRadius="8" Padding="12,10"
                            Visibility="{Binding IsExecutorMode, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding GuardBgi, Mode=TwoWay}"
                                      Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Top" Margin="0,2,16,0" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="守护 BGI" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource White}"/>
                                <TextBlock Text="助手运行时，BGI 异常退出则自动重启 BGI"
                                           FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    </StackPanel>
                </Expander>
            </Border>

            <!-- ========== 卡片：奥黛塔桌宠（Pet 挂在 Window 上，绑定走 RelativeSource Window） ========== -->
            <Border Style="{DynamicResource QuestCard}" Margin="0,0,0,16">
                <!-- 设置项折叠：默认收起、每次进入设置页都收起（不记忆展开状态，见代码后置 IsVisibleChanged）；
                     标题与描述放在 Header 内，"设置项"与标题同行右对齐 -->
                <Expander x:Name="PetSettingsExpander" IsExpanded="False" Margin="0,0,0,4"
                          Style="{StaticResource CardExpander}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="奥黛塔桌宠" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource White}"/>
                                <TextBlock Text="桌面常驻的 Q 版徽章宠物，表情随任务状态变化；拖拽移动、滚轮缩放、双击唤出主窗口"
                                           FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- 右上角弱化的"设置项"入口 + 小箭头（展开时翻转朝上） -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,4,0,0">
                                <TextBlock Text="设置项" FontSize="12" Foreground="{DynamicResource Dim}"/>
                                <Path Style="{StaticResource CardChevron}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">

                    <!-- 显示开关 -->
                    <Border Background="#1E262660" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding Pet.Enabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                      Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Top" Margin="0,2,16,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="显示奥黛塔" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource White}"/>
                                <TextBlock Text="关闭后桌宠完全隐藏，大小和位置等设置保留"
                                           FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 大小滑条（滚轮在宠物上缩放同样生效，两处共用一个值） -->
                    <Border Background="#1E262660" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                            IsEnabled="{Binding Pet.Enabled, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="大小" FontSize="13" Foreground="{DynamicResource White}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Slider Grid.Column="1" Minimum="50" Maximum="250" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Value="{Binding Pet.SizePx, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="{Binding Pet.SizePx, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0:0}px}"/>
                        </Grid>
                    </Border>

                    <!-- 透明度（宠物整体） -->
                    <Border Background="#1E262660" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                            IsEnabled="{Binding Pet.Enabled, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="透明度" FontSize="13" Foreground="{DynamicResource White}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Slider Grid.Column="1" Minimum="0.3" Maximum="1"
                                    Value="{Binding Pet.PetOpacity, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="{Binding Pet.PetOpacity, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0:P0}}"/>
                        </Grid>
                    </Border>

                    <!-- 免打扰穿透（穿透开启后桌宠窗口不再响应鼠标，本开关与托盘菜单是唯二解锁入口） -->
                    <Border Background="#1E262660" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding Pet.ClickThrough, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                      Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Top" Margin="0,2,16,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="免打扰穿透" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource White}"/>
                                <TextBlock Text="开启后鼠标点击会穿过桌宠和状态面板直达桌面/游戏，拖拽、滚轮缩放、右键菜单全部失效；解锁请用托盘菜单或关闭本开关"
                                           FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 任务状态详情面板（独立窗口） -->
                    <Border Background="#1E262660" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                            IsEnabled="{Binding Pet.Enabled, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding Pet.PanelEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                      Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="任务状态面板" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource White}"/>
                                <TextBlock Text="长方形独立窗口：锄地进度/线路/好感时间轮次等全部任务状态；可拖动、调大小、单独关闭"
                                           FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Slider Grid.Column="2" Width="120" Minimum="0.3" Maximum="1"
                                    IsEnabled="{Binding Pet.PanelEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Value="{Binding Pet.PanelOpacity, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    ToolTip="面板透明度"/>
                        </Grid>
                    </Border>

                    <!-- 音效 -->
                    <Border Background="#1E262660" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                            IsEnabled="{Binding Pet.Enabled, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="音效" FontSize="13" Foreground="{DynamicResource White}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                    Value="{Binding Pet.SoundVolume, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="12,0,16,0"
                                       Text="{Binding Pet.SoundVolume, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0:P0}}"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding Pet.SoundMuted, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                          Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="静音" FontSize="12" Foreground="{DynamicResource White}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 置顶 + 任务标签 -->
                    <Grid IsEnabled="{Binding Pet.Enabled, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1E262660" CornerRadius="8" Padding="12,10" Margin="0,0,5,0">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding Pet.Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                          Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="窗口置顶" FontSize="13" Foreground="{DynamicResource White}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1E262660" CornerRadius="8" Padding="12,10" Margin="5,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding Pet.ShowTaskLabel, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                          Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="显示任务标签" FontSize="13" Foreground="{DynamicResource White}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </StackPanel>
                    </Expander>
            </Border>

            <!-- ========== 卡片：关于 ========== -->
            <Border Style="{DynamicResource QuestCard}">
                <StackPanel>
                    <TextBlock Text="关于" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource White}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Nexus-BGI 联机助手 · 提瓦特生物灭绝计划"
                               FontSize="12" Foreground="{DynamicResource Dim}"/>
                    <TextBlock Text="配置保存于 assistant-config.json，修改后自动生效"
                               FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>