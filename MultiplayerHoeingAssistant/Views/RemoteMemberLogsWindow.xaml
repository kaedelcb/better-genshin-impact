<Window x:Class="MultiplayerHoeingAssistant.Views.RemoteMemberLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程成员日志" Width="560" Height="500" MinWidth="430" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#211D40" Foreground="#F4F2FA" FontFamily="Microsoft YaHei">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 独立定义列表模板；系统主题在禁用或失焦时也不能把背景和选中行改成浅色。 -->
        <Style x:Key="RemoteLogFileList" TargetType="ListBox">
            <Setter Property="Background" Value="#211D40"/>
            <Setter Property="Foreground" Value="#F4F2FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RemoteLogFileItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F4F2FA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#302B4C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A3456"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#B7994A"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#342F4E"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#746342"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="远程成员日志" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource Gold}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding LogRoomLabel}" FontSize="11"
                       Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="12,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding LogRoomLabel}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="AssistLogRoomButton" Content="协助房间" Click="AssistLogRoom_Click"
                        Style="{DynamicResource BtnGhost}" Padding="8,4" FontSize="11"
                        ToolTip="输入房间号和密码，仅切换日志面板"/>
                <Button x:Name="ReturnOwnLogRoomButton" Content="返回本房间" Margin="6,0,0,0"
                        Command="{Binding ReturnToOwnLogRoomCommand}" Style="{DynamicResource BtnGhost}"
                        Padding="8,4" FontSize="11"
                        Visibility="{Binding CanReturnToOwnLogRoom, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>

        <WrapPanel x:Name="RoomLogActionsRow" Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="DownloadRoomTodayLogsButton" Content="下载全房间当天日志"
                    Command="{Binding DownloadRoomTodayLogsCommand}" Style="{DynamicResource BtnGhost}"
                    Padding="10,4" FontSize="11"
                    ToolTip="收集当前房间全部成员当天的 BGI 和助手日志，按成员保存；共享关闭或离线会在结果中说明"/>
            <Button x:Name="CancelRoomLogDownloadButton" Content="取消批量下载" Margin="8,0,0,0"
                    Command="{Binding CancelRoomLogDownloadCommand}" Style="{DynamicResource BtnGhost}"
                    Padding="8,4" FontSize="11"
                    Visibility="{Binding IsRoomLogDownloadRunning, Converter={StaticResource BoolToVis}}"/>
            <Button x:Name="OpenRoomLogDownloadFolderButton" Content="打开目录" Margin="8,0,0,0"
                    Command="{Binding OpenRoomLogDownloadFolderCommand}" Style="{DynamicResource BtnGhost}"
                    Padding="8,4" FontSize="11"
                    Visibility="{Binding HasRoomLogDownloadDirectory, Converter={StaticResource BoolToVis}}"
                    ToolTip="打开本次全房间日志的保存目录"/>
        </WrapPanel>

        <Grid x:Name="SingleLogFiltersRow" Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="114"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="RemoteMemberBox" MinWidth="100" ClipToBounds="True"
                      ItemsSource="{Binding RemoteMembers}" SelectedItem="{Binding SelectedRemoteMember}"
                      IsEnabled="{Binding CanUseSingleRemoteLogs}"
                      Style="{DynamicResource GoldComboBox}" ItemContainerStyle="{DynamicResource GoldComboItem}"
                      ToolTip="选择在线执行端；监控模式也可选择自己的执行端"/>
            <TextBlock Grid.Column="1" Text="日期" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource Dim}" Margin="8,0"/>
            <ComboBox x:Name="RemoteDateFilterBox" Grid.Column="2" FontSize="11"
                      ItemsSource="{Binding RemoteDateFilterItems}" SelectedItem="{Binding SelectedRemoteDateFilter}"
                      Style="{DynamicResource GoldComboBox}" ItemContainerStyle="{DynamicResource GoldComboItem}"
                      ToolTip="按文件最后修改日期筛选，默认当天；也可选择其他日期或全部日期"/>
            <Button Grid.Column="3" Content="获取列表" Style="{DynamicResource BtnGhost}"
                    IsEnabled="{Binding CanUseSingleRemoteLogs}" Padding="8,4" FontSize="11" Margin="8,0,0,0"
                    Command="{Binding FetchRemoteFilesCommand}"
                    ToolTip="向选中成员请求日志文件列表（需对方开启「共享日志文件」）"/>
        </Grid>
        <ProgressBar Grid.Row="3" Minimum="0" Maximum="1" Height="4" Margin="0,0,0,8"
                     Value="{Binding RoomLogDownloadProgress, Mode=OneWay}"
                     Visibility="{Binding IsRoomLogDownloadRunning, Converter={StaticResource BoolToVis}}"/>

        <Grid Grid.Row="4">
            <!-- 保持列表可浏览；批量期间只锁定会发起请求的控件，避免系统禁用模板刷成白底。 -->
            <ListBox x:Name="RemoteFilesList" ItemsSource="{Binding RemoteFilesView}" IsSynchronizedWithCurrentItem="False"
                     SelectedItem="{Binding SelectedRemoteFile}" Style="{StaticResource RemoteLogFileList}"
                     ItemContainerStyle="{StaticResource RemoteLogFileItem}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,3">
                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource White}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource Dim}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="DateText"/>
                                        <Binding Path="SizeText"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding RemoteDateFilterHint}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource Dim}" Margin="4" IsHitTestVisible="False"/>
        </Grid>
        <ScrollViewer Grid.Row="5" MaxHeight="64" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{Binding RemoteStatus}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Dim}"/>
                <TextBlock Text="{Binding RoomLogDownloadStatus}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Gold}"/>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="下载" IsEnabled="{Binding CanUseSingleRemoteLogs}" Style="{DynamicResource BtnGhost}"
                        Padding="12,5" FontSize="12" Command="{Binding DownloadRemoteFileCommand}"
                        ToolTip="下载到本机 log\remote_downloads\，完成后自动在日志浏览页打开"/>
                <TextBlock Text="{Binding RemoteFilesView.Count, StringFormat='显示 {0} 个'}" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Dim}"/>
            </StackPanel>
            <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Height="4" Margin="12,0"
                         VerticalAlignment="Center" Value="{Binding DownloadProgress, Mode=OneWay}"/>
            <Button Grid.Column="2" Content="关闭" IsCancel="True" Style="{DynamicResource BtnGhost}"
                    Padding="12,5" FontSize="12"/>
        </Grid>
    </Grid>
</Window>
