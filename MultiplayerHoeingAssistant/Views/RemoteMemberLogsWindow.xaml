<Window x:Class="MultiplayerHoeingAssistant.Views.RemoteMemberLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程成员日志" Width="560" Height="500" MinWidth="430" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#211D40" Foreground="#F4F2FA" FontFamily="Microsoft YaHei">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button x:Name="AssistLogRoomButton" DockPanel.Dock="Right" Content="协助房间"
                    Click="AssistLogRoom_Click" Style="{DynamicResource BtnGhost}"
                    Padding="8,4" FontSize="11" ToolTip="输入房间号和密码，仅切换日志面板"/>
            <TextBlock Text="远程成员日志" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource Gold}" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="ReturnOwnLogRoomButton" DockPanel.Dock="Right" Content="返回本房间"
                    Command="{Binding ReturnToOwnLogRoomCommand}" Style="{DynamicResource BtnGhost}"
                    Padding="8,3" FontSize="11"
                    Visibility="{Binding CanReturnToOwnLogRoom, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding LogRoomLabel}" FontSize="12" Foreground="{DynamicResource Dim}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding LogRoomLabel}"/>
        </DockPanel>
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <Button x:Name="OpenRoomLogDownloadFolderButton" DockPanel.Dock="Right" Content="打开目录"
                        Command="{Binding OpenRoomLogDownloadFolderCommand}" Style="{DynamicResource BtnGhost}"
                        Padding="8,4" FontSize="11" Margin="8,0,0,0"
                        Visibility="{Binding HasRoomLogDownloadDirectory, Converter={StaticResource BoolToVis}}"
                        ToolTip="打开本次全房间日志的保存目录"/>
                <Button x:Name="CancelRoomLogDownloadButton" DockPanel.Dock="Right" Content="取消批量下载"
                        Command="{Binding CancelRoomLogDownloadCommand}" Style="{DynamicResource BtnGhost}"
                        Padding="8,4" FontSize="11" Margin="8,0,0,0"
                        Visibility="{Binding IsRoomLogDownloadRunning, Converter={StaticResource BoolToVis}}"/>
                <Button x:Name="DownloadRoomTodayLogsButton" Content="下载全房间当天日志"
                        Command="{Binding DownloadRoomTodayLogsCommand}" Style="{DynamicResource BtnGhost}"
                        HorizontalAlignment="Left" Padding="10,4" FontSize="11"
                        ToolTip="收集当前房间全部成员当天的 BGI 和助手日志，按成员保存；共享关闭或离线会在结果中说明"/>
            </DockPanel>
            <ProgressBar Grid.Row="1" Minimum="0" Maximum="1" Height="4" Margin="0,6,0,0"
                         Value="{Binding RoomLogDownloadProgress, Mode=OneWay}"
                         Visibility="{Binding IsRoomLogDownloadRunning, Converter={StaticResource BoolToVis}}"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,8" IsEnabled="{Binding CanUseSingleRemoteLogs}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding RemoteMembers}" SelectedItem="{Binding SelectedRemoteMember}"
                      Style="{DynamicResource GoldComboBox}" ItemContainerStyle="{DynamicResource GoldComboItem}"
                      ToolTip="选择在线执行端；监控模式也可选择自己的执行端"/>
            <Button Grid.Column="1" Content="获取列表" Style="{DynamicResource BtnGhost}"
                    Padding="10,4" FontSize="12" Margin="8,0,0,0" Command="{Binding FetchRemoteFilesCommand}"
                    ToolTip="向选中成员请求日志文件列表（需对方开启「共享日志文件」）"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="日期" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" Margin="0,0,8,0"/>
            <ComboBox x:Name="RemoteDateFilterBox" Grid.Column="1" FontSize="11"
                      ItemsSource="{Binding RemoteDateFilterItems}" SelectedItem="{Binding SelectedRemoteDateFilter}"
                      Style="{DynamicResource GoldComboBox}" ItemContainerStyle="{DynamicResource GoldComboItem}"
                      ToolTip="按文件最后修改日期筛选，默认当天；也可选择其他日期或全部日期"/>
            <TextBlock Grid.Column="2" Text="{Binding RemoteFilesView.Count, StringFormat='显示 {0} 个'}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Dim}"/>
        </Grid>
        <Grid Grid.Row="5">
            <ListBox IsEnabled="{Binding CanUseSingleRemoteLogs}" x:Name="RemoteFilesList" ItemsSource="{Binding RemoteFilesView}" IsSynchronizedWithCurrentItem="False"
                     SelectedItem="{Binding SelectedRemoteFile}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,3">
                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource White}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource Dim}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="DateText"/>
                                        <Binding Path="SizeText"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding RemoteDateFilterHint}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource Dim}" Margin="4" IsHitTestVisible="False"/>
        </Grid>
        <ScrollViewer Grid.Row="6" MaxHeight="64" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{Binding RemoteStatus}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Dim}"/>
                <TextBlock Text="{Binding RoomLogDownloadStatus}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Gold}"/>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="7" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="下载" IsEnabled="{Binding CanUseSingleRemoteLogs}" Style="{DynamicResource BtnGhost}" Padding="14,5" FontSize="12"
                    Command="{Binding DownloadRemoteFileCommand}"
                    ToolTip="下载到本机 log\remote_downloads\，完成后自动在日志浏览页打开"/>
            <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Height="4" Margin="12,0"
                         VerticalAlignment="Center" Value="{Binding DownloadProgress}"/>
            <Button Grid.Column="2" Content="关闭" IsCancel="True" Style="{DynamicResource BtnGhost}"
                    Padding="14,5" FontSize="12"/>
        </Grid>
    </Grid>
</Window>
