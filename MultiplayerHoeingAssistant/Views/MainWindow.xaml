<Window x:Class="MultiplayerHoeingAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MultiplayerHoeingAssistant.Views"
        xmlns:vm="clr-namespace:MultiplayerHoeingAssistant.ViewModels"
        xmlns:helpers="clr-namespace:MultiplayerHoeingAssistant.Helpers"
        Title="Nexus BGI"
        Width="1180" Height="860"
        MinWidth="980" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC, Segoe UI, Microsoft YaHei"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#141534" Offset="0"/>
            <GradientStop Color="#221F4E" Offset="0.55"/>
            <GradientStop Color="#1B1943" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:StringEqualsMultiConverter x:Key="StringEqualsMulti"/>
        <!-- ========== 原神夜空色板 ========== -->
        <SolidColorBrush x:Key="Card" Color="#CC26234E"/>
        <SolidColorBrush x:Key="CardEdge" Color="#47D4AF37"/>
        <SolidColorBrush x:Key="Gold" Color="#E8C96D"/>
        <SolidColorBrush x:Key="GoldDeep" Color="#C9A53F"/>
        <SolidColorBrush x:Key="GoldText" Color="#F2E3B6"/>
        <SolidColorBrush x:Key="GoldLine" Color="#80D4AF37"/>
        <SolidColorBrush x:Key="White" Color="#F4F2FA"/>
        <SolidColorBrush x:Key="Dim" Color="#9C97C0"/>
        <SolidColorBrush x:Key="Water" Color="#8FC1E8"/>
        <SolidColorBrush x:Key="Electro" Color="#C9A0E8"/>
        <SolidColorBrush x:Key="Anemo" Color="#6FD8CE"/>
        <SolidColorBrush x:Key="Pyro" Color="#E88A6F"/>
        <SolidColorBrush x:Key="Geo" Color="#D9A84E"/>
        <SolidColorBrush x:Key="Orange" Color="#E8A84E"/>

        <!-- 鎏金按钮渐变 -->
        <LinearGradientBrush x:Key="GoldBtnGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EFD68A" Offset="0"/>
            <GradientStop Color="#D4AF37" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldBtnGradHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F6E0A0" Offset="0"/>
            <GradientStop Color="#E0BC45" Offset="1"/>
        </LinearGradientBrush>

        <!-- 卡片阴影 -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#0A081E"/>

        <!-- 委托卡（金色左竖条由内部 Grid 实现） -->
        <Style x:Key="QuestCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Padding" Value="13,11,16,11"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- 区块小标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
        </Style>

        <!-- ========== 按钮体系 ========== -->
        <!-- 鎏金主按钮 -->
        <Style x:Key="BtnGold" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GoldBtnGrad}"/>
            <Setter Property="Foreground" Value="#3A2F16"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.3" Color="#D4AF37"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldBtnGradHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深紫幽灵按钮 -->
        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Background" Value="#2E6E6EB4"/>
            <Setter Property="Foreground" Value="#C9C4E6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#479C97C0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#428278C2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 火红描边危险按钮 -->
        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Pyro}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#66E88A6F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FE88A6F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文字操作按钮（像卡片上的文字，可点击） -->
        <Style x:Key="TextAction" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource White}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cp" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GuildCheckBox" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="{StaticResource White}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="20" Height="20">
                                <Border x:Name="Outer" CornerRadius="10" BorderThickness="1.5" BorderBrush="{StaticResource Dim}" Background="#332E2660" SnapsToDevicePixels="True"/>
                                <Border x:Name="Inner" CornerRadius="10" Background="{StaticResource GoldBtnGrad}" Opacity="0" SnapsToDevicePixels="True">
                                    <Path Data="M 4,10.5 L 8.5,14.5 L 16,6.5" Stroke="#3A2F16" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Border>
                            </Grid>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource Gold}"/>
                                <Setter TargetName="Inner" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 元素胶囊 ========== -->
        <Style x:Key="TagPillBase" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagGroupPill" TargetType="Button" BasedOn="{StaticResource TagPillBase}">
            <Setter Property="Background" Value="#613E5F8A"/>
            <Setter Property="Foreground" Value="{StaticResource Water}"/>
            <Setter Property="BorderBrush" Value="#668FC1E8"/>
        </Style>

        <Style x:Key="TagOneClickPill" TargetType="Button" BasedOn="{StaticResource TagPillBase}">
            <Setter Property="Background" Value="#6B5B3A85"/>
            <Setter Property="Foreground" Value="{StaticResource Electro}"/>
            <Setter Property="BorderBrush" Value="#66C9A0E8"/>
        </Style>

        <Style x:Key="TagMorePill" TargetType="Button" BasedOn="{StaticResource TagPillBase}">
            <Setter Property="Background" Value="#299C97C0"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="BorderBrush" Value="#4D9C97C0"/>
        </Style>

        <!-- ========== 背景装饰画刷 ========== -->
        <!-- 星点平铺 -->
        <DrawingBrush x:Key="StarField" TileMode="Tile" Viewport="0,0,140,140" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#80FFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="18,22" RadiusX="1.1" RadiusY="1.1"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#59FFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="66,58" RadiusX="0.9" RadiusY="0.9"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#73FFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="112,34" RadiusX="1.2" RadiusY="1.2"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#4DFFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="44,96" RadiusX="0.9" RadiusY="0.9"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#66FFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="120,112" RadiusX="1" RadiusY="1"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#40FFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="88,20" RadiusX="0.8" RadiusY="0.8"/></GeometryDrawing.Geometry></GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- 菱形暗纹 -->
        <DrawingBrush x:Key="DiamondPattern" TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#07E8C96D">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 32,8 L 56,32 L 32,56 L 8,32 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- 星河光带 -->
        <RadialGradientBrush x:Key="GalaxyBand" Center="0.5,0.32" RadiusX="0.52" RadiusY="0.42">
            <GradientStop Color="#26AA8CF0" Offset="0"/>
            <GradientStop Color="#0FE8C96D" Offset="0.45"/>
            <GradientStop Color="#00E8C96D" Offset="0.75"/>
        </RadialGradientBrush>

        <!-- ========== 自定义滚动条（原神鎏金细窄款） ========== -->
        <!-- GoldScrollViewer 样式移到下方（保证 GoldVScrollBar/GoldHScrollBar 先定义，StaticResource 才能前向解析） -->

        <!-- 竖直滚动条 -->
        <Style x:Key="GoldVScrollBar" TargetType="ScrollBar">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Width="{TemplateBinding Width}">
                                <Track.Thumb>
                                    <Thumb HorizontalAlignment="Stretch">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        CornerRadius="3"
                                                        Background="#50D4AF37"
                                                        BorderThickness="0"
                                                        HorizontalAlignment="Stretch"
                                                        SnapsToDevicePixels="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.3" Color="#D4AF37"/>
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#B0D4AF37"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#E0D4AF37"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 水平滚动条 -->
        <Style x:Key="GoldHScrollBar" TargetType="ScrollBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" Orientation="Horizontal" Height="{TemplateBinding Height}">
                                <Track.Thumb>
                                    <Thumb VerticalAlignment="Stretch">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        CornerRadius="3"
                                                        Background="#50D4AF37"
                                                        BorderThickness="0"
                                                        VerticalAlignment="Stretch"
                                                        SnapsToDevicePixels="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.3" Color="#D4AF37"/>
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#B0D4AF37"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#E0D4AF37"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollViewer 模板（需在 V/H ScrollBar 之后定义，StaticResource 前向引用）；
             滚动条列宽固定常驻（GoldVScrollBar 宽4+边距2），滚动条出现/消失不改变内容区宽度 -->
        <Style x:Key="GoldScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Row="0" Grid.Column="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0" Grid.Column="1"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Style="{StaticResource GoldVScrollBar}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1" Grid.Column="0"
                                       Orientation="Horizontal"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Style="{StaticResource GoldHScrollBar}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ========== 根布局 ========== -->
    <Grid>
        <!-- ===== 背景装饰层（不响应交互） ===== -->
        <!-- 三处大半径模糊各包一层位图缓存：画一次后直接复用，页面滚动重绘时不再每帧重算模糊；
             屏幕像素与不缓存时一致（窗口改尺寸时 WPF 自动重建缓存） -->
        <Grid IsHitTestVisible="False">
            <!-- 星河光带（斜向柔光） -->
            <Decorator Margin="-160,-260,-160,320">
                <Decorator.CacheMode><BitmapCache SnapsToDevicePixels="True"/></Decorator.CacheMode>
                <Rectangle Fill="{StaticResource GalaxyBand}">
                    <Rectangle.RenderTransform><RotateTransform Angle="-13" CenterX="0.5" CenterY="0.5"/></Rectangle.RenderTransform>
                    <Rectangle.Effect><BlurEffect Radius="38"/></Rectangle.Effect>
                </Rectangle>
            </Decorator>
            <!-- 菱形暗纹 -->
            <Rectangle Fill="{StaticResource DiamondPattern}"/>
            <!-- 星点 -->
            <Rectangle Fill="{StaticResource StarField}"/>
            <!-- 辉光 -->
            <Decorator HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-140,0,0">
                <Decorator.CacheMode><BitmapCache SnapsToDevicePixels="True"/></Decorator.CacheMode>
                <Ellipse Width="480" Height="300">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#2EA078E8" Offset="0"/><GradientStop Color="#00A078E8" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="60"/></Ellipse.Effect>
                </Ellipse>
            </Decorator>
            <Decorator HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,-160">
                <Decorator.CacheMode><BitmapCache SnapsToDevicePixels="True"/></Decorator.CacheMode>
                <Ellipse Width="480" Height="380">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#1FE8C96D" Offset="0"/><GradientStop Color="#00E8C96D" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="60"/></Ellipse.Effect>
                </Ellipse>
            </Decorator>
            <!-- 命之座星座（右上） -->
            <Canvas Width="180" Height="150" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,90,40,0" Opacity="0.5">
                <Polyline Points="18,120 58,84 98,96 138,52 162,20" Stroke="#8CE8C96D" StrokeThickness="0.8"/>
                <Ellipse Canvas.Left="16" Canvas.Top="118" Width="4" Height="4" Fill="{StaticResource Gold}"/>
                <Ellipse Canvas.Left="56" Canvas.Top="82" Width="3.4" Height="3.4" Fill="{StaticResource Gold}"/>
                <Ellipse Canvas.Left="96" Canvas.Top="94" Width="4" Height="4" Fill="{StaticResource Gold}"/>
                <Ellipse Canvas.Left="136" Canvas.Top="50" Width="3.4" Height="3.4" Fill="{StaticResource Gold}"/>
                <Ellipse Canvas.Left="160" Canvas.Top="18" Width="4" Height="4" Fill="{StaticResource Gold}"/>
            </Canvas>
            <!-- 命之座星座（左下） -->
            <Canvas Width="150" Height="120" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="270,0,0,120" Opacity="0.4">
                <Polyline Points="15,95 50,60 85,72 118,32 140,10" Stroke="#80C9A0E8" StrokeThickness="0.8"/>
                <Ellipse Canvas.Left="13" Canvas.Top="93" Width="3.6" Height="3.6" Fill="{StaticResource Electro}"/>
                <Ellipse Canvas.Left="48" Canvas.Top="58" Width="3" Height="3" Fill="{StaticResource Electro}"/>
                <Ellipse Canvas.Left="83" Canvas.Top="70" Width="3.6" Height="3.6" Fill="{StaticResource Electro}"/>
                <Ellipse Canvas.Left="116" Canvas.Top="30" Width="3" Height="3" Fill="{StaticResource Electro}"/>
                <Ellipse Canvas.Left="138" Canvas.Top="8" Width="3.6" Height="3.6" Fill="{StaticResource Electro}"/>
            </Canvas>
            <!-- 派蒙装饰（右下漂浮） -->
            <Image Source="pack://application:,,,/Assets/Images/paimon.png" Width="210"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,-14"
                   Opacity="0.16" Stretch="Uniform">
                <Image.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.28" Color="#E8C96D"/></Image.Effect>
            </Image>
        </Grid>

        <!-- ===== 内容层：左右分栏 ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 嘟嘟可与槲寄生使用完整内容宽度，隐藏装饰/诊断侧栏。 -->
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="240" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:AppPage.Mistletoe}">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:AppPage.Dodoco}">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 左侧冒险家协会装饰栏 ========== -->
            <!-- 列宽为 0 时（嘟嘟可/槲寄生）整栏折叠：看不见的诊断日志框不再随每条新日志在 0 宽度下重新排版 -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{StaticResource GoldLine}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:AppPage.Mistletoe}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:AppPage.Dodoco}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#EB181638" Offset="0"/>
                        <GradientStop Color="#F012112E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 四角金饰 -->
                    <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" BorderThickness="2,2,0,0" BorderBrush="{StaticResource GoldLine}"/>
                    <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" BorderThickness="0,2,2,0" BorderBrush="{StaticResource GoldLine}"/>
                    <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" BorderThickness="2,0,0,2" BorderBrush="{StaticResource GoldLine}"/>
                    <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" BorderThickness="0,0,2,2" BorderBrush="{StaticResource GoldLine}"/>

                    <!-- 顶部：派蒙 + 品牌 -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0,34,0,0">
                        <!-- 品牌 Logo -->
                        <Image Source="pack://application:,,,/Assets/Images/logo.png" Width="140" Margin="0,6,0,14" Stretch="Uniform">
                            <Image.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35" Color="#E8C96D"/></Image.Effect>
                        </Image>
                        <TextBlock Text="联机锄地" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource GoldText}" HorizontalAlignment="Center">
                            <TextBlock.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#E8C96D"/></TextBlock.Effect>
                        </TextBlock>
                        <!-- 菱形分隔符 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,12">
                            <Border Width="34" Height="1" Background="{StaticResource GoldLine}" VerticalAlignment="Center"/>
                            <TextBlock Text="◆ ◈ ◆" FontSize="11" Foreground="{StaticResource Gold}" Margin="8,0" VerticalAlignment="Center"/>
                            <Border Width="34" Height="1" Background="{StaticResource GoldLine}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Nexus-BGI" FontSize="12" Foreground="{StaticResource Gold}" HorizontalAlignment="Center"
                                   FontFamily="Times New Roman" FontStyle="Italic"/>
                        <TextBlock Text="向着狗粮与摩拉" FontSize="13" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- 中部：诊断日志（高级；普通操作以任务中心卡片提示为准） -->
                    <Grid Grid.Row="1" Margin="16,18,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,7">
                            <TextBlock Text="诊断日志（高级）" FontSize="12" FontWeight="Medium" Foreground="{StaticResource GoldText}" ToolTip="普通操作请看任务中心的运行卡片；这里保留技术诊断记录。"/>
                            <Button Content="⊖" Style="{StaticResource TextAction}" FontSize="13"
                                    VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,0"
                                    ToolTip="清空高级诊断日志" Command="{Binding ClearLogCommand}"/>
                            <Border Height="1" Background="#40D4AF37" VerticalAlignment="Center" Margin="56,0,15,0"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource GoldScrollViewer}">
                            <TextBox Text="{Binding CommandLogsText, Mode=OneWay}" FontSize="10.5" Foreground="{StaticResource Dim}"
                                     TextWrapping="Wrap" Margin="-2,1"
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     IsTabStop="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- 底部：GUILD 铭文 -->
                    <StackPanel Grid.Row="2" Margin="0,14,0,22" HorizontalAlignment="Center">
                        <TextBlock Text="✦ ✧ ✦" FontSize="12" Foreground="{StaticResource GoldLine}" HorizontalAlignment="Center"/>
                        <TextBlock Text="TEYVAT CO-OP · GUILD" FontSize="10" Foreground="#6E6A92" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== 右侧主区 ========== -->
            <Grid Grid.Column="1" Margin="24,18,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶栏 -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 三列按实际内容分配：星光寄语紧随标题区，右侧设置保持靠右。 -->
                    <Grid x:Name="HeaderGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Row 0 Col 0：主标题与模式切换 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="冒险家协会 · 提瓦特生物灭绝计划" FontSize="17"  FontWeight="Medium" Foreground="{StaticResource GoldText}" VerticalAlignment="Center"/>
                            <!-- 连接状态与角色徽章（点击切换执行/监控模式） -->
                            <Button VerticalAlignment="Center" Cursor="Hand" Margin="8,0,0,0"
                                    ToolTip="点击切换执行端/监控端；角色与单机/在线状态独立"
                                    Command="{Binding SwitchModeCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </ControlTemplate>
                                </Button.Template>
                                <Border CornerRadius="7" Padding="9,3" VerticalAlignment="Center" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1FE88A6F"/>
                                        <Setter Property="BorderBrush" Value="#66E88A6F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Background" Value="#1F6FD8CE"/>
                                                <Setter Property="BorderBrush" Value="#666FD8CE"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsConnected}" Value="True"/>
                                                    <Condition Binding="{Binding IsObserverMode}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#1F5B8DEF"/>
                                                <Setter Property="BorderBrush" Value="#665B8DEF"/>
                                            </MultiDataTrigger>
                                            <!-- 总开关单机（有意不连/未填地址）：中性色覆盖一切连接态（后写覆盖先写） -->
                                            <DataTrigger Binding="{Binding IsStandaloneMode}" Value="True">
                                                <Setter Property="Background" Value="#1F9C97C0"/>
                                                <Setter Property="BorderBrush" Value="#669C97C0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Pyro}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Anemo}"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsConnected}" Value="True"/>
                                                        <Condition Binding="{Binding IsObserverMode}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Fill" Value="#5B8DEF"/>
                                                </MultiDataTrigger>
                                                <!-- 总开关单机：中性灰点 -->
                                                <DataTrigger Binding="{Binding IsStandaloneMode}" Value="True">
                                                    <Setter Property="Fill" Value="#9C97C0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock x:Name="ConnectionRoleBadgeText" FontSize="10" FontWeight="Medium" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="离线 · 执行端"/>
                                                <Setter Property="Foreground" Value="{StaticResource Pyro}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsObserverMode}" Value="True">
                                                        <Setter Property="Text" Value="离线 · 监控端"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Text" Value="在线 · 执行端"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Anemo}"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsConnected}" Value="True"/>
                                                        <Condition Binding="{Binding IsObserverMode}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="在线 · 监控端"/>
                                                    <Setter Property="Foreground" Value="#5B8DEF"/>
                                                </MultiDataTrigger>
                                                <!-- 单机仍显示当前角色，并与异常断连的离线状态区分 -->
                                                <DataTrigger Binding="{Binding IsStandaloneMode}" Value="True">
                                                    <Setter Property="Text" Value="单机 · 执行端"/>
                                                    <Setter Property="Foreground" Value="#C9C4E6"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsStandaloneMode}" Value="True"/>
                                                        <Condition Binding="{Binding IsObserverMode}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="单机 · 监控端"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                </Border>
                            </Button>
                            <!-- 总开关·单机/在线手动切换（离线优先：服务器是可选增强；弹窗确认；选择持久化，重启保持） -->
                            <Button VerticalAlignment="Center" Cursor="Hand" Margin="6,0,0,0"
                                    ToolTip="手动切换单机/在线（弹窗确认）。单机模式断开服务器，联机功能全部不可用，槲寄生/本机日志等本地功能照常；选择会被记住"
                                    Command="{Binding ToggleStandaloneModeCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </ControlTemplate>
                                </Button.Template>
                                <Border CornerRadius="7" Padding="9,3" VerticalAlignment="Center" BorderThickness="1"
                                        Background="#1F9C97C0" BorderBrush="#669C97C0">
                                    <TextBlock FontSize="10" FontWeight="Medium" VerticalAlignment="Center" Foreground="#C9C4E6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="切到单机"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStandaloneMode}" Value="True">
                                                        <Setter Property="Text" Value="切到在线"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Button>
                            <!-- 跨会话警告徽章：IPC 管道指向其他会话的 BGI（或无法确认会话归属）时显示 -->
                            <Border CornerRadius="7" Padding="9,3" VerticalAlignment="Center" Margin="6,0,0,0"
                                    Background="#1FE8A86F" BorderBrush="#66E8A86F" BorderThickness="1"
                                    Visibility="{Binding IsIpcSessionUntrusted, Converter={StaticResource BoolToVis}}"
                                    ToolTip="命名管道指向了其他 Windows 会话的 BGI 实例（或无法确认会话归属），其任务状态已忽略、控制指令已阻断。请检查是否存在多会话多开">
                                <TextBlock Text="⚠ 跨会话" FontSize="10" FontWeight="Medium" Foreground="#E8A86F" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <!-- 文案与 Star 胶囊整体靠左；精简间距与字号以降低占用宽度，避免窄窗被折叠隐藏。 -->
                        <Grid x:Name="HeaderStarHost" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                              Margin="10,0,8,0" ClipToBounds="True" SizeChanged="HeaderStarHostSizeChanged">
                            <Button x:Name="ProjectStarButton" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Cursor="Hand" Background="Transparent" Foreground="{StaticResource GoldText}"
                                    Padding="2,4" Click="OpenProjectGitHubClick"
                                    AutomationProperties.Name="在 GitHub 为茶包点亮 Star"
                                    ToolTip="给茶包一颗星，让热爱继续发光&#x0a;点击打开 https://github.com/kaedelcb/better-genshin-impact">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="StarHitArea" Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}" CornerRadius="8" Opacity="0.88">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="StarHitArea" Property="Opacity" Value="1"/>
                                                <Setter TargetName="StarHitArea" Property="Background" Value="#0CE8C96D"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="StarHitArea" Property="Opacity" Value="1"/>
                                                <Setter TargetName="StarHitArea" Property="Background" Value="#16E8C96D"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="StarHitArea" Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel x:Name="StarMessage" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✦" FontSize="13" Foreground="{StaticResource Gold}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="给茶包一颗星，让热爱继续发光" FontSize="11" FontWeight="Medium"
                                                       Foreground="{StaticResource GoldText}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="如果它帮到了你，欢迎在 GitHub 点亮 Star" FontSize="9.5"
                                                       Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border x:Name="StarBadge" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="12"
                                            Padding="8,2.5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 8,0 L 10.4,5.1 L 16,5.8 L 12,9.7 L 13,15.3 L 8,12.6 L 3,15.3 L 4,9.7 L 0,5.8 L 5.6,5.1 Z"
                                                  Stroke="{StaticResource Gold}" StrokeThickness="1.2" StrokeLineJoin="Round"
                                                  Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="Star" FontSize="10.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- Row 0 Col 2：正在查看房间标签（固定宽度=所有房间） + 齿轮设置 + 退出 -->
                        <Grid x:Name="HeaderActions" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="HeaderPrimaryActions" Grid.Column="0" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="HeaderViewingRoomButton" Width="96" Height="24" Margin="0,0,6,0"
                                        VerticalAlignment="Center" Cursor="Hand" Click="HeaderRoomClick"
                                        ToolTip="{Binding HeaderViewingRoomToolTip}">
                                    <AutomationProperties.Name>
                                        <Binding Path="HeaderViewingRoomFullName" StringFormat="正在查看：{0}，点击切换查看房间"/>
                                    </AutomationProperties.Name>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ViewBadge" CornerRadius="8" Padding="6,2" BorderThickness="1"
                                                    SnapsToDevicePixels="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1AE8C96D"/>
                                                        <Setter Property="BorderBrush" Value="#59D4AF37"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHeaderViewingReadOnlyRoom}" Value="True">
                                                                <Setter Property="Background" Value="#243E5F8A"/>
                                                                <Setter Property="BorderBrush" Value="#738FC1E8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ViewBadge" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ViewBadge" Property="Opacity" Value="0.72"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="查看" FontSize="10" Foreground="{StaticResource Dim}"
                                                       Margin="0,0,4,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsShowingRoomOrchestration}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock x:Name="HeaderViewingRoomText" Text="{Binding HeaderViewingRoomName}"
                                                       FontSize="10.5" FontWeight="Medium" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource GoldText}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHeaderViewingReadOnlyRoom}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Water}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Viewbox>
                                </Button>
                                <Button x:Name="HeaderSettingsButton" Content="⚙" Style="{StaticResource BtnGold}"
                                        Width="30" Height="24" Padding="0" FontSize="14"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        ToolTip="设置" AutomationProperties.Name="设置"
                                        Command="{Binding OpenSettingsCommand}"/>
                            </StackPanel>
                            <Button x:Name="HeaderExitButton" Grid.Column="1" Content="✕" Style="{StaticResource TextAction}"
                                    FontSize="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                    ToolTip="完全退出 Nexus-BGI 联机助手" Command="{Binding ExitCommand}"/>
                        </Grid>
                        <!-- Row 1 Col 0：副标题 + 导航按钮（同行，与Row 0的标题+信息结构一致） -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                            <TextBlock Text="Teyvat Biological Extinction Plan" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text=" -->" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,0,0,0" VerticalAlignment="Center"/>
							<Button Content="耕地机" FontSize="12" Margin="3,0,0,0" VerticalAlignment="Center"
                                    ToolTip="联机锄地调度控制" Command="{Binding CloseSettingsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TextAction}">
                                        <Setter Property="Foreground" Value="{StaticResource GoldText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:AppPage.Home}">
                                                <Setter Property="Foreground" Value="{StaticResource White}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0" VerticalAlignment="Center"/>
                            <!-- 嘟嘟可：日志与监控系统；HasUnreadAlerts 时右上角红点 -->
                            <Grid Margin="0,0,0,0" VerticalAlignment="Center">
                                <Button Content="嘟嘟可" FontSize="12" VerticalAlignment="Center"
                                        ToolTip="日志与监控系统" Command="{Binding ShowDodocoCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TextAction}">
                                            <Setter Property="Foreground" Value="{StaticResource GoldText}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:AppPage.Dodoco}">
                                                    <Setter Property="Foreground" Value="{StaticResource White}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Pyro}" HorizontalAlignment="Right"
                                         VerticalAlignment="Top" Margin="0,-4,-6,0" IsHitTestVisible="False"
                                         Visibility="{Binding Dodoco.HasUnreadAlerts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                            <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0" VerticalAlignment="Center"/>
                            <Button Content="槲寄生" FontSize="12" Margin="0,0,0,0" VerticalAlignment="Center"
                                    ToolTip="槲寄生 · 调度器（启动中心 / 任务中心 / 执行策略 / 三方接入）" Command="{Binding ShowMistletoeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TextAction}">
                                        <Setter Property="Foreground" Value="{StaticResource GoldText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:AppPage.Mistletoe}">
                                                <Setter Property="Foreground" Value="{StaticResource White}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <!-- Row 1 Col 2：房间号 + 刷新按钮（在查看+齿轮+退出正下方） -->
                        <Grid x:Name="RoomCodeActions" Grid.Row="1" Grid.Column="2"
                              VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="HeaderRoomButton" Width="132" Height="22"
                                    VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand"
                                    Foreground="{StaticResource GoldText}" FontSize="10" Background="Transparent"
                                    ToolTip="查看或切换房间、管理档案或复制房间号" Click="HeaderRoomClick">
                                <AutomationProperties.Name>
                                    <MultiBinding StringFormat="{}{0}，房间号 {1}，打开房间面板">
                                        <Binding Path="ActiveRoomProfile.Name" TargetNullValue="未选择" FallbackValue="未选择"/>
                                        <Binding Path="RoomCode" TargetNullValue="未设置" FallbackValue="未设置"/>
                                    </MultiBinding>
                                </AutomationProperties.Name>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Rectangle x:Name="Outline" RadiusX="4" RadiusY="4" Fill="#0DE8C96D" Stroke="{StaticResource GoldLine}"
                                                       StrokeThickness="0.8" StrokeDashArray="3,3" StrokeDashCap="Round" IsHitTestVisible="False"/>
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Outline" Property="Fill" Value="#26E8C96D"/>
                                                <Setter TargetName="Outline" Property="Stroke" Value="{StaticResource Gold}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Outline" Property="Stroke" Value="{StaticResource Gold}"/>
                                                <Setter TargetName="Outline" Property="StrokeThickness" Value="1.5"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Outline" Property="Fill" Value="#3BE8C96D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid x:Name="HeaderRoomLabel" Margin="6,0">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="HeaderRoomNameText" Text="{Binding HeaderRoomName}"
                                                       VerticalAlignment="Center" ToolTip="{Binding ActiveRoomProfile.Name}"/>
                                            <TextBlock x:Name="HeaderRoomCodeText" Text="{Binding RoomCode}" Margin="5,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            <Path x:Name="HeaderRoomArrow" Data="M 0,0 L 3,3 L 6,0" Stroke="{StaticResource Gold}" StrokeThickness="1"
                                                  StrokeLineJoin="Round" Margin="4,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </StackPanel>
                                    </Viewbox>
                                </Grid>
                            </Button>
                            <Popup x:Name="AssistantRoomPopup" Placement="Custom" PlacementTarget="{Binding ElementName=HeaderRoomButton}"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                   AllowsTransparency="True" StaysOpen="False" Opened="AssistantRoomPopupOpened" Closed="AssistantRoomPopupClosed">
                                <Border Width="330" Margin="12,0,12,15" Padding="14" CornerRadius="12" BorderThickness="1"
                                        BorderBrush="{StaticResource GoldLine}" Effect="{StaticResource CardShadow}"
                                        TextElement.FontFamily="{Binding PlacementTarget.FontFamily, ElementName=AssistantRoomPopup}"
                                        KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="AssistantRoomPopupPreviewKeyDown">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#26234E" Offset="0"/>
                                            <GradientStop Color="#1B1943" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="助手房间" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource GoldText}"
                                                               VerticalAlignment="Center"/>
                                                    <Button x:Name="RoomOrchestrationEntryButton" Content="{Binding RoomOrchestrationEntryText}"
                                                            Padding="9,5" Margin="8,0,4,0" MinHeight="26" Click="RoomOrchestrationEntryClick"
                                                            IsEnabled="{Binding CanChooseRoomView}"
                                                            Visibility="{Binding CanSelectRoomOrchestration, Converter={StaticResource BoolToVis}}"
                                                            AutomationProperties.Name="{Binding RoomOrchestrationEntryText}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                                                                <Setter Property="Foreground" Value="{StaticResource GoldText}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource GoldLine}"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ActiveRoomProfile.Name}">
                                                    <Run Text="最后确认："/>
                                                    <Run Text="{Binding ActiveRoomProfile.Name, Mode=OneWay, FallbackValue=未选择, TargetNullValue=未选择}"/>
                                                    <Run Text="{Binding ActiveRoomProfile.RoomCode, Mode=OneWay, StringFormat=' · {0}', FallbackValue=''}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Padding="8,6" VerticalAlignment="Top"
                                                    Click="CloseAssistantRoomPopupClick" ToolTip="关闭（Esc）" AutomationProperties.Name="关闭房间面板">
                                                <Path Data="M 0,0 L 7,7 M 7,0 L 0,7" Stroke="{StaticResource GoldText}" StrokeThickness="1.2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Button>
                                        </Grid>
                                        <!-- 所有房间汇总查看入口（不改变当前登录房间） -->
                                        <Button x:Name="AllRoomsViewButton" Click="AllRoomsViewClick" Cursor="Hand"
                                                Margin="0,0,0,6" MinHeight="34" HorizontalContentAlignment="Stretch"
                                                IsEnabled="{Binding CanChooseRoomView}"
                                                ToolTip="在耕地机页面汇总查看全部房间成员（其他房间只读）"
                                                AutomationProperties.Name="所有房间">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#2E6E6EB4"/>
                                                    <Setter Property="BorderBrush" Value="#479C97C0"/>
                                                    <Setter Property="Foreground" Value="{StaticResource White}"/>
                                                    <Setter Property="Padding" Value="10,6"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="AllRoomsRow" Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="AllRoomsRow" Property="Background" Value="#428278C2"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=AssistantRoomSelector}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDisplayingAllRoomsView}" Value="True">
                                                            <Setter Property="Background" Value="#294868A8"/>
                                                            <Setter Property="BorderBrush" Value="#8C8FC1E8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="✦" FontSize="11" Foreground="{StaticResource Water}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="所有房间" FontSize="12" Foreground="{StaticResource White}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding AllRoomsCountText}" FontSize="11" Foreground="{StaticResource Dim}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                                        Background="#2E8FC1E8" BorderBrush="#668FC1E8" BorderThickness="1" VerticalAlignment="Center"
                                                        Visibility="{Binding IsDisplayingAllRoomsView, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="查看中" FontSize="10" Foreground="{StaticResource Water}" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <ListBox x:Name="AssistantRoomSelector" ItemsSource="{Binding RoomSwitchChoices}"
                                                 SelectedValuePath="Id" SelectedValue="{Binding ActiveRoomProfile.Id, Mode=OneWay}"
                                                 Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource White}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 MaxHeight="224" IsEnabled="{Binding CanEditConfiguration}" AutomationProperties.Name="选择目标房间">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox">
                                                    <Style.Triggers>
                                                        <Trigger Property="HasItems" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="AssistantRoomItemMouseLeftButtonUp"/>
                                                    <Setter Property="Background" Value="#2E6E6EB4"/>
                                                    <Setter Property="BorderBrush" Value="#479C97C0"/>
                                                    <Setter Property="Foreground" Value="{StaticResource White}"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="10,7"/>
                                                    <Setter Property="Margin" Value="0,0,0,5"/>
                                                    <Setter Property="MinHeight" Value="36"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="RoomRow" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="RoomRow" Property="Background" Value="#428278C2"/>
                                                                    </Trigger>
                                                                    <!-- 当前查看的非登录房间：冷色边框提示查看中，文字保持白色 -->
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding DataContext.IsShowingRoomOrchestration, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"/>
                                                                            <Condition Value="True">
                                                                                <Condition.Binding>
                                                                                    <MultiBinding Converter="{StaticResource StringEqualsMulti}">
                                                                                        <Binding Path="Id"/>
                                                                                        <Binding Path="DataContext.ViewedRoomProfileId" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                                                    </MultiBinding>
                                                                                </Condition.Binding>
                                                                            </Condition>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter TargetName="RoomRow" Property="Background" Value="#294868A8"/>
                                                                        <Setter TargetName="RoomRow" Property="BorderBrush" Value="#8C8FC1E8"/>
                                                                    </MultiDataTrigger>
                                                                    <!-- 选中作为切换目标（非登录房间）：保持白色文字，仅加选中边框 -->
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="RoomRow" Property="Background" Value="#384C64A8"/>
                                                                        <Setter TargetName="RoomRow" Property="BorderBrush" Value="#A68FC1E8"/>
                                                                    </Trigger>
                                                                    <!-- 正在登录的房间始终显示金黄色（后写优先，点其他房间也不丢失金色） -->
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource StringEqualsMulti}">
                                                                                <Binding Path="Id"/>
                                                                                <Binding Path="DataContext.ActiveRoomProfile.Id" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter TargetName="RoomRow" Property="Background" Value="#20E8C96D"/>
                                                                        <Setter TargetName="RoomRow" Property="BorderBrush" Value="{StaticResource GoldLine}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource GoldText}"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                        <Setter TargetName="RoomRow" Property="BorderThickness" Value="1.5"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="RoomRow" Property="Opacity" Value="0.55"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ToolTip="{Binding Name}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path x:Name="ActiveRoomCheckMark" Data="M 0,4 L 3,7 L 8,1" Stroke="{StaticResource Gold}" StrokeThickness="1.5"
                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              Margin="0,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Value="True">
                                                                            <DataTrigger.Binding>
                                                                                <MultiBinding Converter="{StaticResource StringEqualsMulti}">
                                                                                    <Binding Path="Id"/>
                                                                                    <Binding Path="DataContext.ActiveRoomProfile.Id" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                                                </MultiBinding>
                                                                            </DataTrigger.Binding>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                        <Grid Grid.Column="1">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="RoomChoiceName" Text="{Binding Name}" FontSize="12" MaxWidth="110"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="RoomChoiceNote" Grid.Column="1" Text="{Binding Note}" Margin="8,0,0,0" FontSize="11"
                                                                       Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                       ToolTip="{Binding Note}"/>
                                                        </Grid>
                                                        <TextBlock x:Name="RoomChoiceCode" Grid.Column="2" Text="{Binding RoomCode}" Margin="10,0,0,0" FontSize="11"
                                                                   Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="还没有房间档案，可在「管理房间」中添加。" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=AssistantRoomSelector}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding RoomSwitchStatus}" Foreground="{StaticResource GoldText}" TextWrapping="Wrap"
                                                   FontSize="11" Margin="0,5,0,4" AutomationProperties.LiveSetting="Polite">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <WrapPanel>
                                            <WrapPanel.Resources>
                                                <Style x:Key="RoomSwitchRecoveryButton" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                                                    <Setter Property="Margin" Value="0,3,6,3"/>
                                                    <Setter Property="MinHeight" Value="28"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </WrapPanel.Resources>
                                            <Button Content="取消等待" Command="{Binding CancelAssistantRoomSwitchCommand}" Style="{StaticResource RoomSwitchRecoveryButton}"/>
                                            <Button Content="重新检查" Command="{Binding RecheckAssistantRoomSwitchCommand}" Style="{StaticResource RoomSwitchRecoveryButton}"/>
                                            <Button Content="停止本机" Command="{Binding StopLocalDuringAssistantRoomSwitchCommand}" Style="{StaticResource RoomSwitchRecoveryButton}"/>
                                        </WrapPanel>
                                        <Border Height="1" Background="{StaticResource CardEdge}" Margin="0,6,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="复制房间号" Style="{StaticResource BtnGhost}" MinHeight="30" Click="CopyRoomCodeClick"
                                                    ToolTip="复制最后确认的房间号"/>
                                            <Button x:Name="ManageAssistantRoomsButton" Grid.Column="1" Content="管理房间" Style="{StaticResource BtnGhost}"
                                                    HorizontalAlignment="Left" Margin="6,0,0,0" MinHeight="30" IsEnabled="{Binding CanEditConfiguration}"
                                                    Click="ManageAssistantRoomsClick" Command="{Binding OpenAssistantRoomsCommand}"/>
                                            <Button x:Name="ConfirmAssistantRoomSwitchButton" Grid.Column="2" Content="切换房间" MinHeight="30" Command="{Binding SwitchAssistantRoomCommand}"
                                                    CommandParameter="{Binding SelectedItem, ElementName=AssistantRoomSelector}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnGold}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=AssistantRoomSelector}" Value="{x:Null}">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CanEditConfiguration}" Value="False">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.45"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <TextBlock x:Name="RoomCodeCopyHintText" Visibility="Collapsed" FontSize="11" TextWrapping="Wrap"
                                                   Margin="0,6,0,0" Foreground="{StaticResource GoldText}" AutomationProperties.LiveSetting="Polite"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="RoomFollowEntryButton" Content="{Binding RoomFollowEntryText}"
                                                    Click="RoomFollowEntryClick" IsEnabled="{Binding CanOpenRoomFollow}"
                                                    MinHeight="30" Padding="9,5" Style="{StaticResource BtnGhost}"
                                                    ToolTip="执行端共享房间元数据；监控端可用本人已授权的房间凭据跟随。"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RoomFollowStatus}" ToolTip="{Binding RoomFollowStatus}"
                                                       FontSize="10.5" Foreground="{StaticResource Dim}" Margin="8,0,0,0"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <Button x:Name="HeaderRefreshButton" Grid.Column="1" Width="{Binding ActualWidth, ElementName=HeaderExitButton}"
                                    Content="⟳" Style="{StaticResource TextAction}" FontSize="14" Margin="6,0,0,3" VerticalAlignment="Center"
                                    ToolTip="刷新助手所有状态" Command="{Binding RefreshCommand}"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 内容区（成员列表 / 设置页面 / 嘟嘟可，通过 CurrentPage 三态切换） -->
                <Grid Grid.Row="1">
                    <!-- Home 的成员/快捷指令与编排是互斥内容模式，其他页面导航不变。 -->
                    <Grid x:Name="MemberHomeContent">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShowingRoomOrchestration}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:AppPage.Settings}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:AppPage.Dodoco}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:AppPage.Mistletoe}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 多房间只读查看连接提示（正常就绪时自动折叠不占高度） -->
                        <Border x:Name="RoomViewNoticeBanner" Grid.Row="0" Margin="0,0,0,8" Padding="11,6"
                                CornerRadius="8" Background="#243E5F8A" BorderBrush="#668FC1E8" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RoomViewNoticeText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RoomViewNoticeText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding RoomViewNoticeText}" FontSize="11" Foreground="{StaticResource Water}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Border>

                        <!-- 单机或房间尚未返回成员卡时，也能查看已发现的本机更新。 -->
                        <Button x:Name="BgiUpdateWithoutMembersButton" Grid.Row="1" Panel.ZIndex="1" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Margin="12,5,0,0" FontSize="11" Padding="0"
                                Command="{Binding OpenUpdateBgiCommand}" ToolTip="有 BGI 更新可用，点击查看"
                                AutomationProperties.Name="有 BGI 更新可用">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TextAction}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground" Value="#C8C4DD"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Members.Count}" Value="0"/>
                                                <Condition Binding="{Binding RemoteUpdateAvailable}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding InstalledBgiVersion, StringFormat='本机 BGI {0}'}" VerticalAlignment="Center"/>
                                <Ellipse Width="6" Height="6" Margin="5,0,0,0" VerticalAlignment="Center" Fill="{StaticResource Gold}"/>
                            </StackPanel>
                        </Button>

                        <!-- 成员委托卡列表 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource GoldScrollViewer}">
                            <ItemsControl x:Name="DisplayedMembersControl" ItemsSource="{Binding DisplayedMembers}"
                                          IsEnabled="{Binding CanUseAssistantRoomMemberActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource QuestCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 金色左竖条 -->
                                                <Border Grid.Column="0" Background="{StaticResource GoldDeep}" CornerRadius="2" Margin="0,2,12,2"/>
                                                <StackPanel Grid.Column="1">
                                                    <!-- 首行：勾选 + 头像 + 名字/UID + 状态徽章。
                                                         两列 * / Auto：任务胶囊在 Auto 列向左收缩（最长 400 已有省略号），
                                                         左侧独占剩余空间——原先无分栏、胶囊后绘制会盖住 UID/版本号
                                                         （脚本任务三段全上时必现，垂钓长任务名即例） -->
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsActiveRoomMember}">
                                                                <CheckBox.Style>
                                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource GuildCheckBox}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActiveRoomMember}" Value="False">
                                                                                <Setter Property="Opacity" Value="0.35"/>
                                                                                <Setter Property="ToolTip" Value="仅当前登录房间成员支持批量勾选"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </CheckBox.Style>
                                                            </CheckBox>
                                                            <!-- 角色头像（元素色描边，圆角） -->
                                                            <Rectangle Width="38" Height="38" RadiusX="11" RadiusY="11" Margin="0,0,10,0">
                                                                <Rectangle.Fill><ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/></Rectangle.Fill>
                                                                <Rectangle.Stroke><SolidColorBrush Color="{Binding AvatarRing}"/></Rectangle.Stroke>
                                                                <Rectangle.StrokeThickness>1.5</Rectangle.StrokeThickness>
                                                            </Rectangle>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding PlayerName}" FontSize="15" FontWeight="Medium" Foreground="{StaticResource White}" VerticalAlignment="Center"/>
                                                                    <Button Content="⚙" Style="{StaticResource TextAction}" FontSize="12" Padding="2,0" Margin="6,0,0,0"
                                                                            VerticalAlignment="Center" ToolTip="远程编辑该成员的配置组"
                                                                            IsEnabled="{Binding CanRemoteEdit}"
                                                                            Command="{Binding DataContext.RemoteConfigEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <!-- 所有房间视图下：在设置齿轮右侧显示成员登录房间标签 -->
                                                                    <Border x:Name="MemberRoomLabelBadge" CornerRadius="6" Padding="7,1.5" Margin="8,0,0,0"
                                                                            BorderThickness="1" VerticalAlignment="Center"
                                                                            ToolTip="{Binding RoomLabelToolTip}"
                                                                            Visibility="{Binding ShowRoomLabel, Converter={StaticResource BoolToVis}}">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="#24E8C96D"/>
                                                                                <Setter Property="BorderBrush" Value="#66D4AF37"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsReadOnlyView}" Value="True">
                                                                                        <Setter Property="Background" Value="#244E6D9C"/>
                                                                                        <Setter Property="BorderBrush" Value="#668FC1E8"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock x:Name="MemberRoomLabelText" Text="{Binding RoomLabel}" FontSize="10" FontWeight="Medium"
                                                                                   MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{StaticResource GoldText}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsReadOnlyView}" Value="True">
                                                                                            <Setter Property="Foreground" Value="{StaticResource Water}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                                    <TextBlock Text="{Binding DisplayUid, StringFormat='UID {0}'}" FontSize="10" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                                                    <!-- UID 与版本号之间的 · 分隔 -->
                                                                    <TextBlock Text="·" FontSize="10" Foreground="{StaticResource Dim}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                                    <!-- BGI 版本号：与 UID 同字号同色的纯文本（无框），未上报显示 "-"。
                                                                         登录房间自机=可点打开"更新BGI"；他人或只读视图=纯文本不可点 -->
                                                                    <TextBlock Text="{Binding BgiVersionDisplay}" FontSize="10" Foreground="#C8C4DD"
                                                                               Margin="4,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding CanUpdateLocalBgi}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <Button FontSize="10" Padding="0" Margin="4,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            AutomationProperties.Name="更新本机 BGI"
                                                                            Command="{Binding DataContext.OpenUpdateBgiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource TextAction}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Setter Property="Foreground" Value="#C8C4DD"/>
                                                                                <Setter Property="ToolTip" Value="点击更新本机 BGI"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding CanUpdateLocalBgi}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding DataContext.RemoteUpdateAvailable, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                                        <Setter Property="ToolTip" Value="有 BGI 更新可用，点击查看"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding BgiVersionDisplay}" VerticalAlignment="Center"/>
                                                                            <Ellipse x:Name="BgiUpdateDot" Width="6" Height="6" Margin="5,0,0,0"
                                                                                     VerticalAlignment="Center" Fill="{StaticResource Gold}"
                                                                                     Visibility="{Binding DataContext.RemoteUpdateAvailable, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <!-- 右侧：状态徽章 -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Border CornerRadius="7" Padding="8,2" Margin="0,0,8,0" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#1FE88A6F"/>
                                                                    <Setter Property="BorderBrush" Value="#66E88A6F"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Online}" Value="True">
                                                                            <Setter Property="Background" Value="#24A8A29A"/>
                                                                            <Setter Property="BorderBrush" Value="#40A8A29A"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BgiStatus}" Value="stopped">
                                                                            <Setter Property="Background" Value="#24D9A84E"/>
                                                                            <Setter Property="BorderBrush" Value="#40D9A84E"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BgiStatus}" Value="observer">
                                                                            <Setter Property="Background" Value="#295B8DEF"/>
                                                                            <Setter Property="BorderBrush" Value="#735B8DEF"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding TaskRunning}" Value="True">
                                                                            <Setter Property="Background" Value="#29C9A0E8"/>
                                                                            <Setter Property="BorderBrush" Value="#73C9A0E8"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10" FontWeight="Medium" VerticalAlignment="Center"
                                                                       MaxWidth="400" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="离线"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Pyro}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Online}" Value="True">
                                                                                <Setter Property="Text" Value="BGI已启动: 空闲"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource Orange}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding BgiStatus}" Value="stopped">
                                                                                <Setter Property="Text" Value="BGI 未运行"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource Geo}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding BgiStatus}" Value="observer">
                                                                                <Setter Property="Text" Value="遥控器"/>
                                                                                <Setter Property="Foreground" Value="#5B8DEF"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding TaskRunning}" Value="True">
                                                                                <Setter Property="Text" Value="{Binding TaskDisplayText}"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource Electro}"/>
                                                                            </DataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Online}" Value="True"/>
                                                                                    <Condition Binding="{Binding BgiStatus}" Value="running"/>
                                                                                    <Condition Binding="{Binding TaskRunning}" Value="False"/>
                                                                                    <Condition Binding="{Binding TaskStatusAvailable}" Value="False"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Text" Value="BGI任务状态待确认"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource Orange}"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            </Border>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- 操作栏（文字按钮，融入卡片） -->
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                                <Button Content="🔗 锄地" Style="{StaticResource TextAction}"
                                                                        Command="{Binding DataContext.BindHoeingGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" Margin="0,0,2,0" FontSize="11">
                                                                    <Button.ToolTip>
                                                                        <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" MaxWidth="460">
                                                                            <StackPanel>
                                                                                <TextBlock Text="绑定联机锄地配置组（所有人可编辑）" TextWrapping="Wrap"/>
                                                                                <TextBlock Text="{Binding HoeingCompletionAction.Description, StringFormat='完成后：{0}', FallbackValue='完成后动作尚未确认', TargetNullValue='完成后动作尚未确认'}"
                                                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                            </StackPanel>
                                                                        </ToolTip>
                                                                    </Button.ToolTip>
                                                                </Button>
                                                                <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0"/>
                                                                <Button Content="配置组" Style="{StaticResource TextAction}" Command="{Binding DataContext.StartGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0"/>
                                                                <Button Content="一条龙" Style="{StaticResource TextAction}" Command="{Binding DataContext.StartOneClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0"/>
                                                                <Button Content="快捷键" Style="{StaticResource TextAction}" Command="{Binding DataContext.ExecuteHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0"/>
                                                                <Button Content="关闭游戏" Style="{StaticResource TextAction}" Command="{Binding DataContext.CloseGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0"/>
                                                                <Button Content="停止" Style="{StaticResource TextAction}" Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0"/>
                                                                <Button Content="启动BGI" Style="{StaticResource TextAction}" Foreground="{StaticResource Gold}" FontSize="12" ToolTip="点自己=启动本机 BGI；点别人或其他房间成员=远程下发启动 BGI" Command="{Binding DataContext.StartBgiCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                            <!-- 右列：记录按钮 + 定时上线 + 上线状态（与五个按键同一行，放右侧） -->
                                                            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                                                                <Border CornerRadius="7" Padding="8,2" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                        Background="#1F9C97C0" BorderBrush="#4D9C97C0">
                                                                    <Button Content="记录" Style="{StaticResource TextAction}"
                                                                            Command="{Binding DataContext.ShowOnlineHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Padding="0" FontSize="10" FontWeight="Medium"/>
                                                                </Border>
                                                                <Border CornerRadius="7" Padding="8,2" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                        Background="#1F9C97C0" BorderBrush="#4D9C97C0">
                                                                    <Button Style="{StaticResource TextAction}"
                                                                            Command="{Binding DataContext.ScheduledOnlineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Padding="0" FontSize="10" FontWeight="Medium">
                                                                        <Button.Content>
                                                                            <!-- 显示该成员自己的定时上线时间（per-member），空/未设置时显示"定时上线" -->
                                                                            <TextBlock FontSize="10" FontWeight="Medium">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="{Binding ScheduledOnlineTime, StringFormat='定时 {0}'}"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ScheduledOnlineTime}" Value="">
                                                                                                <Setter Property="Text" Value="定时上线"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding ScheduledOnlineTime}" Value="{x:Null}">
                                                                                                <Setter Property="Text" Value="定时上线"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Button.Content>
                                                                    </Button>
                                                                </Border>
                                                                <!-- 清除上线：复位因定时/命令触发的已上线状态（不清除定时闹钟） -->
                                                                <Border CornerRadius="7" Padding="8,2" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                        Background="#1F8E6E6E" BorderBrush="#4DD46E6E">
                                                                    <Button Content="清除上线"
                                                                            Style="{StaticResource TextAction}"
                                                                            Command="{Binding DataContext.ClearOnlineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Padding="0" FontSize="10" FontWeight="Medium"/>
                                                                </Border>
                                                                <!-- 重置状态：终止当前联机批次并清理本地接管票据/执行纪元 -->
                                                                <Border CornerRadius="7" Padding="8,2" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                        Background="#1F9C7A3C" BorderBrush="#4DD9A84E">
                                                                    <Button Content="重置状态"
                                                                            Style="{StaticResource TextAction}"
                                                                            Command="{Binding DataContext.ResetStateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Padding="0" FontSize="10" FontWeight="Medium"/>
                                                                </Border>
                                                                <Border CornerRadius="7" Padding="8,2" BorderThickness="1" VerticalAlignment="Center"
                                                                        Margin="0,0,8,0" Background="#1F9C97C0" BorderBrush="#4D9C97C0">
                                                                    <TextBlock FontSize="10" FontWeight="Medium" VerticalAlignment="Center" LineHeight="14">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="未上线"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource Pyro}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding OnlineReady}" Value="True">
                                                                                        <Setter Property="Text" Value="已上线"/>
                                                                                        <Setter Property="Foreground" Value="{StaticResource Anemo}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding HasOnlineToday}" Value="True">
                                                                                        <Setter Property="Text" Value="已联机"/>
                                                                                        <Setter Property="Foreground" Value="{StaticResource Dim}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                                <!-- [冷却倒计时] 命令上线 60s 防抖拦截提示：仅本机卡片且文本非空时显示，
                                                                     文本来自主 VM（防抖是本机行为，其他成员恒为空串隐藏） -->
                                                                <TextBlock FontSize="9" Foreground="{StaticResource Gold}" VerticalAlignment="Center"
                                                                           Margin="0,0,8,0"
                                                                           Text="{Binding DataContext.OnlineDebounceCountdownText, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelf}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding DataContext.OnlineDebounceCountdownText, RelativeSource={RelativeSource AncestorType=Window}}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding DataContext.OnlineDebounceCountdownText, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- 复用原状态行；说明浮层不占布局高度，窄屏优先保留信息图标。 -->
                                                        <DockPanel x:Name="HoeingStatusLine" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                            <DockPanel.Style>
                                                                <Style TargetType="DockPanel">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HoeingStartMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HoeingStartMessage}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </DockPanel.Style>
                                                            <Button x:Name="CompletionActionHintButton" DockPanel.Dock="Right" Content="ⓘ"
                                                                    Width="16" Height="{Binding ActualHeight, ElementName=HoeingStatusText}"
                                                                    Margin="5,0,0,0" Padding="0" VerticalAlignment="Center"
                                                                    FontFamily="Segoe UI Symbol" FontSize="12" Foreground="{StaticResource GoldText}" Opacity="0.7"
                                                                    Visibility="{Binding IsPostHoeingTaskRunning, Converter={StaticResource BoolToVis}}"
                                                                    AutomationProperties.Name="联机锄地后续任务说明"
                                                                    ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="15000"
                                                                    Tag="{Binding ElementName=CompletionActionHelpPopup}"
                                                                    Style="{StaticResource TextAction}" Click="CompletionActionHintClick"
                                                                    IsVisibleChanged="CompletionActionHintVisibilityChanged">
                                                                <Button.ToolTip>
                                                                    <ToolTip Placement="Bottom" VerticalOffset="4"
                                                                             Background="{StaticResource Card}" BorderBrush="{StaticResource GoldDeep}"
                                                                             Foreground="{StaticResource GoldText}" Padding="10,7" MaxWidth="300">
                                                                        <TextBlock Text="{x:Static vm:MemberViewModel.PostHoeingHelp}" FontSize="12" TextWrapping="Wrap"/>
                                                                    </ToolTip>
                                                                </Button.ToolTip>
                                                            </Button>
                                                            <Popup x:Name="CompletionActionHelpPopup" Placement="Bottom" VerticalOffset="4"
                                                                   PlacementTarget="{Binding ElementName=CompletionActionHintButton}"
                                                                   StaysOpen="False" AllowsTransparency="True">
                                                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource GoldDeep}"
                                                                        BorderThickness="1" CornerRadius="5" Padding="10,7" MaxWidth="300">
                                                                    <TextBlock Text="{x:Static vm:MemberViewModel.PostHoeingHelp}" FontSize="12"
                                                                               Foreground="{StaticResource GoldText}" TextWrapping="Wrap"/>
                                                                </Border>
                                                            </Popup>
                                                            <TextBlock x:Name="HoeingStatusText" Text="{Binding HoeingStartMessage}" FontSize="12"
                                                                       ToolTip="{Binding HoeingStartMessage}" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource Geo}"/>
                                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsPostHoeingTaskRunning}" Value="True"><Setter Property="TextWrapping" Value="NoWrap"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsPostHoeingWaitReleased}" Value="True">
                                                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource Dim}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding HoeingStartPhase}" Value="failed"><Setter Property="Foreground" Value="{StaticResource Pyro}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding HoeingStartPhase}" Value="unknown"><Setter Property="Foreground" Value="{StaticResource Pyro}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding HoeingStartPhase}" Value="cleanupPending"><Setter Property="Foreground" Value="{StaticResource Pyro}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsPostHoeingTaskOffline}" Value="True">
                                                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource Dim}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DockPanel>
                                                        <TextBlock FontSize="10" Margin="0,3,0,0" MaxWidth="520" TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding RemoteStartResult}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Dim}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding RemoteStartResult}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RemoteStartResult}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RemoteStartResultState}" Value="success">
                                                                            <Setter Property="Foreground" Value="{StaticResource Anemo}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RemoteStartResultState}" Value="failed">
                                                                            <Setter Property="Foreground" Value="{StaticResource Pyro}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding RemoteStartResultState}" Value="noreceipt">
                                                                            <Setter Property="Foreground" Value="{StaticResource Geo}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- 快捷指令 -->
                            <Border Grid.Row="2" Style="{StaticResource QuestCard}" Padding="14,11">
                                <StackPanel>
                                    <Grid Margin="0,0,0,9">
                                        <TextBlock Text="快捷指令" Style="{StaticResource SectionTitle}"/>
                                        <Border Height="1" Background="#40D4AF37" VerticalAlignment="Center" Margin="64,0,0,0"/>
                                    </Grid>
                                    <Grid x:Name="QuickCommandsGrid" IsEnabled="{Binding CanOperateDisplayedRoom}">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanOperateDisplayedRoom}" Value="False">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                        <Setter Property="ToolTip" Value="正在查看其他房间，底部批量快捷指令仅作用于当前登录房间；单张成员卡片可直接远控"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="一键锄地" Style="{StaticResource BtnGhost}" Command="{Binding QuickHoeingCommand}" Padding="8,5" Margin="0,0,4,0"/>
                                        <Button Grid.Column="1" Content="传奇" Style="{StaticResource BtnGhost}" Command="{Binding QuickLegendCommand}" Padding="8,5" Margin="4,0"/>
                                        <Button Grid.Column="2" Content="次数盾" Style="{StaticResource BtnGhost}" Command="{Binding QuickShieldCommand}" Padding="8,5" Margin="4,0"/>
                                        <Button Grid.Column="3" Content="精英" Style="{StaticResource BtnGhost}" Command="{Binding QuickEliteCommand}" Padding="8,5" Margin="4,0"/>
                                        <Button Grid.Column="4" Content="小怪" Style="{StaticResource BtnGhost}" Command="{Binding QuickMultiCommand}" Padding="8,5" Margin="4,0"/>
                                        <Button Grid.Column="5" Content="自定义" Style="{StaticResource BtnGhost}" Command="{Binding QuickCustomCommand}" Padding="8,5" Margin="4,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 编排是 Home 的内容分支，不是新的主导航页。 -->
                        <views:RoomOrchestrationPage x:Name="RoomOrchestrationHomeContent">
                            <views:RoomOrchestrationPage.Style>
                                <Style TargetType="views:RoomOrchestrationPage">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding CurrentPage}" Value="{x:Static vm:AppPage.Home}"/>
                                                <Condition Binding="{Binding IsShowingRoomOrchestration}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:RoomOrchestrationPage.Style>
                        </views:RoomOrchestrationPage>

                        <!-- 设置页面（CurrentPage==Settings 时显示） -->
                        <views:SettingsPage IsEnabled="{Binding DataContext.CanEditConfiguration, RelativeSource={RelativeSource AncestorType=Window}}">
                            <views:SettingsPage.Style>
                                <Style TargetType="views:SettingsPage">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:AppPage.Settings}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:SettingsPage.Style>
                        </views:SettingsPage>

                        <!-- 嘟嘟可页面（CurrentPage==Dodoco 时显示；DataContext 用 MainWindow 持有的 DodocoViewModel。
                             注意：本元素的 Style 触发器解析于自身 DataContext（已被改为 DodocoViewModel），
                             所以 CurrentPage 必须显式从 Window 的 DataContext 取） -->
                        <views:DodocoPage DataContext="{Binding Dodoco, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanEditConfiguration, RelativeSource={RelativeSource AncestorType=Window}}">
                            <views:DodocoPage.Style>
                                <Style TargetType="views:DodocoPage">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:AppPage.Dodoco}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:DodocoPage.Style>
                        </views:DodocoPage>

                        <!-- 槲寄生页面（CurrentPage==Mistletoe 时显示；DataContext 用 MainWindow 持有的 MistletoeViewModel，
                             CurrentPage 同样必须显式从 Window 的 DataContext 取，原因同上方 DodocoPage 注释） -->
                        <views:MistletoePage DataContext="{Binding ActiveMistletoe, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanEditConfiguration, RelativeSource={RelativeSource AncestorType=Window}}">
                            <views:MistletoePage.Style>
                                <Style TargetType="views:MistletoePage">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:AppPage.Mistletoe}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:MistletoePage.Style>
                        </views:MistletoePage>
                    </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
