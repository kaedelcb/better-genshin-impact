<Window x:Class="MultiplayerHoeingAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MultiplayerHoeingAssistant.Views"
        Title="Nexus BGI"
        Width="980" Height="860"
        MinWidth="860" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC, Segoe UI, Microsoft YaHei"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#141534" Offset="0"/>
            <GradientStop Color="#221F4E" Offset="0.55"/>
            <GradientStop Color="#1B1943" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- ========== 原神夜空色板 ========== -->
        <SolidColorBrush x:Key="Card" Color="#CC26234E"/>
        <SolidColorBrush x:Key="CardEdge" Color="#47D4AF37"/>
        <SolidColorBrush x:Key="Gold" Color="#E8C96D"/>
        <SolidColorBrush x:Key="GoldDeep" Color="#C9A53F"/>
        <SolidColorBrush x:Key="GoldText" Color="#F2E3B6"/>
        <SolidColorBrush x:Key="GoldLine" Color="#80D4AF37"/>
        <SolidColorBrush x:Key="White" Color="#F4F2FA"/>
        <SolidColorBrush x:Key="Dim" Color="#9C97C0"/>
        <SolidColorBrush x:Key="Water" Color="#8FC1E8"/>
        <SolidColorBrush x:Key="Electro" Color="#C9A0E8"/>
        <SolidColorBrush x:Key="Anemo" Color="#6FD8CE"/>
        <SolidColorBrush x:Key="Pyro" Color="#E88A6F"/>
        <SolidColorBrush x:Key="Geo" Color="#D9A84E"/>
        <SolidColorBrush x:Key="Orange" Color="#E8A84E"/>

        <!-- 鎏金按钮渐变 -->
        <LinearGradientBrush x:Key="GoldBtnGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EFD68A" Offset="0"/>
            <GradientStop Color="#D4AF37" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldBtnGradHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F6E0A0" Offset="0"/>
            <GradientStop Color="#E0BC45" Offset="1"/>
        </LinearGradientBrush>

        <!-- 卡片阴影 -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#0A081E"/>

        <!-- 委托卡（金色左竖条由内部 Grid 实现） -->
        <Style x:Key="QuestCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Padding" Value="13,11,16,11"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- 区块小标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
        </Style>

        <!-- ========== 按钮体系 ========== -->
        <!-- 鎏金主按钮 -->
        <Style x:Key="BtnGold" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GoldBtnGrad}"/>
            <Setter Property="Foreground" Value="#3A2F16"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.3" Color="#D4AF37"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldBtnGradHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深紫幽灵按钮 -->
        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Background" Value="#2E6E6EB4"/>
            <Setter Property="Foreground" Value="#C9C4E6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#479C97C0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#428278C2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 火红描边危险按钮 -->
        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Pyro}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#66E88A6F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FE88A6F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文字操作按钮（像卡片上的文字，可点击） -->
        <Style x:Key="TextAction" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource White}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cp" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GuildCheckBox" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="20" Height="20">
                            <Border x:Name="Outer" CornerRadius="10" BorderThickness="1.5" BorderBrush="{StaticResource Dim}" Background="#332E2660" SnapsToDevicePixels="True"/>
                            <Border x:Name="Inner" CornerRadius="10" Background="{StaticResource GoldBtnGrad}" Opacity="0" SnapsToDevicePixels="True">
                                <Path Data="M 4,10.5 L 8.5,14.5 L 16,6.5" Stroke="#3A2F16" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource Gold}"/>
                                <Setter TargetName="Inner" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 元素胶囊 ========== -->
        <Style x:Key="TagPillBase" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagGroupPill" TargetType="Button" BasedOn="{StaticResource TagPillBase}">
            <Setter Property="Background" Value="#613E5F8A"/>
            <Setter Property="Foreground" Value="{StaticResource Water}"/>
            <Setter Property="BorderBrush" Value="#668FC1E8"/>
        </Style>

        <Style x:Key="TagOneClickPill" TargetType="Button" BasedOn="{StaticResource TagPillBase}">
            <Setter Property="Background" Value="#6B5B3A85"/>
            <Setter Property="Foreground" Value="{StaticResource Electro}"/>
            <Setter Property="BorderBrush" Value="#66C9A0E8"/>
        </Style>

        <Style x:Key="TagMorePill" TargetType="Button" BasedOn="{StaticResource TagPillBase}">
            <Setter Property="Background" Value="#299C97C0"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="BorderBrush" Value="#4D9C97C0"/>
        </Style>

        <!-- ========== 背景装饰画刷 ========== -->
        <!-- 星点平铺 -->
        <DrawingBrush x:Key="StarField" TileMode="Tile" Viewport="0,0,140,140" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#80FFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="18,22" RadiusX="1.1" RadiusY="1.1"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#59FFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="66,58" RadiusX="0.9" RadiusY="0.9"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#73FFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="112,34" RadiusX="1.2" RadiusY="1.2"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#4DFFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="44,96" RadiusX="0.9" RadiusY="0.9"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#66FFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="120,112" RadiusX="1" RadiusY="1"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#40FFFFFF"><GeometryDrawing.Geometry><EllipseGeometry Center="88,20" RadiusX="0.8" RadiusY="0.8"/></GeometryDrawing.Geometry></GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- 菱形暗纹 -->
        <DrawingBrush x:Key="DiamondPattern" TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#07E8C96D">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 32,8 L 56,32 L 32,56 L 8,32 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- 星河光带 -->
        <RadialGradientBrush x:Key="GalaxyBand" Center="0.5,0.32" RadiusX="0.52" RadiusY="0.42">
            <GradientStop Color="#26AA8CF0" Offset="0"/>
            <GradientStop Color="#0FE8C96D" Offset="0.45"/>
            <GradientStop Color="#00E8C96D" Offset="0.75"/>
        </RadialGradientBrush>

        <!-- ========== 自定义滚动条（原神鎏金细窄款） ========== -->
        <!-- GoldScrollViewer 样式移到下方（保证 GoldVScrollBar/GoldHScrollBar 先定义，StaticResource 才能前向解析） -->

        <!-- 竖直滚动条 -->
        <Style x:Key="GoldVScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Width="{TemplateBinding Width}">
                                <Track.Thumb>
                                    <Thumb HorizontalAlignment="Stretch">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        CornerRadius="3"
                                                        Background="#50D4AF37"
                                                        BorderThickness="0"
                                                        HorizontalAlignment="Stretch"
                                                        SnapsToDevicePixels="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.3" Color="#D4AF37"/>
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#B0D4AF37"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#E0D4AF37"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 水平滚动条 -->
        <Style x:Key="GoldHScrollBar" TargetType="ScrollBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" Orientation="Horizontal" Height="{TemplateBinding Height}">
                                <Track.Thumb>
                                    <Thumb VerticalAlignment="Stretch">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        CornerRadius="3"
                                                        Background="#50D4AF37"
                                                        BorderThickness="0"
                                                        VerticalAlignment="Stretch"
                                                        SnapsToDevicePixels="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.3" Color="#D4AF37"/>
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#B0D4AF37"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#E0D4AF37"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollViewer 模板（需在 V/H ScrollBar 之后定义，StaticResource 前向引用） -->
        <Style x:Key="GoldScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Row="0" Grid.Column="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0" Grid.Column="1"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Style="{StaticResource GoldVScrollBar}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1" Grid.Column="0"
                                       Orientation="Horizontal"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Style="{StaticResource GoldHScrollBar}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ========== 根布局 ========== -->
    <Grid>
        <!-- ===== 背景装饰层（不响应交互） ===== -->
        <Grid IsHitTestVisible="False">
            <!-- 星河光带（斜向柔光） -->
            <Rectangle Fill="{StaticResource GalaxyBand}" Margin="-160,-260,-160,320">
                <Rectangle.RenderTransform><RotateTransform Angle="-13" CenterX="0.5" CenterY="0.5"/></Rectangle.RenderTransform>
                <Rectangle.Effect><BlurEffect Radius="38"/></Rectangle.Effect>
            </Rectangle>
            <!-- 菱形暗纹 -->
            <Rectangle Fill="{StaticResource DiamondPattern}"/>
            <!-- 星点 -->
            <Rectangle Fill="{StaticResource StarField}"/>
            <!-- 辉光 -->
            <Ellipse Width="480" Height="300" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-140,0,0">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#2EA078E8" Offset="0"/><GradientStop Color="#00A078E8" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="60"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="480" Height="380" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,-160">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#1FE8C96D" Offset="0"/><GradientStop Color="#00E8C96D" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="60"/></Ellipse.Effect>
            </Ellipse>
            <!-- 命之座星座（右上） -->
            <Canvas Width="180" Height="150" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,90,40,0" Opacity="0.5">
                <Polyline Points="18,120 58,84 98,96 138,52 162,20" Stroke="#8CE8C96D" StrokeThickness="0.8"/>
                <Ellipse Canvas.Left="16" Canvas.Top="118" Width="4" Height="4" Fill="{StaticResource Gold}"/>
                <Ellipse Canvas.Left="56" Canvas.Top="82" Width="3.4" Height="3.4" Fill="{StaticResource Gold}"/>
                <Ellipse Canvas.Left="96" Canvas.Top="94" Width="4" Height="4" Fill="{StaticResource Gold}"/>
                <Ellipse Canvas.Left="136" Canvas.Top="50" Width="3.4" Height="3.4" Fill="{StaticResource Gold}"/>
                <Ellipse Canvas.Left="160" Canvas.Top="18" Width="4" Height="4" Fill="{StaticResource Gold}"/>
            </Canvas>
            <!-- 命之座星座（左下） -->
            <Canvas Width="150" Height="120" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="270,0,0,120" Opacity="0.4">
                <Polyline Points="15,95 50,60 85,72 118,32 140,10" Stroke="#80C9A0E8" StrokeThickness="0.8"/>
                <Ellipse Canvas.Left="13" Canvas.Top="93" Width="3.6" Height="3.6" Fill="{StaticResource Electro}"/>
                <Ellipse Canvas.Left="48" Canvas.Top="58" Width="3" Height="3" Fill="{StaticResource Electro}"/>
                <Ellipse Canvas.Left="83" Canvas.Top="70" Width="3.6" Height="3.6" Fill="{StaticResource Electro}"/>
                <Ellipse Canvas.Left="116" Canvas.Top="30" Width="3" Height="3" Fill="{StaticResource Electro}"/>
                <Ellipse Canvas.Left="138" Canvas.Top="8" Width="3.6" Height="3.6" Fill="{StaticResource Electro}"/>
            </Canvas>
            <!-- 派蒙装饰（右下漂浮） -->
            <Image Source="pack://application:,,,/Assets/Images/paimon.png" Width="210"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,-14"
                   Opacity="0.16" Stretch="Uniform">
                <Image.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.28" Color="#E8C96D"/></Image.Effect>
            </Image>
        </Grid>

        <!-- ===== 内容层：左右分栏 ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 左侧冒险家协会装饰栏 ========== -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{StaticResource GoldLine}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#EB181638" Offset="0"/>
                        <GradientStop Color="#F012112E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 四角金饰 -->
                    <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" BorderThickness="2,2,0,0" BorderBrush="{StaticResource GoldLine}"/>
                    <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" BorderThickness="0,2,2,0" BorderBrush="{StaticResource GoldLine}"/>
                    <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" BorderThickness="2,0,0,2" BorderBrush="{StaticResource GoldLine}"/>
                    <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" BorderThickness="0,0,2,2" BorderBrush="{StaticResource GoldLine}"/>

                    <!-- 顶部：派蒙 + 品牌 -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0,34,0,0">
                        <!-- 品牌 Logo -->
                        <Image Source="pack://application:,,,/Assets/Images/logo.png" Width="140" Margin="0,6,0,14" Stretch="Uniform">
                            <Image.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35" Color="#E8C96D"/></Image.Effect>
                        </Image>
                        <TextBlock Text="联机锄地" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource GoldText}" HorizontalAlignment="Center">
                            <TextBlock.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="#E8C96D"/></TextBlock.Effect>
                        </TextBlock>
                        <!-- 菱形分隔符 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,12">
                            <Border Width="34" Height="1" Background="{StaticResource GoldLine}" VerticalAlignment="Center"/>
                            <TextBlock Text="◆ ◈ ◆" FontSize="11" Foreground="{StaticResource Gold}" Margin="8,0" VerticalAlignment="Center"/>
                            <Border Width="34" Height="1" Background="{StaticResource GoldLine}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Nexus-BGI" FontSize="12" Foreground="{StaticResource Gold}" HorizontalAlignment="Center"
                                   FontFamily="Times New Roman" FontStyle="Italic"/>
                        <TextBlock Text="向着狗粮与摩拉" FontSize="13" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- 中部：冒险日志（占派蒙下方空白区） -->
                    <Grid Grid.Row="1" Margin="16,18,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,7">
                            <TextBlock Text="冒险日志" FontSize="12" FontWeight="Medium" Foreground="{StaticResource GoldText}"/>
                            <Button Content="⊖" Style="{StaticResource TextAction}" FontSize="13"
                                    VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,0"
                                    ToolTip="清空冒险日志" Command="{Binding ClearLogCommand}"/>
                            <Border Height="1" Background="#40D4AF37" VerticalAlignment="Center" Margin="56,0,15,0"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource GoldScrollViewer}">
                            <TextBox Text="{Binding CommandLogsText, Mode=OneWay}" FontSize="10.5" Foreground="{StaticResource Dim}"
                                     TextWrapping="Wrap" Margin="-2,1"
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     IsTabStop="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- 底部：GUILD 铭文 -->
                    <StackPanel Grid.Row="2" Margin="0,14,0,22" HorizontalAlignment="Center">
                        <TextBlock Text="✦ ✧ ✦" FontSize="12" Foreground="{StaticResource GoldLine}" HorizontalAlignment="Center"/>
                        <TextBlock Text="TEYVAT CO-OP · GUILD" FontSize="10" Foreground="#6E6A92" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== 右侧主区 ========== -->
            <Grid Grid.Column="1" Margin="24,18,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶栏 -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 左侧 Grid（两行 + 两列，副标题与导航按钮同行） -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Row 0 Col 0：主标题 + 连接状态 + 房间号 + 刷新按钮（同行） -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="冒险家协会 · 提瓦特生物灭绝计划" FontSize="17"  FontWeight="Medium" Foreground="{StaticResource GoldText}" VerticalAlignment="Center"/>
                            <!-- 连接徽章（点击切换执行/监控模式） -->
                            <Button VerticalAlignment="Center" Cursor="Hand" Margin="8,0,0,0"
                                    ToolTip="点击切换执行/监控模式"
                                    Command="{Binding SwitchModeCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </ControlTemplate>
                                </Button.Template>
                                <Border CornerRadius="7" Padding="9,3" VerticalAlignment="Center" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1FE88A6F"/>
                                        <Setter Property="BorderBrush" Value="#66E88A6F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Background" Value="#1F6FD8CE"/>
                                                <Setter Property="BorderBrush" Value="#666FD8CE"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsConnected}" Value="True"/>
                                                    <Condition Binding="{Binding IsObserverMode}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#1F5B8DEF"/>
                                                <Setter Property="BorderBrush" Value="#665B8DEF"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Pyro}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource Anemo}"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsConnected}" Value="True"/>
                                                        <Condition Binding="{Binding IsObserverMode}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Fill" Value="#5B8DEF"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="10" FontWeight="Medium" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="离线"/>
                                                <Setter Property="Foreground" Value="{StaticResource Pyro}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Text" Value="在线"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Anemo}"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsConnected}" Value="True"/>
                                                        <Condition Binding="{Binding IsObserverMode}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="监控"/>
                                                    <Setter Property="Foreground" Value="#5B8DEF"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                </Border>
                            </Button>
                        </StackPanel>
                        <!-- Row 0 Col 1：设置 + 退出 -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="⚙ 设置" Style="{StaticResource BtnGold}" Margin="0,0,0,0" Command="{Binding OpenSettingsCommand}"/>
                            <Button Content="✕" Style="{StaticResource TextAction}" FontSize="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                    ToolTip="完全退出 Nexus-BGI 联机助手" Command="{Binding ExitCommand}"/>
                        </StackPanel>
                        <!-- Row 1 Col 0：副标题 + 导航按钮（同行，与Row 0的标题+信息结构一致） -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                            <TextBlock Text="Teyvat Biological Extinction Plan" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text=" -->" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,0,0,0" VerticalAlignment="Center"/>
							<Button Content="耕地机" FontSize="12" Margin="3,0,0,0" VerticalAlignment="Center"
                                    ToolTip="联机锄地调度控制" Command="{Binding CloseSettingsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TextAction}">
                                        <Setter Property="Foreground" Value="{StaticResource GoldText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShowingSettings}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource White}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0" VerticalAlignment="Center"/>
                            <Button Content="嘟嘟可" Foreground="{StaticResource GoldText}" Style="{StaticResource TextAction}" FontSize="12" Margin="0,0,0,0" VerticalAlignment="Center"
                                    ToolTip="日志与监控系统" Command="{Binding FeaturePlaceholderCommand}" CommandParameter="dodoco"/>
                            <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0" VerticalAlignment="Center"/>
                            <Button Content="槲寄生" Foreground="{StaticResource GoldText}" Style="{StaticResource TextAction}" FontSize="12" Margin="0,0,0,0" VerticalAlignment="Center"
                                    ToolTip="任务调度器" Command="{Binding FeaturePlaceholderCommand}" CommandParameter="sleeper"/>
                        </StackPanel>
                        <!-- Row 1 Col 1：房间号 + 刷新按钮（在设置+退出正下方） -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,3,0,0">
                            <TextBlock Text="{Binding RoomCode, StringFormat='房间 {0}'}" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,2,0" VerticalAlignment="Center"/>
                            <Button Content="⟳" Style="{StaticResource TextAction}" FontSize="14" Margin="0,0,0,3" VerticalAlignment="Center"
                                    ToolTip="刷新助手所有状态" Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 内容区（成员列表 / 设置页面，通过 IsShowingSettings 切换） -->
                <Grid Grid.Row="1">
                    <!-- 成员列表主页（默认显示） -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShowingSettings}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 成员委托卡列表 -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Style="{StaticResource GoldScrollViewer}">
                            <ItemsControl ItemsSource="{Binding Members}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource QuestCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 金色左竖条 -->
                                                <Border Grid.Column="0" Background="{StaticResource GoldDeep}" CornerRadius="2" Margin="0,2,12,2"/>
                                                <StackPanel Grid.Column="1">
                                                    <!-- 首行：勾选 + 头像 + 名字/UID + 状态徽章 -->
                                                    <Grid Margin="0,0,0,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <CheckBox IsChecked="{Binding IsSelected}" Style="{StaticResource GuildCheckBox}"/>
                                                            <!-- 角色头像（元素色描边，圆角） -->
                                                            <Rectangle Width="38" Height="38" RadiusX="11" RadiusY="11" Margin="0,0,10,0">
                                                                <Rectangle.Fill><ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/></Rectangle.Fill>
                                                                <Rectangle.Stroke><SolidColorBrush Color="{Binding AvatarRing}"/></Rectangle.Stroke>
                                                                <Rectangle.StrokeThickness>1.5</Rectangle.StrokeThickness>
                                                            </Rectangle>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding PlayerName}" FontSize="15" FontWeight="Medium" Foreground="{StaticResource White}" VerticalAlignment="Center"/>
                                                                    <Button Content="⚙" Style="{StaticResource TextAction}" FontSize="12" Padding="2,0" Margin="6,0,0,0"
                                                                            VerticalAlignment="Center" ToolTip="远程编辑该成员的配置组"
                                                                            IsEnabled="{Binding CanRemoteEdit}"
                                                                            Command="{Binding DataContext.RemoteConfigEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding DisplayUid, StringFormat='UID {0}'}" FontSize="10" Foreground="{StaticResource Dim}" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <!-- 右侧：状态徽章 -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Border CornerRadius="7" Padding="8,2" Margin="0,0,8,0" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#1FE88A6F"/>
                                                                    <Setter Property="BorderBrush" Value="#66E88A6F"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Online}" Value="True">
                                                                            <Setter Property="Background" Value="#24A8A29A"/>
                                                                            <Setter Property="BorderBrush" Value="#40A8A29A"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BgiStatus}" Value="stopped">
                                                                            <Setter Property="Background" Value="#24D9A84E"/>
                                                                            <Setter Property="BorderBrush" Value="#40D9A84E"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BgiStatus}" Value="observer">
                                                                            <Setter Property="Background" Value="#295B8DEF"/>
                                                                            <Setter Property="BorderBrush" Value="#735B8DEF"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding TaskRunning}" Value="True">
                                                                            <Setter Property="Background" Value="#29C9A0E8"/>
                                                                            <Setter Property="BorderBrush" Value="#73C9A0E8"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10" FontWeight="Medium" VerticalAlignment="Center"
                                                                       MaxWidth="400" TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="离线"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Pyro}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Online}" Value="True">
                                                                                <Setter Property="Text" Value="BGI已启动: 空闲"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource Orange}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding BgiStatus}" Value="stopped">
                                                                                <Setter Property="Text" Value="BGI 未运行"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource Geo}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding BgiStatus}" Value="observer">
                                                                                <Setter Property="Text" Value="遥控器"/>
                                                                                <Setter Property="Foreground" Value="#5B8DEF"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding TaskRunning}" Value="True">
                                                                                <Setter Property="Text" Value="{Binding TaskDisplayText}"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource Electro}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            </Border>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- 操作栏（文字按钮，融入卡片） -->
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                                <Button Content="🔗 锄地" Style="{StaticResource TextAction}" 
                                                                        Command="{Binding DataContext.BindHoeingGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" Margin="0,0,2,0" FontSize="11" ToolTip="绑定联机锄地配置组（所有人可编辑）"/>
                                                                <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0"/>
                                                                <Button Content="配置组" Style="{StaticResource TextAction}" Command="{Binding DataContext.StartGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0"/>
                                                                <Button Content="一条龙" Style="{StaticResource TextAction}" Command="{Binding DataContext.StartOneClickCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0"/>
                                                                <Button Content="快捷键" Style="{StaticResource TextAction}" Command="{Binding DataContext.ExecuteHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0"/>
                                                                <Button Content="关闭游戏" Style="{StaticResource TextAction}" Command="{Binding DataContext.CloseGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0"/>
                                                                <Button Content="停止" Style="{StaticResource TextAction}" Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                <TextBlock Text="|" FontSize="13" Foreground="{StaticResource Dim}" Margin="4,0"/>
                                                                <Button Content="启动BGI" Style="{StaticResource TextAction}" Foreground="{StaticResource Gold}" FontSize="12" ToolTip="点自己=启动本机 BGI；点别人=下发命令让对方启动 BGI" Command="{Binding DataContext.StartBgiCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                            <!-- 右列：记录按钮 + 定时上线 + 上线状态（与五个按键同一行，放右侧） -->
                                                            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                                                                <Border CornerRadius="7" Padding="8,2" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                        Background="#1F9C97C0" BorderBrush="#4D9C97C0">
                                                                    <Button Content="记录" Style="{StaticResource TextAction}" 
                                                                            Command="{Binding DataContext.ShowOnlineHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Padding="0" FontSize="10" FontWeight="Medium"/>
                                                                </Border>
                                                                <Border CornerRadius="7" Padding="8,2" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                        Background="#1F9C97C0" BorderBrush="#4D9C97C0">
                                                                    <Button Style="{StaticResource TextAction}"
                                                                            Command="{Binding DataContext.ScheduledOnlineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Padding="0" FontSize="10" FontWeight="Medium">
                                                                        <Button.Content>
                                                                            <!-- 显示该成员自己的定时上线时间（per-member），空/未设置时显示"定时上线" -->
                                                                            <TextBlock FontSize="10" FontWeight="Medium">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="{Binding ScheduledOnlineTime, StringFormat='定时 {0}'}"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ScheduledOnlineTime}" Value="">
                                                                                                <Setter Property="Text" Value="定时上线"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding ScheduledOnlineTime}" Value="{x:Null}">
                                                                                                <Setter Property="Text" Value="定时上线"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Button.Content>
                                                                    </Button>
                                                                </Border>
                                                                <!-- 清除上线：复位因定时/命令触发的已上线状态（不清除定时闹钟） -->
                                                                <Border CornerRadius="7" Padding="8,2" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                        Background="#1F8E6E6E" BorderBrush="#4DD46E6E">
                                                                    <Button Content="清除上线"
                                                                            Style="{StaticResource TextAction}"
                                                                            Command="{Binding DataContext.ClearOnlineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Padding="0" FontSize="10" FontWeight="Medium"/>
                                                                </Border>
                                                                <Border CornerRadius="7" Padding="8,2" BorderThickness="1" VerticalAlignment="Center"
                                                                        Margin="0,0,8,0" Background="#1F9C97C0" BorderBrush="#4D9C97C0">
                                                                    <TextBlock FontSize="10" FontWeight="Medium" VerticalAlignment="Center" LineHeight="14">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="未上线"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource Pyro}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding OnlineReady}" Value="True">
                                                                                        <Setter Property="Text" Value="已上线"/>
                                                                                        <Setter Property="Foreground" Value="{StaticResource Anemo}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding HasOnlineToday}" Value="True">
                                                                                        <Setter Property="Text" Value="已联机"/>
                                                                                        <Setter Property="Foreground" Value="{StaticResource Dim}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>

                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- 快捷指令 -->
                            <Border Grid.Row="1" Style="{StaticResource QuestCard}" Padding="14,11">
                                <StackPanel>
                                    <Grid Margin="0,0,0,9">
                                        <TextBlock Text="快捷指令" Style="{StaticResource SectionTitle}"/>
                                        <Border Height="1" Background="#40D4AF37" VerticalAlignment="Center" Margin="64,0,0,0"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="一键锄地" Style="{StaticResource BtnGhost}" Command="{Binding QuickHoeingCommand}" Padding="8,5" Margin="0,0,4,0"/>
                                        <Button Grid.Column="1" Content="传奇" Style="{StaticResource BtnGhost}" Command="{Binding QuickLegendCommand}" Padding="8,5" Margin="4,0"/>
                                        <Button Grid.Column="2" Content="次数盾" Style="{StaticResource BtnGhost}" Command="{Binding QuickShieldCommand}" Padding="8,5" Margin="4,0"/>
                                        <Button Grid.Column="3" Content="精英" Style="{StaticResource BtnGhost}" Command="{Binding QuickEliteCommand}" Padding="8,5" Margin="4,0"/>
                                        <Button Grid.Column="4" Content="小怪" Style="{StaticResource BtnGhost}" Command="{Binding QuickMultiCommand}" Padding="8,5" Margin="4,0"/>
                                        <Button Grid.Column="5" Content="自定义" Style="{StaticResource BtnGhost}" Command="{Binding QuickCustomCommand}" Padding="8,5" Margin="4,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 设置页面（IsShowingSettings=true 时显示） -->
                        <views:SettingsPage>
                            <views:SettingsPage.Style>
                                <Style TargetType="views:SettingsPage">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShowingSettings}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:SettingsPage.Style>
                        </views:SettingsPage>
                    </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
