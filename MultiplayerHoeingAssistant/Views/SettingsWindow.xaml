<Window x:Class="MultiplayerHoeingAssistant.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus-BGI - 设置"
        Width="520" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#F6F2E8"
        FontFamily="pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC, Segoe UI, Microsoft YaHei"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Txt" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="BorderBrush" Value="#D1D1D6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,20">
            <TextBlock Text="Nexus-BGI 设置" FontSize="18" FontWeight="SemiBold" Foreground="#1D1D1F"/>
            <TextBlock Text="请填写以下配置，保存后自动应用。" FontSize="12" Foreground="#6E6E73" Margin="0,4,0,12"/>

            <!-- 服务器地址 -->
            <TextBlock Text="服务器地址" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="ServerUrlBox" Style="{StaticResource Txt}" Text="http://your-server.com:8080"/>
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#8E8E93" Margin="0,2,0,0">
                <Run Text="BgiCoordinatorServer 的地址，"/><Run FontWeight="Bold" Text="不要带 /hub"/><Run Text="。"/>
                <LineBreak/>
                <Run Text="示例：http://your-server.com:8080（Docker 部署）或 http://localhost:5000（本地直连）"/>
            </TextBlock>

            <!-- 房间密码 -->
            <TextBlock Text="控制房间密码" Style="{StaticResource Lbl}"/>
            <PasswordBox x:Name="PasswordBox" Height="32" FontSize="13" Padding="8,4" Background="White" Foreground="#1D1D1F" BorderBrush="#D1D1D6"/>
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#8E8E93" Margin="0,2,0,0">
                <Run Text="房主首次加入时设置密码，其他人填入相同密码即可加入。"/>
                <LineBreak/>
                <Run Text="密码长度 4-8 位，所有成员使用同一个密码。"/>
            </TextBlock>

            <!-- 玩家名称 -->
            <TextBlock Text="玩家名称" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="PlayerNameBox" Style="{StaticResource Txt}"/>
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#8E8E93" Margin="0,2,0,0">
                <Run Text="你的昵称，显示在控制面板的成员列表中。"/>
                <LineBreak/>
                <Run Text="示例：茶包s、玩家A、host-1。建议每台机器填不同的名称以便区分。"/>
            </TextBlock>

            <!-- 玩家 UID -->
            <TextBlock Text="玩家 UID（自己的）" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="PlayerUidBox" Style="{StaticResource Txt}"/>
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#8E8E93" Margin="0,2,0,0">
                <Run Text="你在游戏中的 UID，用于服务器识别身份。"/>
                <LineBreak/>
                <Run Text="示例：171007645。必须包含在下面的「队伍 UID」列表中。"/>
            </TextBlock>

            <!-- 队友 UID（逗号分隔） -->
            <TextBlock Text="队伍 UID（4 个，逗号分隔）" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="TeamUidsBox" Style="{StaticResource Txt}" TextWrapping="Wrap" Height="60" VerticalContentAlignment="Top" AcceptsReturn="False"/>
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#8E8E93" Margin="0,2,0,0">
                <Run Text="各台机器各自的 UID，"/><Run FontWeight="Bold" Text="至少 1 个"/><Run Text="。用逗号分隔。"/>
                <LineBreak/>
                <Run Text="房间码基于所有 UID 生成，所有机器必须填写完全相同的 UID 列表！"/>
                <LineBreak/>
                <Run Text="示例：171007645,123456789,987654321,555555555"/>
            </TextBlock>

            <!-- BGI 路径 -->
            <TextBlock Text="BetterGI.exe 路径（可选）" Style="{StaticResource Lbl}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="BgiPathBox" Style="{StaticResource Txt}" Grid.Column="0" Margin="0,0,6,0"/>
                <Button x:Name="BrowseBgiButton" Content="浏览" Grid.Column="1" Width="56" Height="32"
                        Background="#E9E9EB" Foreground="#1D1D1F" BorderThickness="0" Cursor="Hand" Click="BrowseBgiButton_Click"/>
            </Grid>
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#8E8E93" Margin="0,2,0,0">
                <Run Text="BetterGI.exe 的完整路径。如果填写，助手会在 BGI 崩溃时自动重启。"/>
                <LineBreak/>
                <Run Text="示例：E:\Program Files\BetterGI\BetterGI.exe。可点击「浏览」按钮选择。留空也可以。"/>
            </TextBlock>

            <!-- 预期开锄人数 -->
            <TextBlock Text="预期开锄人数（几人一起开车）" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="ExpectedPlayersBox" Style="{StaticResource Txt}" Text="4"/>
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#8E8E93" Margin="0,2,0,0">
                <Run Text="填写 1-4。到达该人数即触发联机锄地，不再等其余人员。"/>
                <LineBreak/>
                <Run Text="各成员填自己的预期，服务端取最小值判断。示例：都填 3，则 3 人上线就开锄。"/>
            </TextBlock>

            <!-- 遥控器模式 -->
            <CheckBox x:Name="ObserverModeCheckBox" IsChecked="False" Margin="0,12,0,0" Cursor="Hand">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#1D1D1F">
                    <Run FontWeight="SemiBold" Text="遥控器模式（本机无 BGI，仅用于远程控制）"/>
                    <LineBreak/>
                    <Run FontSize="10" Foreground="#8E8E93" Text="启用后不检测 BGI 进程，不参与联机战斗，右上角显示蓝色「监控」标签。"/>
                    <LineBreak/>
                    <Run FontSize="10" Foreground="#8E8E93" Text="可向其他成员（含自己的执行端）下发配置组、停止、一条龙等命令。"/>
                    <LineBreak/>
                    <Run FontSize="10" Foreground="#8E8E93" Text="不占用房间成员名额，不在成员列表中显示。"/>
                    <LineBreak/>
                    <Run FontSize="10" Foreground="#8E8E93" Text="适合在主用户开一个遥控端，用于监控和控制房间内所有成员。"/>
                </TextBlock>
            </CheckBox>

            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#FF3B30" TextWrapping="Wrap" Margin="0,10,0,0"/>

            <!-- 按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Content="取消" Width="90" Height="34" Margin="0,0,10,0"
                        Background="#E9E9EB" Foreground="#1D1D1F" BorderThickness="0" Cursor="Hand" Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="保存并连接" Width="110" Height="34"
                        Background="#007AFF" Foreground="White" BorderThickness="0" Cursor="Hand" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>