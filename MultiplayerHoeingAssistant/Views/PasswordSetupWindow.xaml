<Window x:Class="MultiplayerHoeingAssistant.Views.PasswordSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码设置"
        Width="420" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1a1a2e"
        Foreground="#e0e0e0">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="设置控制房间密码"
                   FontSize="18" FontWeight="Bold" Foreground="#4fc3f7" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="请输入控制房间密码（4-8位）"
                   Foreground="#90caf9" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <PasswordBox Grid.Row="2" x:Name="PasswordInput"
                     Height="36" Margin="0,0,0,12"
                     Background="#263238" Foreground="White"
                     BorderBrush="#37474f" PasswordChar="●"/>

        <TextBlock Grid.Row="3" x:Name="ConfirmLabel" Text="请再次输入密码"
                   Foreground="#90caf9" Margin="0,0,0,8"/>

        <PasswordBox Grid.Row="4" x:Name="ConfirmInput"
                     Height="36" Margin="0,0,0,16"
                     Background="#263238" Foreground="White"
                     BorderBrush="#37474f" PasswordChar="●"/>

        <TextBlock Grid.Row="5" x:Name="ErrorText" Text=""
                   Foreground="#ef5350" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" x:Name="OkButton" Width="100" Height="36" Margin="0,0,12,0"
                    Background="#42a5f5" Foreground="White" BorderThickness="0" Click="OkButton_Click"/>
            <Button Content="取消" x:Name="CancelButton" Width="100" Height="36"
                    Background="#546e7a" Foreground="White" BorderThickness="0" Click="CancelButton_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="7" Text="成员角色：请向房主询问密码后在此输入。"
                   Foreground="#78909c" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>