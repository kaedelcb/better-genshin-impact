<UserControl x:Class="MultiplayerHoeingAssistant.Views.DodocoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:MultiplayerHoeingAssistant.ViewModels"
             xmlns:helpers="clr-namespace:MultiplayerHoeingAssistant.Helpers"
             xmlns:views="clr-namespace:MultiplayerHoeingAssistant.Views"
             d:DataContext="{d:DesignInstance Type=vm:DodocoViewModel}"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <!-- 复用 MainWindow.Resources 的样式与颜色（GoldScrollViewer、QuestCard、GuildCheckBox、
         BtnGold、BtnGhost、TextAction、GoldText、White、Dim、Gold、GoldLine 等），
         在 UserControl.Resources 内部引用父级资源必须用 DynamicResource（编译期无法向上查找）。 -->

    <UserControl.Resources>
        <helpers:LevelToBrushConverter x:Key="LevelBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 隐式鎏金滚动条：页面内所有 ScrollBar（含 TextBox/RichTextBox/ListBox 模板内部的）
             统一为细窄鎏金款。模板与 MainWindow 的 GoldVScrollBar/GoldHScrollBar 完全一致（已验证无残角），
             仅靠 Orientation 触发器切换竖/横模板 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Width="{TemplateBinding Width}">
                                <Track.Thumb>
                                    <Thumb HorizontalAlignment="Stretch">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        CornerRadius="3"
                                                        Background="#50D4AF37"
                                                        BorderThickness="0"
                                                        HorizontalAlignment="Stretch"
                                                        SnapsToDevicePixels="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.3" Color="#D4AF37"/>
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#B0D4AF37"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#E0D4AF37"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="4"/>
                    <Setter Property="Margin" Value="0,1"/>
                    <Setter Property="Width" Value="NaN"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid>
                                    <Track x:Name="PART_Track" Orientation="Horizontal" Height="{TemplateBinding Height}">
                                        <Track.Thumb>
                                            <Thumb VerticalAlignment="Stretch">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBorder"
                                                                CornerRadius="3"
                                                                Background="#50D4AF37"
                                                                BorderThickness="0"
                                                                VerticalAlignment="Stretch"
                                                                SnapsToDevicePixels="True">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.3" Color="#D4AF37"/>
                                                            </Border.Effect>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#B0D4AF37"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#E0D4AF37"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 隐式鎏金 ScrollViewer：覆盖 WPF 默认模板（默认模板右下角有个 SystemColors.ControlBrush 的
             浅色 Rectangle 角落块，配透明细滚动条时会露出来=白色方块；此模板无角落块）。
             作用于页面内所有未显式指定样式的 ScrollViewer（含 ListBox/TextBox/RichTextBox 模板内部）。 -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Row="0" Grid.Column="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0" Grid.Column="1"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1" Grid.Column="0"
                                       Orientation="Horizontal"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 鎏金下拉选择框（与 SettingsPage 同款，独立提供） -->
        <Style x:Key="GoldComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="#2A1C1640" BorderBrush="#B0D4AF37"
                                                BorderThickness="1" CornerRadius="7" Padding="8,0,7,0">
                                            <Grid TextElement.Foreground="#FFFFFF">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" TextElement.Foreground="#FFFFFF"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                                <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0"
                                                      Stroke="{DynamicResource Gold}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                                      VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3B2E1A40"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F0E8C96D"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#38251040"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False" PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220" Margin="0,4,0,0">
                                    <Border Background="#232048" BorderBrush="{DynamicResource GoldLine}"
                                            BorderThickness="1" CornerRadius="8" Padding="2"
                                            Effect="{DynamicResource CardShadow}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{DynamicResource GoldScrollViewer}">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GoldComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,7" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3DD4AF37"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B2E1A"/>
                                <Setter Property="Foreground" Value="{DynamicResource GoldText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色输入框 -->
        <Style x:Key="GoldInput" TargetType="TextBox">
            <Setter Property="Background" Value="#2A1C1640"/>
            <Setter Property="Foreground" Value="{DynamicResource White}"/>
            <Setter Property="BorderBrush" Value="#80D4AF37"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Gold}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab 按钮（文字型，选中时金色高亮 + 下划线） -->
        <Style x:Key="DodocoTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource White}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 选中态由各按钮内联 Style 的 DataTrigger（SelectedTabIndex == 各自序号）叠加金色 -->
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== 顶栏：返回 + 标题 + Tab ========== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="←  返回" Style="{DynamicResource BtnGhost}" Padding="12,5"
                        Command="{Binding BackCommand}"/>
                <TextBlock Text="嘟嘟可 · 日志与监控" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource GoldText}" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="实时日志"
                        Command="{Binding SelectTabCommand}" CommandParameter="0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DodocoTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                    <Setter Property="Foreground" Value="{DynamicResource GoldText}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="日志浏览" Command="{Binding SelectTabCommand}" CommandParameter="1">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DodocoTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                    <Setter Property="Foreground" Value="{DynamicResource GoldText}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="异常监控" Command="{Binding SelectTabCommand}" CommandParameter="2">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DodocoTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                    <Setter Property="Foreground" Value="{DynamicResource GoldText}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="锄地数据" Command="{Binding SelectTabCommand}" CommandParameter="3">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DodocoTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                    <Setter Property="Foreground" Value="{DynamicResource GoldText}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="桌面监控" Command="{Binding SelectTabCommand}" CommandParameter="4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DodocoTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                    <Setter Property="Foreground" Value="{DynamicResource GoldText}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ========== 内容区 ========== -->
        <Grid Grid.Row="1">

            <!-- ======== Tab1 实时日志 ======== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <Border Grid.Row="0" Style="{DynamicResource QuestCard}" Padding="10,8" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="来源" FontSize="11" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="130" ItemsSource="{Binding LogSources}" SelectedItem="{Binding SelectedSource}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource GoldComboBox}" ItemContainerStyle="{StaticResource GoldComboItem}"
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="日志来源：本机或房间成员。远程成员日志经协调服务器转发，约有 0.5–1 秒延迟；成员掉线后缓存流仍可回看"/>
                        <TextBlock Text="级别" FontSize="11" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <CheckBox Content="DBG" IsChecked="{Binding ShowDbg}" Style="{DynamicResource GuildCheckBox}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <CheckBox Content="INF" IsChecked="{Binding ShowInf}" Style="{DynamicResource GuildCheckBox}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <CheckBox Content="WRN" IsChecked="{Binding ShowWrn}" Style="{DynamicResource GuildCheckBox}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <CheckBox Content="ERR" IsChecked="{Binding ShowErr}" Style="{DynamicResource GuildCheckBox}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="实例" FontSize="11" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="170" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                                  Style="{StaticResource GoldComboBox}" ItemContainerStyle="{StaticResource GoldComboItem}"
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="实例筛选仅对本机来源生效"/>
                        <CheckBox Content="自动滚动" IsChecked="{Binding AutoFollow, Mode=TwoWay}"
                                  Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" Margin="0,0,8,0"
                                  ToolTip="跟尾显示最新日志；上翻列表时自动暂停，滚回底部恢复"/>
                        <Button Content="⇩ 最新" Style="{DynamicResource BtnGold}" Padding="8,4"
                                Click="ScrollToLatest_Click" Margin="0,0,12,0" VerticalAlignment="Center"
                                ToolTip="回到最新日志并恢复自动跟尾"/>
                        <Button Content="{Binding PauseButtonText}" Style="{DynamicResource BtnGhost}" Padding="10,4"
                                Command="{Binding TogglePauseCommand}" Margin="0,0,6,0"/>
                        <Button Content="清空视图" Style="{DynamicResource BtnGhost}" Padding="10,4"
                                Command="{Binding ClearViewCommand}" Margin="0,0,6,0" ToolTip="只清当前来源的界面缓冲，不影响日志文件和其它来源"/>
                        <Button Content="重探测日志" Style="{DynamicResource BtnGhost}" Padding="10,4"
                                Command="{Binding RefreshTargetCommand}" ToolTip="重新定位 BGI 日志目录与文件（刚改完 BGI 路径时用）"/>
                        <CheckBox Content="共享我的日志" IsChecked="{Binding ShareRealtimeLog, Mode=TwoWay}"
                                  Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" Margin="12,0,0,0"
                                  ToolTip="允许房间成员订阅你的实时日志（观众驱动：没人看时零流量；成员选中你才开始上报）"/>
                        <CheckBox Content="省流(仅INF+)" IsChecked="{Binding ShareLogInfoOnly, Mode=TwoWay}"
                                  Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" Margin="6,0,0,0"
                                  ToolTip="他人订阅你的日志时不转发 Debug 级，只发 INF/WRN/ERR"/>
                        <CheckBox Content="共享日志文件" IsChecked="{Binding ShareLogFiles, Mode=TwoWay}"
                                  Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" Margin="6,0,0,0"
                                  ToolTip="允许房间成员请求你的日志文件列表并下载完整日志（gzip 分块传输）。注意：完整日志可能包含本机路径等环境信息"/>
                    </StackPanel>
                </Border>

                <!-- 日志流（只读 RichTextBox：像文本编辑器一样跨行拖选/复制；行由代码后置按级别上色渲染） -->
                <Border Grid.Row="1" Style="{DynamicResource QuestCard}" Padding="8,6" Margin="0">
                    <Grid>
                        <RichTextBox x:Name="RealtimeLog" IsReadOnly="True" IsUndoEnabled="False"
                                     IsInactiveSelectionHighlightEnabled="True"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     FontSize="11" Foreground="{DynamicResource White}"
                                     CaretBrush="Transparent" FocusVisualStyle="{x:Null}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <RichTextBox.Resources>
                                <Style TargetType="Paragraph">
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>
                        <!-- 空态/中间态提示：本机 BGI 未运行、成员离线、对方 BGI 未运行、等待上报等 -->
                        <TextBlock Text="{Binding EmptyHintText}" FontSize="12" Foreground="{DynamicResource Dim}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="460" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmptyHintText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 状态栏 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,6,0,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                               Foreground="{DynamicResource Dim}"/>
                    <TextBlock Text="{Binding LogWatcherText}" FontSize="11"
                               Foreground="{DynamicResource Water}" Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ======== Tab2 日志浏览 ======== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：文件列表 + 远程成员日志下载 -->
                <Border Grid.Column="0" Style="{DynamicResource QuestCard}" Margin="0,0,8,0" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="日志文件" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource White}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="⟳" Style="{DynamicResource TextAction}" FontSize="13"
                                        Command="{Binding Browser.RefreshFilesCommand}" ToolTip="刷新文件列表"/>
                                <Button Content="📁" Style="{DynamicResource TextAction}" FontSize="13" Margin="6,0,0,0"
                                        Command="{Binding Browser.OpenLogFolderCommand}" ToolTip="打开日志目录"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListBox ItemsSource="{Binding Browser.FilesView}"
                                     SelectedItem="{Binding Browser.SelectedFile}"
                                     Background="Transparent" BorderThickness="0"
                                     ToolTip="默认已选中最新文件；本机两组在上，远程下载的在最下">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Gold}" Margin="0,6,0,4"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource White}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource Dim}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1} · 实例 {2}">
                                                    <Binding Path="DateText"/>
                                                    <Binding Path="SizeText"/>
                                                    <Binding Path="InstanceCountText"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- 文件列表空态：一台机器都没配好时给出指引 -->
                            <TextBlock Text="{Binding Browser.FileListHintText}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Dim}" Margin="4" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Browser.FileListHintText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- 远程成员日志下载：选成员 → 获取列表 → 选中文件下载（gzip 分块，30s 无新块超时） -->
                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <Border BorderBrush="{DynamicResource Dim}" BorderThickness="0,1,0,0" Margin="0,0,0,6"/>
                            <TextBlock Text="远程成员日志" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Gold}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding Browser.RemoteMembers}"
                                          SelectedItem="{Binding Browser.SelectedRemoteMember}"
                                          Style="{StaticResource GoldComboBox}" ItemContainerStyle="{StaticResource GoldComboItem}"
                                          ToolTip="选择在线成员（自己除外）"/>
                                <Button Grid.Column="1" Content="获取列表" Style="{DynamicResource BtnGhost}"
                                        Padding="8,3" FontSize="11" Margin="6,0,0,0"
                                        Command="{Binding Browser.FetchRemoteFilesCommand}"
                                        ToolTip="向选中成员请求日志文件列表（需对方开启「共享日志文件」）"/>
                            </Grid>
                            <ListBox ItemsSource="{Binding Browser.RemoteFiles}"
                                     SelectedItem="{Binding Browser.SelectedRemoteFile}"
                                     Background="Transparent" BorderThickness="0" MaxHeight="140" Margin="0,4,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource White}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="10" Foreground="{DynamicResource Dim}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} · {1}">
                                                        <Binding Path="DateText"/>
                                                        <Binding Path="SizeText"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="下载" Style="{DynamicResource BtnGhost}"
                                        Padding="10,3" FontSize="11"
                                        Command="{Binding Browser.DownloadRemoteFileCommand}"
                                        ToolTip="下载选中的远程日志到本机 log\remote_downloads\，完成后自动在上方列表打开"/>
                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Height="4" Margin="8,0,0,0"
                                             VerticalAlignment="Center"
                                             Value="{Binding Browser.DownloadProgress}"/>
                            </Grid>
                            <TextBlock Text="{Binding Browser.RemoteStatus}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Dim}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 右：查看区 -->
                <Border Grid.Column="1" Style="{DynamicResource QuestCard}" Margin="0" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 工具栏行1：时间范围搜索 / 关键字搜索 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                            <TextBlock Text="时间范围" FontSize="11" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                            <views:TimeOfDayPicker x:Name="StartTimePicker" Margin="6,0,2,0"
                                                   Value="{Binding Browser.StartTimeText, Mode=TwoWay}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="开始时间（点击弹出选择，点「完成」直接搜索）"/>
                            <TextBlock Text="至" FontSize="11" Foreground="{DynamicResource Dim}"
                                       VerticalAlignment="Center" Margin="2,0"/>
                            <views:TimeOfDayPicker x:Name="EndTimePicker" Margin="2,0,4,0"
                                                   Value="{Binding Browser.EndTimeText, Mode=TwoWay}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="结束时间（点击弹出选择，点「完成」直接搜索）"/>
                            <Button Content="按时间搜索" Style="{DynamicResource BtnGold}" Padding="10,4" Margin="2,0,14,0"
                                    Command="{Binding Browser.SearchTimeRangeCommand}"
                                    ToolTip="收集行头时间落在「开始~结束」区间内的日志行，结果列在下方，点击跳转"/>
                            <TextBlock Text="关键字" FontSize="11" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                            <TextBox Width="130" Style="{StaticResource GoldInput}" Margin="4,0"
                                     Text="{Binding Browser.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="在当前文件中搜索关键字，结果列在下方，命中词高亮显示，点击可跳转"/>
                            <CheckBox Content="正则表达式" IsChecked="{Binding Browser.IsRegex}"
                                      Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" Margin="0,0,6,0"
                                      ToolTip="不勾选=普通关键字匹配（忽略大小写）；勾选=按正则表达式匹配（如 超时|失败）"/>
                            <Button Content="按关键字搜索" Style="{DynamicResource BtnGhost}" Padding="10,4"
                                    Command="{Binding Browser.SearchCommand}"/>
                        </StackPanel>

                        <!-- 工具栏行2：导出 + 使用提示 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                            <Button Content="导出原样" Style="{DynamicResource BtnGhost}" Padding="10,4"
                                    Command="{Binding Browser.ExportRawCommand}" Margin="0,0,6,0"
                                    ToolTip="复制整个日志文件（共享读，正在写入的当天文件也可导出）"/>
                            <Button Content="导出筛选" Style="{DynamicResource BtnGhost}" Padding="10,4"
                                    Command="{Binding Browser.ExportFilteredCommand}" Margin="0,0,12,0"
                                    ToolTip="有搜索结果时导出命中行，否则导出当前视图；支持 .log / .csv"/>
                            <TextBlock Text="整文件一次加载 · 自由滚动不分块 · 拖选多行后 Ctrl+C 复制 · 点搜索结果精确定位"
                                       FontSize="10" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 内容区（虚拟化 ListBox：整文件全量在内存，像记事本一样自由滚动不分块加载；
                             行号+级别上色；搜索关键字鎏金高亮；Extended 多选 + Ctrl+C 复制；不换行保持行语义） -->
                        <Grid Grid.Row="2">
                            <ListBox x:Name="BrowserList" ItemsSource="{Binding Browser.Lines}"
                                     SelectionMode="Extended"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     FontSize="11" Foreground="{DynamicResource White}"
                                     FontFamily="Consolas, HarmonyOS Sans SC, Microsoft YaHei"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="BrowserList_PreviewKeyDown">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4,0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent"
                                                            Padding="{TemplateBinding Padding}"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#40D4AF37"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#1AD4AF37"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding LineNumber}"
                                                       TextAlignment="Right" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource Dim}"/>
                                            <views:HighlightTextBlock Grid.Column="1"
                                                                      SourceText="{Binding Text, Mode=OneWay}"
                                                                      HighlightPattern="{Binding DataContext.Browser.HighlightPattern, RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneWay}"
                                                                      IsRegexHighlight="{Binding DataContext.Browser.HighlightIsRegex, RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneWay}"
                                                                      Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- 查看区空态提示 -->
                            <TextBlock Text="{Binding Browser.ViewerHintText}" FontSize="12" Foreground="{DynamicResource Dim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="420" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Browser.ViewerHintText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- 状态栏 -->
                        <Grid Grid.Row="3" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Browser.ViewStatus}" FontSize="11" Foreground="{DynamicResource Dim}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="加载中…" FontSize="11" Foreground="{DynamicResource Gold}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Browser.IsLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- 搜索结果（显示行头时间而非行号；命中关键字鎏金高亮；点中行跳转；Ctrl+C 复制命中行原文） -->
                        <ListBox Grid.Row="4" ItemsSource="{Binding Browser.SearchResults}"
                                 SelectedItem="{Binding Browser.SelectedResult}"
                                 SelectionMode="Extended"
                                 MaxHeight="130" Background="#1E262660" BorderThickness="1" BorderBrush="#40D4AF37"
                                 Margin="0,6,0,0" Padding="4" FontSize="11" Foreground="{DynamicResource White}"
                                 PreviewKeyDown="SearchResults_PreviewKeyDown">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <!-- 有搜索结果时才显示结果区 -->
                                        <Trigger Property="HasItems" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <views:HighlightTextBlock FontSize="11" Foreground="{DynamicResource White}"
                                                              TextWrapping="Wrap"
                                                              SourceText="{Binding DisplayText, Mode=OneWay}"
                                                              HighlightPattern="{Binding DataContext.Browser.HighlightPattern, RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneWay}"
                                                              IsRegexHighlight="{Binding DataContext.Browser.HighlightIsRegex, RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneWay}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======== Tab3 异常监控 ======== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：规则管理 -->
                <Border Grid.Column="0" Style="{DynamicResource QuestCard}" Margin="0,0,8,0" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="监控规则" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource White}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <CheckBox Content="事发录像" IsChecked="{Binding IncidentSnapshotEnabled, Mode=TwoWay}"
                                          Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" Margin="0,0,4,0"
                                          ToolTip="开启后本机 BGI 运行期间后台每秒截一帧（10 秒环形缓冲，纯本地不上传）；命中标了「存快照」的规则时保存前后 3 秒画面+触发日志到 log/incidents/"/>
                                <Button Content="📂" Style="{DynamicResource TextAction}" FontSize="12" Margin="0,0,8,0"
                                        VerticalAlignment="Center" Command="{Binding Watch.OpenIncidentDirCommand}"
                                        ToolTip="打开事发快照目录（log/incidents/）"/>
                                <CheckBox Content="全部静音" IsChecked="{Binding MuteAll, Mode=TwoWay}"
                                          Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center"
                                          ToolTip="静音后命中规则只记录，不红点/不响铃/不弹托盘"/>
                            </StackPanel>
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Watch.Rules}" Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E262660" CornerRadius="7" Padding="8,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Content="启用" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                      Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                      FontSize="10" ToolTip="启用/停用该规则（停用的规则不参与匹配，历史记录保留）"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource White}"/>
                                                <TextBlock Text="{Binding PatternDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource Dim}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Pattern}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox Content="告警" IsChecked="{Binding Alert, Mode=TwoWay}"
                                                          Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" FontSize="10"
                                                          ToolTip="命中后红点 + 托盘气泡 + 提示音；关闭则只记录到下方异常列表，不出声"/>
                                                <CheckBox Content="快照" IsChecked="{Binding Snapshot, Mode=TwoWay}"
                                                          Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" FontSize="10"
                                                          Margin="6,0,0,0"
                                                          ToolTip="命中时保存事发快照（前后 3 秒桌面画面 + 触发日志到 log/incidents/，需开启「事发录像」总开关）"/>
                                                <Button Content="✕" Style="{DynamicResource TextAction}" FontSize="12" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.Watch.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="删除规则"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 新规则表单 -->
                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock Text="新增规则" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Gold}" Margin="0,0,0,2"/>
                            <TextBlock Text="规则 = 帮你盯日志：日志里出现「匹配内容」（且级别达到最低级别）就记到右侧异常记录，勾选命中告警则同时红点+响铃"
                                       FontSize="10" Foreground="{DynamicResource Dim}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="① 规则名称（可选，留空则自动用匹配内容命名）" FontSize="10"
                                       Foreground="{DynamicResource Dim}" Margin="0,0,0,2"/>
                            <TextBox Style="{StaticResource GoldInput}" Margin="0,0,0,6"
                                     Text="{Binding Watch.NewRuleName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="② 匹配内容（要盯住的文字，如：超时、领取失败；留空 = 只看级别）" FontSize="10"
                                       Foreground="{DynamicResource Dim}" Margin="0,0,0,2"/>
                            <TextBox Style="{StaticResource GoldInput}" Margin="0,0,0,4"
                                     Text="{Binding Watch.NewRulePattern, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                <CheckBox Content="正则表达式" IsChecked="{Binding Watch.NewRuleIsRegex}"
                                          Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" Margin="0,0,10,0"
                                          ToolTip="不勾选=上面的匹配内容按普通关键字匹配（忽略大小写）；勾选=按正则表达式匹配"/>
                                <TextBlock Text="最低级别" FontSize="11" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                <ComboBox Width="80" Margin="4,0,10,0" Style="{StaticResource GoldComboBox}"
                                          ItemContainerStyle="{StaticResource GoldComboItem}"
                                          SelectedIndex="{Binding Watch.NewRuleMinLevelIndex}"
                                          ToolTip="只有达到该级别的日志才参与匹配（匹配内容留空 + 最低级别 ERR = 任何错误都告警的兜底规则）">
                                    <ComboBoxItem Content="DBG" Style="{DynamicResource GoldComboItem}"/>
                                    <ComboBoxItem Content="INF" Style="{DynamicResource GoldComboItem}"/>
                                    <ComboBoxItem Content="WRN" Style="{DynamicResource GoldComboItem}"/>
                                    <ComboBoxItem Content="ERR" Style="{DynamicResource GoldComboItem}"/>
                                </ComboBox>
                                <CheckBox Content="命中告警" IsChecked="{Binding Watch.NewRuleAlert}"
                                          Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center"
                                          ToolTip="勾选：命中后红点 + 托盘气泡 + 提示音；不勾选：只记录到异常列表"/>
                                <CheckBox Content="存快照" IsChecked="{Binding Watch.NewRuleSnapshot}"
                                          Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" Margin="10,0,0,0"
                                          ToolTip="勾选：命中时保存前后 3 秒桌面画面 + 触发日志（需开启「事发录像」总开关）"/>
                            </StackPanel>
                            <TextBlock Text="示例：匹配内容填「超时」+ 最低级别 INF = 日志出现超时就记录；匹配内容留空 + 最低级别 ERR = 所有错误都记录"
                                       FontSize="10" Foreground="{DynamicResource Dim}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Grid>
                                <Button Content="+ 添加规则" Style="{DynamicResource BtnGold}" Padding="12,5"
                                        HorizontalAlignment="Left" Command="{Binding Watch.AddRuleCommand}"/>
                                <TextBlock Text="{Binding Watch.RuleStatus}" FontSize="10" Foreground="{DynamicResource Dim}"
                                           VerticalAlignment="Center" Margin="96,0,0,0" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 右：异常记录 -->
                <Border Grid.Column="1" Style="{DynamicResource QuestCard}" Margin="0" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="异常记录" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource White}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ComboBox Width="130" ItemsSource="{Binding Watch.RuleFilterItems}"
                                          SelectedItem="{Binding Watch.SelectedRuleFilter}"
                                          Style="{StaticResource GoldComboBox}" ItemContainerStyle="{StaticResource GoldComboItem}"
                                          Margin="0,0,6,0" ToolTip="按命中的规则筛选异常记录"/>
                                <ComboBox Width="90" ItemsSource="{Binding Watch.LevelFilterItems}"
                                          SelectedItem="{Binding Watch.SelectedLevelFilter}"
                                          Style="{StaticResource GoldComboBox}" ItemContainerStyle="{StaticResource GoldComboItem}"
                                          Margin="0,0,6,0" ToolTip="按日志级别筛选异常记录"/>
                                <ComboBox Width="110" ItemsSource="{Binding Watch.DateFilterItems}"
                                          SelectedItem="{Binding Watch.SelectedDateFilter}"
                                          Style="{StaticResource GoldComboBox}" ItemContainerStyle="{StaticResource GoldComboItem}"
                                          Margin="0,0,6,0" ToolTip="按日期筛选异常记录"/>
                                <Button Content="⟳" Style="{DynamicResource TextAction}" FontSize="13"
                                        Command="{Binding Watch.RefreshRecordsCommand}" ToolTip="重新加载异常库"/>
                            </StackPanel>
                        </Grid>

                        <!-- 诊断包导出（§5-C：排查联机问题时一键打包发给队友） -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Text="诊断时间范围" FontSize="11" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                            <views:TimeOfDayPicker x:Name="DiagStartPicker" Margin="6,0,2,0"
                                                   Value="{Binding DiagnosticStartText, Mode=TwoWay}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="范围开始（点击弹出选择；HH:mm:ss 表示今天该时刻）"/>
                            <TextBlock Text="~" FontSize="11" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                            <views:TimeOfDayPicker x:Name="DiagEndPicker" Margin="2,0,4,0"
                                                   Value="{Binding DiagnosticEndText, Mode=TwoWay}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="范围结束（点击弹出选择；结束早于开始视为跨零点）"/>
                            <Button Content="现在" Style="{DynamicResource BtnGhost}" Padding="8,4" Margin="0,0,6,0"
                                    Command="{Binding SetDiagTimeNowCommand}" ToolTip="结束=当前时间，开始=10 分钟前"/>
                            <Button Content="全天" Style="{DynamicResource BtnGhost}" Padding="8,4" Margin="0,0,6,0"
                                    Command="{Binding SetDiagTimeAllDayCommand}" ToolTip="范围=今天 00:00:00 ~ 23:59:59（当天全部日志）"/>
                            <Button Content="📦 导出诊断包" Style="{DynamicResource BtnGhost}" Padding="10,4"
                                    Command="{Binding ExportDiagnosticCommand}"
                                    ToolTip="打包该时间范围内的 BGI 日志切片 + 助手日志 + 异常库 + 统计 + 成员快照"/>
                            <TextBlock Text="{Binding DiagStatus}" FontSize="10" Foreground="{DynamicResource Dim}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ListBox Grid.Row="2" ItemsSource="{Binding Watch.FilteredRecords}" Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource GoldText}" Margin="2,8,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Stretch" Background="Transparent"
                                            BorderThickness="0" Padding="0" Cursor="Hand"
                                            Command="{Binding DataContext.Watch.OpenRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="点击跳转到日志浏览中对应位置">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="#1E262660" CornerRadius="7"
                                                        Padding="8,6" Margin="0,0,0,6">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GoldLine}"/>
                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}" FontSize="10"
                                                           Foreground="{DynamicResource Dim}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource GoldText}"/>
                                                <Button Content="📷 快照" FontSize="10" Padding="6,1" Margin="10,0,0,0"
                                                        VerticalAlignment="Center" Background="Transparent"
                                                        BorderBrush="{DynamicResource GoldLine}" BorderThickness="1"
                                                        Foreground="{DynamicResource Dim}" Cursor="Hand"
                                                        Visibility="{Binding HasIncidentSnapshot, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.Watch.OpenRecordIncidentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="打开该异常的事发快照目录（前后 3 秒游戏截图 + 触发日志；仅实际录到事发录像的记录显示此按钮）"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" FontSize="10" Foreground="{DynamicResource Dim}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" MaxWidth="520"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="3" Text="{Binding Watch.RecordStatus}" FontSize="11"
                                   Foreground="{DynamicResource Dim}" Margin="0,6,0,0"
                                   ToolTip="合并计数 ×N 为运行期显示值；落盘 JSONL 保留首次计数，不回写"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======== Tab4 锄地数据 ======== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 卡死心跳红色横幅（§5-A） -->
                <Border Grid.Row="0" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                        Background="#3D8E3A3A" BorderBrush="{DynamicResource Pyro}" BorderThickness="1"
                        Visibility="{Binding Stats.SuspectedStall, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <TextBlock Text="{Binding Stats.StallBannerText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Pyro}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="判定阈值(分钟)" FontSize="11" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                            <TextBox Width="44" Style="{StaticResource GoldInput}" Margin="6,0,0,0" Padding="6,2"
                                     Text="{Binding Stats.StallThresholdMinutes, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="日志超过该时长无新行且任务运行中 → 判定疑似卡死（默认 3 分钟）"/>
                            <Button Content="📦 导出诊断包" Style="{DynamicResource BtnGhost}" Padding="10,4"
                                    Margin="10,0,0,0" Command="{Binding ExportDiagnosticCommand}"
                                    ToolTip="打包当前时刻前后 10 分钟的日志切片 + 异常库 + 成员快照，发给队友排查卡死"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{DynamicResource GoldScrollViewer}">
                    <StackPanel Margin="0,0,0,24">

                        <!-- 上半：成员实时状态墙 -->
                        <Border Style="{DynamicResource QuestCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,9">
                                    <TextBlock Text="成员实时状态" Style="{DynamicResource SectionTitle}"/>
                                    <Border Height="1" Background="#40D4AF37" VerticalAlignment="Center" Margin="84,0,0,0"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Stats.Members}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E262660" CornerRadius="8" Padding="10,8"
                                                    Margin="0,0,8,8" MinWidth="210">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PlayerName}" FontSize="13" FontWeight="Medium"
                                                                   Foreground="{DynamicResource White}"/>
                                                        <Border CornerRadius="6" Padding="6,1" Margin="8,0,0,0"
                                                                VerticalAlignment="Center" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#1F9C97C0"/>
                                                                    <Setter Property="BorderBrush" Value="#4D9C97C0"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TaskRunning}" Value="True">
                                                                            <Setter Property="Background" Value="#29C9A0E8"/>
                                                                            <Setter Property="BorderBrush" Value="#73C9A0E8"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="空闲"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding TaskRunning}" Value="True">
                                                                                <Setter Property="Text" Value="运行中"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource Electro}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CurrentTaskGroupName, StringFormat='配置组: {0}', TargetNullValue=配置组: -}"
                                                               FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding CurrentRouteDisplay, StringFormat='路线: {0}', TargetNullValue=路线: -}"
                                                               FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding AutoHoeingProgress}"
                                                               FontSize="10" Foreground="{DynamicResource Water}" Margin="0,2,0,0"
                                                               TextWrapping="Wrap" MaxWidth="300"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 每日运行日报（按天解析 BGI 日志：各配置组运行时长 + 与前一有数据日对比 + 联机轮次明细） -->
                        <Border Style="{DynamicResource QuestCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,9">
                                    <TextBlock Text="每日运行日报" Style="{DynamicResource SectionTitle}"/>
                                    <Border Height="1" Background="#40D4AF37" VerticalAlignment="Center" Margin="96,0,0,0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ComboBox Width="140" ItemsSource="{Binding Stats.DailyReport.DateItems}"
                                                  SelectedItem="{Binding Stats.DailyReport.SelectedDateItem}"
                                                  Style="{StaticResource GoldComboBox}" ItemContainerStyle="{StaticResource GoldComboItem}"
                                                  Margin="0,0,6,0" ToolTip="选择要查看的日期（来自 BGI 按天日志文件，保留期内可回看）"/>
                                        <Button Content="📋 复制报告" Style="{DynamicResource BtnGhost}" Padding="10,4"
                                                Margin="0,0,6,0" Command="{Binding Stats.DailyReport.CopyReportCommand}"
                                                ToolTip="把当前报告（含联机轮次明细）复制到剪贴板"/>
                                        <Button Content="⟳" Style="{DynamicResource TextAction}" FontSize="13"
                                                Command="{Binding Stats.DailyReport.RefreshCommand}" ToolTip="重新解析所选日期的日志"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Stats.DailyReport.ReportTitle}" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource GoldText}"/>
                                    <TextBlock Text="{Binding Stats.DailyReport.CompareBaseText}" FontSize="10"
                                               Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBlock Text="{Binding Stats.DailyReport.CopyStatusText}" FontSize="10"
                                               Foreground="{DynamicResource Anemo}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Stats.DailyReport.EmptyText}" FontSize="11"
                                           Foreground="{DynamicResource Dim}" Margin="0,6,0,0"/>
                                <ItemsControl ItemsSource="{Binding Stats.DailyReport.Groups}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E262660" CornerRadius="6" Padding="8,5" Margin="0,0,0,5">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding LineText}" FontSize="12"
                                                                   Foreground="{DynamicResource White}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding MergedNote}" FontSize="10" HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource Water}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Expander Margin="0,2,0,0"
                                                              Visibility="{Binding HasRounds, Converter={StaticResource BoolToVis}}">
                                                        <Expander.Header>
                                                            <TextBlock Text="联机轮次明细" FontSize="10" Foreground="{DynamicResource Dim}"/>
                                                        </Expander.Header>
                                                        <ItemsControl ItemsSource="{Binding Rounds}" Margin="8,2,0,2">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" FontSize="10" TextWrapping="Wrap"
                                                                               Foreground="{DynamicResource Dim}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Stats.DailyReport.TotalText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource GoldText}" Margin="0,4,0,0"/>

                                <!-- BGI 全天任务总览：当天全部运行单元（一条龙/配置组/独立任务），顶层时间互斥 -->
                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding Stats.DailyReport.HasOverview, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="BGI 全天任务总览" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource GoldText}"/>
                                        <TextBlock Text="{Binding Stats.DailyReport.OverviewTotalText}" FontSize="10"
                                                   Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Stats.DailyReport.OverviewRows}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource White}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ======== Tab5 桌面监控 ======== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <Border Grid.Row="0" Style="{DynamicResource QuestCard}" Padding="10,8" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="画面源" FontSize="11" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="150" ItemsSource="{Binding Monitor.MonitorOptions}" SelectedItem="{Binding Monitor.SelectedMonitor}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource GoldComboBox}" ItemContainerStyle="{StaticResource GoldComboItem}"
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="本机主屏或远程成员画面（远程需对方开启「共享我的桌面截图」）"/>
                        <Button Content="📷 刷新" Style="{DynamicResource BtnGold}" Padding="12,5"
                                Command="{Binding Monitor.CaptureCommand}" Margin="0,0,12,0"/>
                        <CheckBox Content="自动刷新" IsChecked="{Binding Monitor.AutoRefresh, Mode=TwoWay}"
                                  Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" Margin="0,0,6,0"
                                  ToolTip="开启后按间隔自动截帧；离开本 Tab 自动停止"/>
                        <ComboBox Width="76" SelectedIndex="{Binding Monitor.IntervalIndex}"
                                  Style="{StaticResource GoldComboBox}" ItemContainerStyle="{StaticResource GoldComboItem}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="自动刷新间隔">
                            <ComboBoxItem Content="1 秒" Style="{DynamicResource GoldComboItem}"/>
                            <ComboBoxItem Content="3 秒" Style="{DynamicResource GoldComboItem}"/>
                            <ComboBoxItem Content="5 秒" Style="{DynamicResource GoldComboItem}"/>
                            <ComboBoxItem Content="10 秒" Style="{DynamicResource GoldComboItem}"/>
                        </ComboBox>
                        <Button Content="清空历史" Style="{DynamicResource BtnGhost}" Padding="10,4"
                                Command="{Binding Monitor.ClearHistoryCommand}" Margin="0,0,6,0"/>
                        <Button Content="🔍 放大" Style="{DynamicResource BtnGhost}" Padding="10,4"
                                Click="MonitorZoom_Click" Margin="0,0,6,0"
                                ToolTip="放大查看当前画面（滚轮缩放，也可直接点击大图）"/>
                        <Button Content="⬇ 下载" Style="{DynamicResource BtnGhost}" Padding="10,4"
                                Command="{Binding Monitor.SaveFrameCommand}" Margin="0,0,12,0"
                                ToolTip="把当前大图的 JPEG 原帧保存到本机（远程画面为对方共享的压缩图）"/>
                        <CheckBox Content="共享我的桌面截图" IsChecked="{Binding ShareDesktopScreenshot, Mode=TwoWay}"
                                  Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Center" Margin="0,0,6,0"
                                  ToolTip="允许队友点选查看我的桌面：仅在被请求时截一帧发给对方（需已连房；不勾选则任何请求都会被忽略）"/>
                        <ComboBox Width="92" SelectedIndex="{Binding ShareScreenshotWidthIndex}"
                                  Style="{StaticResource GoldComboBox}" ItemContainerStyle="{StaticResource GoldComboItem}"
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="共享画质（被请求时上传的截图宽度，高度等比）：越大越清晰、越费带宽；1280 可看清屏上文字">
                            <ComboBoxItem Content="480px" Style="{DynamicResource GoldComboItem}"/>
                            <ComboBoxItem Content="960px" Style="{DynamicResource GoldComboItem}"/>
                            <ComboBoxItem Content="1280px" Style="{DynamicResource GoldComboItem}"/>
                            <ComboBoxItem Content="1920px" Style="{DynamicResource GoldComboItem}"/>
                        </ComboBox>
                        <TextBlock Text="{Binding Monitor.PrivacyNote}" FontSize="10" Foreground="{DynamicResource Dim}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 大图 -->
                <Border Grid.Row="1" Style="{DynamicResource QuestCard}" Padding="8" Margin="0,0,0,8">
                    <Grid>
                        <Image Source="{Binding Monitor.CurrentImage}" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Cursor="Hand" ToolTip="点击放大查看"
                               MouseLeftButtonUp="MonitorImage_Click">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Monitor.HasFrame}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="{Binding Monitor.CurrentFrameInfo}" FontSize="12" Foreground="{DynamicResource Dim}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Monitor.HasFrame}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 状态行 -->
                <Grid Grid.Row="2" Margin="2,0,0,6">
                    <TextBlock Text="{Binding Monitor.StatusText}" FontSize="11" Foreground="{DynamicResource Dim}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Monitor.CurrentFrameInfo}" FontSize="11" Foreground="{DynamicResource Gold}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- 历史帧缩略图条（点击切换查看，环形 10 帧） -->
                <ListBox Grid.Row="3" ItemsSource="{Binding Monitor.Frames}" SelectedItem="{Binding Monitor.SelectedThumb}"
                         MaxHeight="96" Background="#1E262660" BorderThickness="1" BorderBrush="#40D4AF37"
                         Padding="4" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,6,0">
                                <Border BorderBrush="{DynamicResource GoldLine}" BorderThickness="1" CornerRadius="4" Padding="1">
                                    <Image Source="{Binding Thumb}" Height="56" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding TimeText}" FontSize="9" Foreground="{DynamicResource Dim}"
                                           HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
