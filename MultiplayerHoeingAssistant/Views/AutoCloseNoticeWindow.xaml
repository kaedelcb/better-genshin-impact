<Window x:Class="MultiplayerHoeingAssistant.Views.AutoCloseNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更新BGI"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        FontFamily="pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC, Segoe UI, Microsoft YaHei"
        FontSize="13"
        Foreground="#F4F2FA"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
            <GradientStop Color="#141534" Offset="0"/>
            <GradientStop Color="#221F4E" Offset="0.56"/>
            <GradientStop Color="#1B1943" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#F4F2FA"/>
        <SolidColorBrush x:Key="Dim" Color="#BAB3D4"/>
        <SolidColorBrush x:Key="Gold" Color="#E8C96D"/>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#D4AF37"/>
            <Setter Property="Foreground" Value="#141534"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8C96D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BFA043"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,18,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                    Background="#284FC3F7" BorderBrush="#804FC3F7" BorderThickness="1.2"
                    VerticalAlignment="Top" Margin="0,2,14,0">
                <TextBlock Text="i" FontSize="18" FontWeight="Bold" Foreground="#7BD6FF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
            </Border>

            <ScrollViewer Grid.Column="1" MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="MessageText" Foreground="{StaticResource Ink}"
                           TextWrapping="Wrap" LineHeight="21"/>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" BorderBrush="#60D4AF37" BorderThickness="0,1,0,0" Background="#191735" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CountdownText" Grid.Column="0" Foreground="{StaticResource Gold}"
                           FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>

                <Button x:Name="OkButton" Grid.Column="1" Content="确定" MinWidth="104" Height="34"
                        Style="{StaticResource PrimaryBtn}" IsDefault="True" IsCancel="True"
                        Click="OkButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
