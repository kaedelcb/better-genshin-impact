<UserControl x:Class="MultiplayerHoeingAssistant.Views.BasicTaskCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MultiplayerHoeingAssistant.Views"
             FontFamily="pack://application:,,,/Assets/Fonts/#HarmonyOS Sans SC, Segoe UI, Microsoft YaHei"
             Foreground="{DynamicResource White}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="BasicTaskCenterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- local styles below are kept for the current shell only; core controls use the shared style dictionary -->
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="BasicPlanExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource GoldText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Background="Transparent" BorderThickness="0"
                                          HorizontalContentAlignment="Left" Padding="0">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="Arrow" Data="M 0,0 L 7,5 L 0,10 Z"
                                          Fill="{DynamicResource Gold}" Width="7" Height="10"
                                          Stretch="Fill" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" ContentSource="Content"
                                              Visibility="Collapsed" Margin="0,8,0,0" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SummaryLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource Dim}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SummaryBorder" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SummaryBorder" Property="Background" Value="#2E6E6EB4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SummaryBorder" Property="Background" Value="#2E6E6EB4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlanListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
             <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="9"
                                Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2E6E6EB4" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A315F" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#80D4AF37" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            运行卡片只在有真实运行时出现。它们不能把计划编辑器推到窗口外：
            多条历史/Unknown 卡片在固定高度的滚动区内查看，计划表和执行按钮始终保留工作区。
        -->
        <ScrollViewer Grid.Row="0" Style="{DynamicResource GoldScrollViewer}" Height="{Binding CurrentPlanRunsHeight}" MaxHeight="168" Margin="0,0,0,8"
                      Visibility="{Binding HasCurrentPlanRuns, Converter={StaticResource Visible}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding CurrentPlanRuns}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                            <Border Style="{DynamicResource QuestCard}" Padding="9,5" Margin="0,0,0,4">
                            <DockPanel LastChildFill="True">
                                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            MaxWidth="500" Margin="10,0,0,0">
                                    <Button Content="暂停" Style="{DynamicResource BtnGhost}"
                                            Command="{Binding DataContext.PauseRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Visibility="{Binding CanPause, Converter={StaticResource Visible}}" />
                                    <Button Content="恢复" Style="{DynamicResource BtnGhost}"
                                            Command="{Binding DataContext.ResumeRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Visibility="{Binding CanResume, Converter={StaticResource Visible}}" />
                                    <Button Content="{Binding StopActionText}" Style="{DynamicResource BtnGhost}"
                                            Command="{Binding DataContext.StopRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Visibility="{Binding CanStop, Converter={StaticResource Visible}}" />
                                </WrapPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding WorkflowName}" Foreground="{DynamicResource White}"
                                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" Foreground="{Binding StateColor}" Margin="0,0,5,0" FontSize="10" />
                                        <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource GoldText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CurrentNodeText}" Foreground="{DynamicResource Dim}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ActionHintText}" Foreground="{DynamicResource GoldText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding NoteText}" Foreground="{DynamicResource Pyro}" TextWrapping="Wrap"
                                               FontSize="10.5" Margin="0,2,0,0" MaxHeight="30" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{DynamicResource QuestCard}" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧只负责选择计划表。 -->
                <Border Grid.Column="0" BorderBrush="#40D4AF37" BorderThickness="0,0,1,0" Padding="14,16">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                             <Grid Margin="0,0,0,10">
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="Auto" />
                                     <ColumnDefinition Width="Auto" />
                                     <ColumnDefinition Width="Auto" />
                                     <ColumnDefinition Width="*" />
                                 </Grid.ColumnDefinitions>
                                 <Button Grid.Column="0" Content="＋" Style="{DynamicResource BtnGold}" Width="36" Height="34"
                                         Padding="0" ToolTip="新建计划表" Command="{Binding NewFlowCommand}" />
                                 <Button Grid.Column="1" Content="⋯" Style="{DynamicResource BtnGhost}" Width="36" Height="34"
                                         Padding="0" Margin="12,0,20,0" ToolTip="计划管理：导入、导出、恢复已删除计划"
                                         Click="ManageClick" />
                                 <TextBlock Grid.Column="2" Text="计划表" FontSize="19" FontWeight="SemiBold"
                                            Foreground="{DynamicResource GoldText}" VerticalAlignment="Center" Margin="0,0,18,0" />
                                 <ComboBox Grid.Column="3" Width="175" Height="34" HorizontalAlignment="Left"
                                           Style="{DynamicResource GoldComboBox}"
                                           SelectedIndex="{Binding DataContext.TaskCenterModeIndex,
                                               RelativeSource={RelativeSource AncestorType={x:Type views:MistletoePage}},
                                               Mode=TwoWay}"
                                           ToolTip="选择任务中心的工作方式">
                                     <ComboBoxItem Style="{DynamicResource GoldComboItem}" Content="基础模式 · 计划表" />
                                     <ComboBoxItem Style="{DynamicResource GoldComboItem}" Content="高级模式 · 流程编排" />
                                 </ComboBox>
                             </Grid>
                        </StackPanel>

                        <Grid>
                                 <ListBox x:Name="FlowList" ItemsSource="{Binding BasicFlows}"
                                      Margin="0,2,0,0"
                                     SelectedValue="{Binding SelectedWorkflowId, Mode=OneWay}"
                                     SelectedValuePath="WorkflowId" SelectionChanged="FlowChanged"
                                     PreviewMouseRightButtonDown="FlowListPreviewRightClick"
                                     ContextMenuOpening="FlowListContextMenuOpening"
                                     PreviewMouseWheel="FlowListPreviewMouseWheel"
                                     ItemContainerStyle="{StaticResource PlanListItem}"
                                     Background="Transparent" BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Gold}"
                                                     VerticalAlignment="Top" Margin="0,5,9,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource White}"
                                                           FontSize="14" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="删除当前计划表" Click="DeleteSelectedFlow" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                            <Border x:Name="EmptyPlanList" Background="#1C1A3A" BorderBrush="{DynamicResource GoldLine}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFlows}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="还没有计划表" Foreground="{DynamicResource GoldText}" FontWeight="SemiBold" />
                                    <TextBlock Text="新建一张计划表开始安排配置单。" Foreground="{DynamicResource Dim}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,6,0,10" />
                                    <Button Content="＋ 新建计划表" Style="{DynamicResource BtnGold}"
                                            Command="{Binding NewFlowCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>

                    </DockPanel>
                </Border>

                <!-- 右侧基础版：按 BGI 计划表的“一行一个配置单”工作区。 -->
                <Grid Grid.Column="1" Margin="20,16,20,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentPlanTitle}" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{DynamicResource GoldText}" />
                                    <TextBlock Text="{Binding CurrentPlanSummary}" Foreground="{DynamicResource Dim}" FontSize="11" Margin="12,5,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SummaryLinkButton}" Click="OpenPlanSettingsClick"
                                        IsEnabled="{Binding IsEditing}" HorizontalAlignment="Right" Padding="7,3" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="计划设置" Foreground="{DynamicResource GoldText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Editing.PlanSettingsSummary}" Foreground="{DynamicResource Dim}" FontSize="11" Margin="10,2,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1" Style="{DynamicResource GoldScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Margin="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="＋ 新增配置单" Style="{DynamicResource BtnGhost}" Padding="8,3" FontSize="11" Margin="0,0,5,0"
                                            Click="AddConfigClick" ToolTip="从当前 BGI 资源目录添加 resource 配置单" />
                                    <Button Content="复制" Style="{DynamicResource BtnGhost}" Padding="8,3" FontSize="11" Margin="0,0,5,0"
                                            Command="{Binding Editing.DuplicateSelectedNodeCommand}"
                                            CommandParameter="{Binding Editing.SelectedNode}"
                                            IsEnabled="{Binding Editing.HasSelectedNode}" />
                                    <Button Content="修改" Style="{DynamicResource BtnGhost}" Padding="8,3" FontSize="11" Margin="0,0,5,0"
                                            Command="{Binding OpenResourceEditorCommand}"
                                            CommandParameter="{Binding Editing.SelectedNode}"
                                            IsEnabled="{Binding Editing.HasSelectedNode}"
                                            ToolTip="在 BGI 中修改当前配置单" />
                                    <Button Content="删除" ToolTip="删除当前选中的配置单（左侧计划表右键菜单用于删除整张计划表）" Style="{DynamicResource BtnGhost}" Padding="8,3" FontSize="11" Margin="0,0,5,0"
                                            Command="{Binding RemoveSelectedResourceCommand}"
                                            CommandParameter="{Binding Editing.SelectedNode}"
                                            IsEnabled="{Binding Editing.HasSelectedNode}" />
                                    <Button Content="导入全部配置" Style="{DynamicResource BtnGhost}" Padding="8,3" FontSize="11" Margin="0,0,5,0"
                                            Command="{Binding ImportAllFlowsCommand}" ToolTip="导入多张任务中心计划表" />
                                    <Button Content="导出全部配置" Style="{DynamicResource BtnGhost}" Padding="8,3" FontSize="11" Margin="0,0,5,0"
                                            Command="{Binding ExportAllFlowsCommand}" ToolTip="导出当前任务中心的全部计划表" />
                                    <Button Content="▶ 启动配置单" Style="{DynamicResource BtnGhost}" Padding="8,3" Margin="0,0,5,0" Click="StartSingleClick"
                                            IsEnabled="{Binding Editing.HasSelectedNode}" ToolTip="启动当前选中的配置单" />
                                    <Button Content="⏵⏵ 连续一条龙" Style="{DynamicResource BtnGold}" Padding="9,3" Margin="0" Click="StartContinuousClick"
                                            IsEnabled="{Binding IsEditing}" ToolTip="按当前计划顺序运行已启用的配置单；不可启动时点击后显示原因" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Border Background="#261A3F" BorderBrush="{DynamicResource GoldLine}" BorderThickness="1"
                                    CornerRadius="7" Padding="9,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="配置 BGI" Style="{DynamicResource BtnGhost}" Padding="7,3" FontSize="10"
                                            Command="{Binding OpenSettingsCommand}" Margin="10,0,0,0" Visibility="{Binding StatusIsError, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Pyro}" FontSize="10.5"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" />
                                </DockPanel>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- 列表右侧保留滚动条槽位；表头必须使用与行内容相同的可视宽度，
                                 否则“启用”表头会比行内勾选框向右偏移。 -->
                            <Grid Grid.Row="0" Margin="0,0,20,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="156" /><ColumnDefinition Width="166" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                <TextBlock Text="顺序" Grid.Column="0" Foreground="{DynamicResource Dim}" FontSize="10"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Text="配置单" Grid.Column="1" Foreground="{DynamicResource Dim}" FontSize="10" />
                                <TextBlock Text="执行日期" Grid.Column="2" Foreground="{DynamicResource Dim}" FontSize="10"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Text="UID/账号" Grid.Column="3" Foreground="{DynamicResource Dim}" FontSize="10"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Text="启用" Grid.Column="4" Foreground="{DynamicResource Dim}" FontSize="10"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                             <Grid Grid.Row="1">
                                 <ListBox x:Name="ResourceList" ItemsSource="{Binding ResourceNodes}" SelectedItem="{Binding Editing.SelectedNode, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" AllowDrop="True" MaxHeight="360" VerticalAlignment="Top"
                                         PreviewMouseLeftButtonDown="ResourceRowMouseDown"
                                         PreviewMouseMove="ResourceRowMouseMove"
                                         PreviewMouseLeftButtonUp="ResourceRowMouseUp"
                                         PreviewMouseWheel="ResourceListPreviewMouseWheel"
                                         PreviewDragOver="ResourceRowsDragOver"
                                         PreviewDrop="ResourceRowsDrop"
                                         DragOver="ResourceRowsDragOver"
                                          Drop="ResourceRowsDrop"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" /><Setter Property="AllowDrop" Value="True" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" BorderBrush="#35D4AF37" BorderThickness="0,0,0,1" CornerRadius="0" Padding="0,0,4,0"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#2E6E6EB4" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#3A315F" /><Setter TargetName="Row" Property="BorderBrush" Value="#D4AF37" /><Setter TargetName="Row" Property="BorderThickness" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                             <Grid MinHeight="40" Tag="{Binding}" ToolTip="拖动左侧把手调整顺序；点击日期或账号值编辑"
                                                  ContextMenuOpening="ResourceContextMenuOpening">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="156" /><ColumnDefinition Width="166" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                                     <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="⋮⋮" Foreground="{DynamicResource Dim}" FontSize="12" Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding ResourceIndex, StringFormat={}{0:00}}" Foreground="{DynamicResource Water}" FontSize="14" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource White}" FontSize="14" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Style="{DynamicResource BasicCellButton}"
                                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="32" Margin="2,0,2,0"
                                                            Padding="0" HorizontalContentAlignment="Stretch" Click="OpenNodeSettingsClick" Tag="{Binding}"
                                                            ToolTip="点击编辑执行日期">
                                                         <Border Background="#241D43" BorderBrush="#55D4AF37" BorderThickness="1" CornerRadius="7" Padding="6,2" Margin="0">
                                                             <TextBlock Text="{Binding WeekdaysDisplay}" Foreground="{DynamicResource White}" FontSize="10.5"
                                                                        FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                                                        TextAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Button>
                                                    <Button Grid.Column="3" Style="{DynamicResource BasicCellButton}"
                                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="32" Margin="2,0,2,0"
                                                            Padding="0" HorizontalContentAlignment="Stretch" Click="OpenNodeSettingsClick" Tag="{Binding}"
                                                            ToolTip="点击编辑账号">
                                                         <Border Background="#241D43" BorderBrush="#55D4AF37" BorderThickness="1" CornerRadius="7" Padding="6,2" Margin="0">
                                                             <TextBlock Text="{Binding AccountDisplay}" Foreground="{DynamicResource White}" FontSize="10.5"
                                                                        FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                                                        TextAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Button>
                                                     <Grid Grid.Column="4" HorizontalAlignment="Stretch">
                                                         <CheckBox IsChecked="{Binding IncludedInPlan, Mode=TwoWay}" Style="{DynamicResource GuildCheckBox}"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                     </Grid>
                                                    <Grid.ContextMenu><ContextMenu><MenuItem Header="删除此配置单" Click="RemoveSelectedNode" /></ContextMenu></Grid.ContextMenu>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Background="#3A315F" BorderBrush="{DynamicResource GoldLine}" BorderThickness="1"
                                        CornerRadius="9" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEmptyPlan}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center" MaxWidth="360">
                                        <TextBlock Text="这张计划表还是空的" Foreground="{DynamicResource GoldText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="先添加一个配置单，修改会自动保存后即可启动计划。" Foreground="{DynamicResource Dim}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,14" />
                                        <Button Content="＋ 新增配置单" Style="{DynamicResource BtnGold}" Click="AddConfigClick" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Popup x:Name="NodeSettingsPopup" Placement="Right" AllowsTransparency="True" StaysOpen="False"
               PopupAnimation="Fade" HorizontalOffset="8" VerticalOffset="-20">
            <Border Style="{DynamicResource QuestCard}" Width="480" MaxHeight="560" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="读取刚才的修改" Style="{DynamicResource BtnGhost}" Padding="8,3" FontSize="10.5"
                                    Command="{Binding DataContext.RefreshResourceReferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Editing.SelectedNode}"
                                    ToolTip="在 BGI 保存配置后重新读取引用；任务中心计划会自动保存" />
                            <Button Content="×" Style="{DynamicResource BtnGhost}" Padding="8,3" FontSize="13"
                                    Margin="6,0,0,0" Click="CloseNodeSettingsClick" />
                        </StackPanel>
                        <StackPanel Margin="0,0,42,0">
                            <TextBlock Text="配置单设置" Foreground="{DynamicResource GoldText}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Editing.SelectedNode.DisplayName}" Foreground="{DynamicResource Dim}" FontSize="11" Margin="0,3,0,0" />
                            <TextBlock Text="点击日期或账号值即可直接修改；失败处理可在此配置单单独覆盖计划设置。"
                                       Foreground="{DynamicResource Dim}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Style="{DynamicResource GoldScrollViewer}" VerticalScrollBarVisibility="Auto">
                        <views:ScheduleNodeStrategiesView DataContext="{Binding Editing.SelectedNode}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
        <Popup x:Name="PlanSettingsPopup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False"
               PopupAnimation="Fade" VerticalOffset="6">
            <Border Style="{DynamicResource QuestCard}" Width="420" MaxHeight="520" Padding="12">
                <ScrollViewer Style="{DynamicResource GoldScrollViewer}" VerticalScrollBarVisibility="Auto">
                    <views:BasicPlanSettingsView DataContext="{Binding Editing}" />
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
