<UserControl x:Class="MultiplayerHoeingAssistant.Views.BasicTaskCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MultiplayerHoeingAssistant.Views"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="#2B3042" />
            <Setter Property="Foreground" Value="#E7DDBE" />
            <Setter Property="BorderBrush" Value="#4A5168" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="#202536" />
            <Setter Property="Foreground" Value="#E7DDBE" />
            <Setter Property="BorderBrush" Value="#4A5168" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Background" Value="#202536" />
            <Setter Property="Foreground" Value="#E7DDBE" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <WrapPanel DockPanel.Dock="Right">
                <Button Content="保存" Click="SaveClick" IsEnabled="{Binding IsEditing}" />
                <Button Content="开始" Click="StartClick" IsEnabled="{Binding CanStartSelectedPlan}" />
                <Button Content="管理 ▾" Click="ManageClick" />
            </WrapPanel>
            <TextBlock Text="任务中心" FontSize="17" FontWeight="SemiBold" Foreground="#E7DDBE" VerticalAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="1" Background="#1C2130" BorderBrush="#3A4156" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PlanViewButton" Content="计划表编辑器" Click="ShowPlanView" />
                    <Button x:Name="ConfigViewButton" Content="配置单" Click="ShowConfigView" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="当前计划表 / 配置单" Foreground="#A7B2C7" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="FlowChoice" Width="250" ItemsSource="{Binding Flows}"
                              SelectedValue="{Binding SelectedWorkflowId, Mode=OneWay}"
                              SelectedValuePath="WorkflowId" SelectionChanged="FlowChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ChoiceLabel}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding Editing.Title}" Foreground="#DCC17C" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding ActiveRuns}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#27343A" BorderBrush="#4B806D" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,4">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right">
                                <Button Content="暂停" Command="{Binding DataContext.PauseRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="恢复" Command="{Binding DataContext.ResumeRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="{Binding StopActionText}" Command="{Binding DataContext.StopRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" Foreground="#E7DDBE" />
                                <TextBlock Text="{Binding CurrentNodeText}" Foreground="#A7B2C7" />
                                <TextBlock Text="{Binding ActionHintText}" Foreground="#DCC17C" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="3">
            <Border x:Name="PlanView" Background="#1C2130" BorderBrush="#3A4156" BorderThickness="1" CornerRadius="5" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="计划表编辑器" FontSize="15" FontWeight="SemiBold" Foreground="#E7DDBE" />
                        <TextBlock Text="把配置单加入当前计划表，按列表顺序执行；右键任务可设置从此处开始。"
                                   Foreground="#8E98AF" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,7" />
                        <WrapPanel>
                            <ComboBox Width="360" ItemsSource="{Binding Editing.AppendSources}"
                                      SelectedIndex="{Binding Editing.AppendSourceIndex, Mode=TwoWay}"
                                      DisplayMemberPath="Line" />
                            <Button Content="新增配置单" Command="{Binding Editing.AppendNodeCommand}" />
                        </WrapPanel>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Editing.Nodes}" SelectedItem="{Binding Editing.SelectedNode, Mode=TwoWay}"
                             Background="#171B28" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="7,6" Margin="0,2" Background="#242A3A" CornerRadius="4">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="是否参与当前计划" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ScheduleTimeText}" Foreground="#DCC17C" Margin="8,0,0,0" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Index}" Foreground="#8E98AF" Width="28" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E7DDBE" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StrategySummary}" Foreground="#8E98AF" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="从此处开始执行" Click="PreviewSelectedStart" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border x:Name="ConfigView" Visibility="Collapsed" Background="#1C2130" BorderBrush="#3A4156" BorderThickness="1" CornerRadius="5" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#171B28" CornerRadius="4" Padding="7">
                        <ListBox ItemsSource="{Binding Editing.Nodes}" SelectedItem="{Binding Editing.SelectedNode, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,5" Margin="0,2" Background="#242A3A" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#E7DDBE" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding KindName}" Foreground="#8E98AF" FontSize="10" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#202637" BorderBrush="#3A4156" BorderThickness="1" CornerRadius="5" Padding="10">
                                <StackPanel DataContext="{Binding Editing.SelectedNode}">
                                    <TextBlock Text="任务设置" FontSize="14" FontWeight="SemiBold" Foreground="#E7DDBE" />
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#A7B2C7" Margin="0,4,0,8" />
                                    <CheckBox Content="参与当前计划" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Foreground="#E7DDBE" Margin="3,0,3,6" />
                                    <TextBlock Foreground="#A7B2C7" TextTrimming="CharacterEllipsis"><Run Text="资源：" /><Run Text="{Binding ConfigName}" /></TextBlock>
                                    <TextBlock Text="{Binding StrategySummary}" Foreground="#DCC17C" TextWrapping="Wrap" Margin="0,5,0,5" />
                                    <views:ScheduleNodeStrategiesView DataContext="{Binding}" />
                                    <WrapPanel>
                                        <Button Content="上移" Command="{Binding DataContext.Editing.MoveNodeUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="下移" Command="{Binding DataContext.Editing.MoveNodeDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Content="删除" Command="{Binding DataContext.Editing.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="PlanSettingsPanel" Background="#202637" BorderBrush="#3A4156" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,0">
                                <views:SchedulePlanSettingsView DataContext="{Binding Editing}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#DCC17C" TextWrapping="Wrap" />
            <TextBlock Text="基础模式按 BGI 茶包版计划表/配置单使用；高级模式另行施工。"
                       Foreground="#77839A" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
