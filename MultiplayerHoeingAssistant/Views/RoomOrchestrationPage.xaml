<UserControl x:Class="MultiplayerHoeingAssistant.Views.RoomOrchestrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MultiplayerHoeingAssistant.Views"
             x:Name="OrchestrationRoot" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Show"/>
        <local:RoomOrchestrationDisplayConverter x:Key="CompactDisplay"/>
        <SolidColorBrush x:Key="OrchGold" Color="#F2E3B6"/>
        <SolidColorBrush x:Key="OrchWhite" Color="#F4F2FA"/>
        <SolidColorBrush x:Key="OrchDim" Color="#BCB7D8"/>
        <SolidColorBrush x:Key="OrchLine" Color="#62516D"/>

        <Style x:Key="OrchLabel" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource OrchDim}"/>
        </Style>
        <Style x:Key="OrchEditButton" TargetType="Button">
            <Setter Property="Background" Value="#302B54"/>
            <Setter Property="BorderBrush" Value="#61587D"/>
            <Setter Property="Foreground" Value="{StaticResource OrchWhite}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#403964"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A298BC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#F2E3B6"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OrchParameterTile" TargetType="Border">
            <Setter Property="Background" Value="#343052"/>
            <Setter Property="BorderBrush" Value="#514969"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="25"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style x:Key="OrchDetailButton" TargetType="Button" BasedOn="{StaticResource OrchEditButton}">
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Background" Value="#342F50"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#403964"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#F2E3B6"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status.Kind}" Value="waiting"><Setter Property="Background" Value="#342D4C"/></DataTrigger>
                <DataTrigger Binding="{Binding Status.Kind}" Value="failed"><Setter Property="Background" Value="#422C42"/></DataTrigger>
                <DataTrigger Binding="{Binding Status.Kind}" Value="unknown"><Setter Property="Background" Value="#3B2D54"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OrchDetailInk" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OrchDim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status.Kind}" Value="waiting"><Setter Property="Foreground" Value="#E8C96D"/></DataTrigger>
                <DataTrigger Binding="{Binding Status.Kind}" Value="failed"><Setter Property="Foreground" Value="#F0A08A"/></DataTrigger>
                <DataTrigger Binding="{Binding Status.Kind}" Value="unknown"><Setter Property="Foreground" Value="#D3B3EF"/></DataTrigger>
                <DataTrigger Binding="{Binding Status.Kind}" Value="running"><Setter Property="Foreground" Value="#8FC1E8"/></DataTrigger>
                <DataTrigger Binding="{Binding Status.Kind}" Value="done"><Setter Property="Foreground" Value="#6FD8CE"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The badge is display-only; text and symbol always accompany the colour. -->
        <Style x:Key="OrchStatusChrome" TargetType="Border">
            <Setter Property="Background" Value="#292645"/>
            <Setter Property="BorderBrush" Value="#565071"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource OrchDim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="done">
                    <Setter Property="Background" Value="#243B47"/><Setter Property="BorderBrush" Value="#437A76"/>
                    <Setter Property="TextElement.Foreground" Value="#6FD8CE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="running">
                    <Setter Property="Background" Value="#273B55"/><Setter Property="BorderBrush" Value="#4E7290"/>
                    <Setter Property="TextElement.Foreground" Value="#8FC1E8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="waiting">
                    <Setter Property="Background" Value="#3E3549"/><Setter Property="BorderBrush" Value="#8C764A"/>
                    <Setter Property="TextElement.Foreground" Value="#E8C96D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="unknown">
                    <Setter Property="Background" Value="#3B2D54"/><Setter Property="BorderBrush" Value="#795E95"/>
                    <Setter Property="TextElement.Foreground" Value="#D3B3EF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="failed">
                    <Setter Property="Background" Value="#422C42"/><Setter Property="BorderBrush" Value="#966252"/>
                    <Setter Property="TextElement.Foreground" Value="#F0A08A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="StatusBadge">
            <Border Style="{StaticResource OrchStatusChrome}" Padding="6,3" VerticalAlignment="Center"
                    HorizontalAlignment="Left" ToolTip="{Binding Detail}">
                <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="12" FontWeight="Medium"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TaskRow">
            <Border Padding="5,3" CornerRadius="6" Margin="0,0,0,3" BorderThickness="1" MinHeight="28">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#211E41"/>
                        <Setter Property="BorderBrush" Value="#50486B"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status.Kind}" Value="running">
                                <Setter Property="Background" Value="#25314D"/>
                                <Setter Property="BorderBrush" Value="#54799B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid x:Name="TaskRowGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="#383253" CornerRadius="4" Width="21" Height="21" VerticalAlignment="Top" Margin="0,0,7,0">
                        <TextBlock Text="{Binding Number}" Foreground="{StaticResource OrchDim}" FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run Text="{Binding Name, Mode=OneWay}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource OrchWhite}"/>
                        <Run Text="  "/><Run Text="{Binding Type, Mode=OneWay}" FontSize="12" Foreground="{StaticResource OrchDim}"/>
                    </TextBlock>
                    <TextBlock x:Name="CompactJobText" Grid.Column="2" FontSize="12" Foreground="{StaticResource OrchDim}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="132" Margin="0,0,7,0" ToolTip="{Binding Status.Detail}">
                        <TextBlock.Text><MultiBinding Converter="{StaticResource CompactDisplay}">
                            <Binding/><Binding ElementName="TaskRowGrid" Path="ActualWidth"/>
                        </MultiBinding></TextBlock.Text>
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <ContentControl Grid.Column="3" Content="{Binding Status}" ContentTemplate="{StaticResource StatusBadge}"
                                    MaxWidth="114" VerticalAlignment="Center" HorizontalAlignment="Right" IsTabStop="False"/>
                    <TextBlock x:Name="TaskInlineDetail" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Status, Converter={StaticResource CompactDisplay}, ConverterParameter=TaskDetail}" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource OrchLabel}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OrchestrationEdge">
            <!-- This is a separate region between nodes; the rail cannot touch card controls. -->
            <Grid MinHeight="40" Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid>
                    <Path Width="2" Margin="0,0,0,8" Stretch="Fill" Data="M 0,0 L 0,1" HorizontalAlignment="Center"
                          StrokeThickness="1.5" Visibility="{Binding ContinuesToNext, Converter={StaticResource Show}}" IsHitTestVisible="False">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke" Value="#827A9A"/><Setter Property="StrokeDashArray" Value="3,3"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SwitchStatus.Kind}" Value="done">
                                        <Setter Property="Stroke" Value="#6FD8CE"/><Setter Property="StrokeDashArray" Value="1,0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SwitchStatus.Kind}" Value="waiting">
                                        <Setter Property="Stroke" Value="#E8C96D"/><Setter Property="StrokeDashArray" Value="1,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <Path Data="M 0,0 L 6,6 L 12,0" Stroke="#ACA8CA" StrokeThickness="1.5" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" IsHitTestVisible="False"
                          Visibility="{Binding ContinuesToNext, Converter={StaticResource Show}}"/>
                    <TextBlock Text="↪" Foreground="{StaticResource OrchDim}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers><DataTrigger Binding="{Binding ContinuesToNext}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Grid Grid.Column="1" Margin="8,4,4,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Relation}" TextWrapping="Wrap" MaxWidth="300" Foreground="{StaticResource OrchGold}"
                                   FontWeight="Medium" FontSize="12.5" Margin="0,0,7,2" VerticalAlignment="Center"/>
                        <ContentControl Content="{Binding SwitchStatus}" IsTabStop="False" ContentTemplate="{StaticResource StatusBadge}" Margin="0,0,0,2" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PostAction}" TextWrapping="Wrap" MaxWidth="270" Foreground="{StaticResource OrchWhite}" FontSize="12"
                                   Margin="0,0,5,2" VerticalAlignment="Center"/>
                        <ContentControl Content="{Binding PostStatus}" ContentTemplate="{StaticResource StatusBadge}" Margin="0,0,5,2" IsTabStop="False"
                                        Visibility="{Binding HasPostStatus, Converter={StaticResource Show}}"/>
                        <TextBlock Text="{Binding OnlineResult}" Foreground="#8FC1E8" FontSize="12" TextWrapping="Wrap" MaxWidth="180" VerticalAlignment="Center"
                                   Visibility="{Binding HasOnlineResult, Converter={StaticResource Show}}"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource OrchLabel}" Margin="0,3,0,0"
                               Visibility="{Binding HasDetail, Converter={StaticResource Show}}"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OrchestrationRoom">
            <StackPanel Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid>
                        <Border Width="2" Background="#655C7C" HorizontalAlignment="Center" Margin="0,36,0,0" IsHitTestVisible="False"
                                Visibility="{Binding Edge.ContinuesToNext, Converter={StaticResource Show}, FallbackValue=Collapsed}"/>
                        <Border DataContext="{Binding Status}" Style="{StaticResource OrchStatusChrome}" Width="25" Height="25" CornerRadius="13"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,13,0,0" ToolTip="{Binding Display}">
                            <TextBlock Text="{Binding Glyph}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Border Grid.Column="1" Margin="8,0,0,0" Padding="12,10" CornerRadius="12" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background">
                                    <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2C2853" Offset="0"/><GradientStop Color="#25224A" Offset="1"/></LinearGradientBrush></Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush" Value="{StaticResource OrchLine}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status.Kind}" Value="done"><Setter Property="BorderBrush" Value="#536E70"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Current}" Value="True">
                                        <Setter Property="BorderBrush" Value="#C5A552"/>
                                        <Setter Property="Background">
                                            <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#30294D" Offset="0"/><GradientStop Color="#29264F" Offset="1"/></LinearGradientBrush></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <WrapPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap" MaxWidth="390" Margin="0,0,8,2" VerticalAlignment="Center">
                                        <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource OrchGold}" FontSize="17" FontWeight="SemiBold"/>
                                        <Run Text="  "/><Run Text="{Binding Identity, Mode=OneWay}" Foreground="{StaticResource OrchDim}" FontSize="12"/>
                                    </TextBlock>
                                    <TextBlock Text="⌖ 当前登录" Foreground="{StaticResource OrchGold}" FontSize="12" Margin="0,0,6,2" VerticalAlignment="Center"
                                               Visibility="{Binding Current, Converter={StaticResource Show}}"/>
                                    <Border x:Name="RoomSectionTag" Background="#343052" BorderBrush="#62516D" BorderThickness="1" CornerRadius="6"
                                            Padding="6,2" Margin="0,0,0,2" VerticalAlignment="Center"
                                            Visibility="{Binding HasSection, Converter={StaticResource Show}}">
                                        <TextBlock Text="{Binding SectionTitle}" FontSize="12" Foreground="{StaticResource OrchDim}"/>
                                    </Border>
                                </WrapPanel>
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="218">
                                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource OrchLabel}" Margin="0,0,6,2" VerticalAlignment="Center"
                                               Visibility="{Binding HasUpdatedTime, Converter={StaticResource Show}}"/>
                                    <ContentControl Content="{Binding Status}" ContentTemplate="{StaticResource StatusBadge}" IsTabStop="False" Margin="0,0,0,2" HorizontalAlignment="Right"/>
                                </WrapPanel>
                            </Grid>
                            <Grid SizeChanged="RoomContentSizeChanged" Loaded="RoomContentLoaded">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding TasksCaption}" Style="{StaticResource OrchLabel}" Margin="0,0,0,4"
                                               Visibility="{Binding HasTaskWarning, Converter={StaticResource Show}}"/>
                                    <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskRow}"/>
                                    <TextBlock Text="尚未绑定联机任务" Margin="0,3,0,3">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource OrchLabel}">
                                                <Style.Triggers><DataTrigger Binding="{Binding HasTasks}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Visibility="{Binding HasNextTasks, Converter={StaticResource Show}}" Margin="0,5,0,0">
                                        <TextBlock Text="下轮生效的绑定" Foreground="{StaticResource OrchGold}" FontSize="12" Margin="0,0,0,3"/>
                                        <ItemsControl ItemsSource="{Binding NextTasks}" ItemTemplate="{StaticResource TaskRow}"/>
                                    </StackPanel>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <ProgressBar Width="72" Height="4" Background="#514A6E" Foreground="#6FD8CE" BorderThickness="0"
                                                     Value="{Binding CompletedCount, Mode=OneWay}" Maximum="{Binding TaskCount, Mode=OneWay}"
                                                     VerticalAlignment="Center" Margin="0,0,7,0" Focusable="False"
                                                     Visibility="{Binding HasConfirmedProgress, Converter={StaticResource Show}}"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource OrchLabel}">
                                            <Run Text="{Binding ProgressText, Mode=OneWay}"/><Run Text=" · 完成后："/>
                                            <Run Text="{Binding Completion, Mode=OneWay}" Foreground="{StaticResource OrchGold}" FontWeight="Medium"/>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                                <Border x:Name="RoomMetaPane" Grid.Column="1" Margin="11,0,0,0" Padding="11,0,0,0" BorderThickness="1,0,0,0"
                                        BorderBrush="#544B69" VerticalAlignment="Top">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border x:Name="PeopleParameterTile" Style="{StaticResource OrchParameterTile}" Margin="0,0,3,0"
                                                ToolTip="{Binding ExpectedPlayers, StringFormat='预期人数：{0}'}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Path Width="11" Height="12" Stroke="#D3C5E2" StrokeThickness="1" Stretch="Uniform" VerticalAlignment="Center"
                                                      Data="M 6,1 A 2.5,2.5 0 1 1 5.99,1 M 1,11 C 1,5.5 11,5.5 11,11"/>
                                                <TextBlock Grid.Column="1" Text="预期" Foreground="{StaticResource OrchDim}" FontSize="11" Margin="3,0,2,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ExpectedPlayers}" Foreground="{StaticResource OrchWhite}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="ScheduleParameterTile" Grid.Column="1" Margin="3,0,0,0" Style="{StaticResource OrchParameterTile}"
                                                ToolTip="{Binding Schedule, StringFormat='定时上线：{0}'}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Path Width="11" Height="11" Stroke="#D3C5E2" StrokeThickness="1" Stretch="Uniform" VerticalAlignment="Center"
                                                      Data="M 6,1 A 5,5 0 1 1 5.99,1 M 6,3 L 6,6 L 9,6"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Schedule, Converter={StaticResource CompactDisplay}, ConverterParameter=ScheduleLabel}"
                                                           FontSize="11" Margin="3,0,2,0" VerticalAlignment="Center" TextWrapping="Wrap">
                                                    <TextBlock.Style><Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource OrchDim}"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding Schedule, Converter={StaticResource CompactDisplay}, ConverterParameter=ScheduleNeedsConfirmation}" Value="True"><Setter Property="Foreground" Value="#E8C96D"/></DataTrigger></Style.Triggers>
                                                    </Style></TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding Schedule, Converter={StaticResource CompactDisplay}, ConverterParameter=ScheduleValue}"
                                                           Foreground="{StaticResource OrchWhite}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="60"/>
                                            </Grid>
                                        </Border>
                                        <Button Grid.Row="1" Grid.ColumnSpan="2" Content="编辑配置" Style="{StaticResource OrchEditButton}"
                                                Margin="0,5,0,0" IsEnabled="{Binding CanEdit}" Click="EditRoomClick"
                                                AutomationProperties.Name="{Binding Name, StringFormat='编辑房间 {0} 的配置'}"/>
                                        <Button x:Name="RoomDetailButton" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" Style="{StaticResource OrchDetailButton}"
                                                Visibility="{Binding ., Converter={StaticResource CompactDisplay}, ConverterParameter=DetailsVisibility}"
                                                ToolTip="{Binding ., Converter={StaticResource CompactDisplay}, ConverterParameter=Details}"
                                                AutomationProperties.Name="{Binding Name, StringFormat='查看房间 {0} 的执行详情'}" Click="RoomDetailsClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Status.Glyph}" Style="{StaticResource OrchDetailInk}" Margin="0,0,5,0"/>
                                                <TextBlock x:Name="RoomDetailSummary" Grid.Column="1" Text="{Binding ., Converter={StaticResource CompactDisplay}, ConverterParameter=Summary}"
                                                           Style="{StaticResource OrchDetailInk}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontWeight="Medium"/>
                                                <TextBlock Grid.Column="2" Text="详情" Foreground="{StaticResource OrchDim}" FontSize="12" VerticalAlignment="Center" Margin="5,0,4,0"/>
                                                <Path Grid.Column="3" Data="M 0,0 L 4,4 L 0,8" Stroke="{StaticResource OrchDim}" StrokeThickness="1.3" VerticalAlignment="Center" Width="4" Height="8"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                <ContentControl Content="{Binding Edge}" ContentTemplate="{StaticResource OrchestrationEdge}" IsTabStop="False"
                                Visibility="{Binding HasEdge, Converter={StaticResource Show}}"/>
                <ContentControl Content="{Binding PreviousEdge}" ContentTemplate="{StaticResource OrchestrationEdge}" IsTabStop="False"
                                Visibility="{Binding HasPreviousEdge, Converter={StaticResource Show}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Only the canvas scrolls. The confirmed login remains visible. -->
    <Grid x:Name="PresentationRoot">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#30294D" BorderBrush="#897344" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="0,0,0,7">
            <StackPanel>
                <Grid x:Name="HeaderLayout" SizeChanged="HeaderLayoutSizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid x:Name="HeaderLoginPane" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{Binding Details}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="7" BorderThickness="1" BorderBrush="#A28A54" Background="#40344B" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Path Width="13" Height="16" Stretch="Uniform" Stroke="#E8C96D" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M 8,17 C 4,13 2,10 2,7 A 6,6 0 0 1 14,7 C 14,10 12,13 8,17 Z M 8,4 A 2.5,2.5 0 1 1 7.99,4 Z"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding LoginLabel}" Foreground="{StaticResource OrchDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="HeaderRoomNameText" Grid.Column="2" Text="{Binding RoomName}" Foreground="{StaticResource OrchGold}" FontSize="14"
                                   FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="3" Background="#38314D" BorderBrush="#62516D" BorderThickness="1" CornerRadius="5" Padding="5,2" Margin="5,0,0,0"
                                VerticalAlignment="Center" Visibility="{Binding HasRoomCode, Converter={StaticResource Show}}">
                            <TextBlock Text="{Binding RoomCode}" Foreground="{StaticResource OrchDim}" FontSize="12" MaxWidth="82" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>
                    <Border x:Name="HeaderExecutorPane" Grid.Column="1" BorderBrush="#544B69" BorderThickness="1,0,0,0" Padding="8,0,8,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="24" Height="23" Background="#343052" BorderBrush="#514969" BorderThickness="1" CornerRadius="5" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Path Width="14" Height="13" Stroke="#D3C5E2" StrokeThickness="1" Stretch="Uniform" Data="M 1,1 H 15 V 11 H 1 Z M 8,11 V 15 M 4,15 H 12"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="执行端" Foreground="{StaticResource OrchDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="HeaderExecutorNameText" Grid.Column="2" Text="{Binding ExecutorName}" Foreground="{StaticResource OrchWhite}" FontSize="13"
                                       FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}"/>
                            <Grid x:Name="MonitorTargetRow" Grid.Column="2" Visibility="Collapsed">
                                <ComboBox x:Name="MonitorTargetSelector" MinHeight="28" FontSize="12"
                                          Style="{DynamicResource GoldComboBox}" ItemContainerStyle="{DynamicResource GoldComboItem}"
                                          AutomationProperties.Name="选择任务编排执行端" SelectionChanged="MonitorTargetChanged">
                                    <ComboBox.ItemTemplate><DataTemplate>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullLabel}"/>
                                    </DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="HeaderStatusPane" Grid.Column="2" BorderBrush="#544B69" BorderThickness="1,0,0,0" Padding="8,0,0,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ContentControl Content="{Binding Status}" ContentTemplate="{StaticResource StatusBadge}" IsTabStop="False" MaxWidth="126" Margin="0,0,5,0"/>
                            <Button x:Name="HeaderDetailButton" Grid.Column="1" Style="{StaticResource OrchDetailButton}" Background="Transparent" Padding="3,2" MinHeight="27"
                                    Click="HeaderDetailsClick" ToolTip="{Binding Details}" AutomationProperties.Name="查看当前登录和执行端完整详情">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HeaderReasonText" Text="{Binding Reason}" FontSize="12" FontWeight="Medium"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource OrchDetailInk}">
                                            <Style.Triggers><DataTrigger Binding="{Binding IsCleanupPending}" Value="True"><Setter Property="Foreground" Value="#E8C96D"/></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="详情" Foreground="{StaticResource OrchDim}" FontSize="12" Margin="5,0,4,0" VerticalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M 0,0 L 4,4 L 0,8" Stroke="{StaticResource OrchDim}" StrokeThickness="1.3" VerticalAlignment="Center" Width="4" Height="8"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding DataContext.RoomViewPreferenceMessage, ElementName=OrchestrationRoot}" Foreground="#E8C96D" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="RoomGraphScrollViewer" Grid.Row="1" Style="{DynamicResource GoldScrollViewer}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly"
                      Background="Transparent" Focusable="True" AutomationProperties.Name="房间编排画布"
                      PreviewMouseLeftButtonDown="GraphMouseDown" PreviewMouseMove="GraphMouseMove" PreviewMouseLeftButtonUp="GraphMouseUp"
                      LostMouseCapture="GraphLostMouseCapture" MouseLeave="GraphMouseLeave" PreviewKeyDown="GraphPreviewKeyDown">
            <StackPanel x:Name="RoomNodesHost" Background="Transparent" Margin="0,0,5,8">
                <TextBlock x:Name="EmptyGraphText" Text="没有可展示的房间档案。可通过助手房间的「管理房间」添加。" TextWrapping="Wrap"
                           Foreground="{StaticResource OrchDim}" Margin="8,17,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
