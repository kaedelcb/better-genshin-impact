<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.3.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\Images\logo.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- 登录入口是独立可执行项目，不能递归编入 WPF 主程序。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);StartupLauncher\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="AlphaVSS" Version="2.0.3" />
    <!-- 鏇存柊BGI锛氳В鍘?.7z 瀹夎鍖咃紙涓?BGI 涓诲伐绋嬪悓鐗堟湰锛屽叡浜?NuGet 缂撳瓨锛?-->
    <PackageReference Include="SharpCompress" Version="0.38.0" />
  </ItemGroup>

  <!-- 宓屽叆 HarmonyOS Sans SC 瀛椾綋锛堝厤璐瑰晢鐢紝鎺堟潈瑙?Assets/Fonts/HarmonyOS-LICENSE.txt锛夆啋 鍦嗘鼎灞忓箷瀛椾綋 -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\HarmonyOS_Sans_SC_Regular.ttf" />
    <Resource Include="Assets\Fonts\HarmonyOS_Sans_SC_Medium.ttf" />
  </ItemGroup>

  <!-- 宓屽叆鍝佺墝 Logo 鍜屽師绁炰富棰樺浘鐗囩礌鏉愶紙娲捐挋 + 瑙掕壊澶村儚锛屾潵婧?enka.network 鍏紑绱犳潗锛?-->
  <ItemGroup>
    <Resource Include="Assets\Images\logo.png" />
    <Resource Include="Assets\Images\paimon.png" />
    <Resource Include="Assets\Images\Ayaka.png" />
    <Resource Include="Assets\Images\Kazuha.png" />
    <Resource Include="Assets\Images\Ganyu.png" />
    <Resource Include="Assets\Images\Yoimiya.png" />
    <Resource Include="Assets\Images\Shougun.png" />
    <Resource Include="Assets\Images\Furina.png" />
    <Resource Include="Assets\Images\Zhongli.png" />
    <Resource Include="Assets\Images\Nahida.png" />
    <Resource Include="Assets\Pet\odette_base.png" />
    <!-- 奥黛塔双帧动画集（Anims/{set}/f1|f2.png + 清单；加载见 PetAnimCatalog，生成见 Tools/Import-OdetteAnims.ps1） -->
    <Resource Include="Assets\Pet\anims.json" />
    <Resource Include="Assets\Pet\Anims\**\*.png" />
    <Resource Include="Assets\Pet\Sounds\*.wav" />
  </ItemGroup>

  <!-- 授权文件随独立助手构建、发布及 BGI Tools 打包一起提供。 -->
  <ItemGroup>
    <None Update="LICENSE;README.md;THIRD-PARTY-NOTICES.md;licenses\**\*"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets\Fonts\HarmonyOS-LICENSE.txt" TargetPath="licenses\HarmonyOS-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 排除 assistant-config.json：不复制到输出目录，防止用户配置被编译覆盖 -->
  <ItemGroup>
    <None Update="assistant-config.json" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!-- 单测工程可访问 internal 成员（如 BgiPackageUpdateService.WriteEntry 的空文件分支） -->
  <ItemGroup>
    <InternalsVisibleTo Include="MultiplayerHoeingAssistant.UnitTest" />
  </ItemGroup>

  <!-- 缂栬瘧鍚庤嚜鍔ㄩ儴缃插埌 BGI 杈撳嚭鐩綍涓嬬殑 Tools\MultiplayerHoeingAssistant锛堝惈甯?x64 骞冲彴鐩綍鐨勭敤鎴疯繍琛岃矾寰勶級銆?       鍔╂墜杩涚▼杩愯涓細閿佷綇閮ㄧ讲鐩爣锛屾鏃跺彲鐢?-p:DeployToBgiTools=false 璺宠繃閮ㄧ讲浠呭畬鎴愮紪璇戦獙璇併€?-->
  <Target Name="DeployAssistantToBgiTools" AfterTargets="Build" Condition="'$(DeployToBgiTools)' != 'false'">
    <Message Text="DeployAssistantToBgiTools: 閮ㄧ讲鍔╂墜鍒?BGI Tools 鐩綍" Importance="high" />
    <ItemGroup>
      <AssistOut Include="$(TargetDir)**\*" Exclude="$(TargetDir)**\assistant-config.json" />
    </ItemGroup>
    <!-- 澶嶅埗鍒?bin\Debug\...\Tools\锛堟棤 x64 骞冲彴鐩綍锛?-->
    <Copy SourceFiles="@(AssistOut)"
          DestinationFiles="@(AssistOut->'$(MSBuildProjectDirectory)\..\BetterGenshinImpact\bin\$(Configuration)\net8.0-windows10.0.22621.0\Tools\MultiplayerHoeingAssistant\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <!-- 澶嶅埗鍒?bin\x64\Debug\...\Tools\锛堝甫 x64 骞冲彴鐩綍锛岀敤鎴峰疄闄呰繍琛岃矾寰勶級 -->
    <Copy SourceFiles="@(AssistOut)"
          DestinationFiles="@(AssistOut->'$(MSBuildProjectDirectory)\..\BetterGenshinImpact\bin\x64\$(Configuration)\net8.0-windows10.0.22621.0\Tools\MultiplayerHoeingAssistant\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <NormalizeWindowsLauncherIntegrity Files="$(MSBuildProjectDirectory)\..\BetterGenshinImpact\bin\$(Configuration)\net8.0-windows10.0.22621.0\Tools\MultiplayerHoeingAssistant\MultiplayerHoeingAssistant.exe;$(MSBuildProjectDirectory)\..\BetterGenshinImpact\bin\$(Configuration)\net8.0-windows10.0.22621.0\Tools\MultiplayerHoeingAssistant\NexusBGI.Startup.exe;$(MSBuildProjectDirectory)\..\BetterGenshinImpact\bin\x64\$(Configuration)\net8.0-windows10.0.22621.0\Tools\MultiplayerHoeingAssistant\MultiplayerHoeingAssistant.exe;$(MSBuildProjectDirectory)\..\BetterGenshinImpact\bin\x64\$(Configuration)\net8.0-windows10.0.22621.0\Tools\MultiplayerHoeingAssistant\NexusBGI.Startup.exe" Condition="'$(OS)' == 'Windows_NT'" />
  </Target>

  <!-- Git 可用时记录实际构建提交；独立 Docker 构建可显式传入 SourceRevisionId。 -->
  <Target Name="AddLegalSourceRevision" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="InitializeSourceControlInformation">
    <ItemGroup Condition="'$(SourceRevisionId)' != ''">
      <AssemblyMetadata Include="SourceRevisionId" Value="$(SourceRevisionId)" />
    </ItemGroup>
  </Target>

  <Import Project="LoginStartup.targets" />

  <ItemGroup>
    <ProjectReference Include="StartupLauncher\MultiplayerHoeingAssistant.Startup.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\BgiCoordinatorServer\Services\OpenSourceInfo.cs" Link="Services\Shared\OpenSourceInfo.cs" />
    <Compile Include="..\Mistletoe.Shared\ContinuousCliCommandRelay.cs" Link="Services\Shared\ContinuousCliCommandRelay.cs" />
    <Compile Include="..\Mistletoe.Shared\CoordinatedStopSignal.cs" Link="Services\Shared\CoordinatedStopSignal.cs" />
    <Compile Include="..\BetterGenshinImpact\Service\ExternalInterface\TerminalEffectJournal.cs" Link="Services\TaskCenter\TerminalEffectJournal.cs" />
    <Compile Include="..\Test\OneDragonMigration\Core\MigrationModels.cs" Link="Services\TaskCenter\Migration\MigrationModels.cs" />
    <Compile Include="..\Test\OneDragonMigration\Core\OneDragonMigrationEngine.cs" Link="Services\TaskCenter\Migration\OneDragonMigrationEngine.cs" />
  </ItemGroup>
  <Import Project="..\Build\WindowsLauncherIntegrity.targets" />
  <!-- 本机网页资源随助手内嵌，离线启动不依赖协调服务目录。 -->
  <ItemGroup>
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\legal.html" LogicalName="LocalBrowser/legal.html" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\legal.css" LogicalName="LocalBrowser/legal.css" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\legal.js" LogicalName="LocalBrowser/legal.js" />
    <EmbeddedResource Include="LICENSE" LogicalName="LocalBrowser/legal/LICENSE.txt" />
    <EmbeddedResource Include="README.md" LogicalName="LocalBrowser/legal/README.txt" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.md" LogicalName="LocalBrowser/legal/THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="licenses\**\*" LogicalName="LocalBrowser/legal/licenses/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Fonts\HarmonyOS-LICENSE.txt" LogicalName="LocalBrowser/legal/licenses/HarmonyOS-LICENSE.txt" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\local-dodoco.html" LogicalName="LocalBrowser/local-dodoco.html" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\local-dodoco.js" LogicalName="LocalBrowser/local-dodoco.js" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\local-dodoco.css" LogicalName="LocalBrowser/local-dodoco.css" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\signalr.min.js" LogicalName="LocalBrowser/signalr.min.js" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\control-room.js" LogicalName="LocalBrowser/control-room.js" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\control-room-commands.js" LogicalName="LocalBrowser/control-room-commands.js" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\control-room-ui.js" LogicalName="LocalBrowser/control-room-ui.js" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\control-room.css" LogicalName="LocalBrowser/control-room.css" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\project-star.css" LogicalName="LocalBrowser/project-star.css" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\dodoco-web.js" LogicalName="LocalBrowser/dodoco-web.js" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\dodoco-web.css" LogicalName="LocalBrowser/dodoco-web.css" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\dodoco-operations.js" LogicalName="LocalBrowser/dodoco-operations.js" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\dodoco-remote-logs.js" LogicalName="LocalBrowser/dodoco-remote-logs.js" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\dodoco-log-worker.js" LogicalName="LocalBrowser/dodoco-log-worker.js" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\mistletoe-core.js" LogicalName="LocalBrowser/mistletoe-core.js" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\mistletoe-startup.js" LogicalName="LocalBrowser/mistletoe-startup.js" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\mistletoe-startup-view.js" LogicalName="LocalBrowser/mistletoe-startup-view.js" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\mistletoe-taskcenter.js" LogicalName="LocalBrowser/mistletoe-taskcenter.js" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\mistletoe-web.js" LogicalName="LocalBrowser/mistletoe-web.js" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\mistletoe-web.css" LogicalName="LocalBrowser/mistletoe-web.css" />
    <EmbeddedResource Include="..\BgiCoordinatorServer\wwwroot\gengdi-avatars\*.png" LogicalName="LocalBrowser/gengdi-avatars/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
