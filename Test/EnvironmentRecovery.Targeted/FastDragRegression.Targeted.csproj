<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>BetterGenshinImpact.UnitTest</AssemblyName>
  </PropertyGroup>
  <Target Name="RequireValidationAssembly" BeforeTargets="ResolveReferences" Condition="!Exists('$(BgiValidationAssembly)')">
    <Error Text="请通过 BgiValidationAssembly 指定本次隔离编译的 BetterGI.dll。" />
  </Target>
  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="FsCheck.Xunit" Version="2.16.6" />
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <Reference Include="BetterGI"><HintPath>$(BgiValidationAssembly)</HintPath></Reference>
    <Compile Include="../BetterGenshinImpact.UnitTest/GameTaskTests/AutoPathingTests/FastDragFailureRecoveryTests.cs" />
    <Compile Include="../BetterGenshinImpact.UnitTest/GameTaskTests/AutoPathingTests/FastDragAreaSwitchSkipDecisionsTest.cs" />
    <Compile Include="../BetterGenshinImpact.UnitTest/GameTaskTests/AutoPathingTests/TeleportCdCompensationDecisionsTest.cs" />
    <Compile Include="../BetterGenshinImpact.UnitTest/GameTaskTests/AutoPathingTests/AutoTrackPositionRecoveryDecisionsTest.cs" />
  </ItemGroup>
</Project>
