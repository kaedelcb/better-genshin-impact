rce/MultiplayerHoeingAssistant/Services/TaskCenter/WorkflowRunner.cs:743\",\n        \"source/Test/MultiplayerHoeingAssistant.UnitTest/ServiceTests/TaskCenter/PathLoopCutoffTests.cs:15\"\n      ],\n      \"repair_steps\": [\n        \"Completed: FirstOccurrence and both structural restart branches use StructuralRoundEntry, preserving the primary entry and PathLane=0.\",\n        \"Completed: Runner binds round-start waiting to IsStructuralRoundEntry's stable node/occurrence identity.\",\n        \"Completed: Structural restart increments durable LoopIteration; explicitly selected back edges retain their existing target/lane semantics.\",\n        \"Completed: No lane quota, daily deduplication or scan of unselected branches was introduced.\"\n      ],\n      \"tests\": [\n        {\"test_id\": \"cbc65cd2-3741-cb57-df1d-5087715a15fd\", \"case\": \"StructuralLoop_RestartsPrimaryEntryAfterEarlierSecondaryNode(explicitEnd: True)\"},\n        {\"test_id\": \"9a7d16ef-05a4-ea04-4381-422b8551b41b\", \"case\": \"StructuralLoop_RestartsPrimaryEntryAfterEarlierSecondaryNode(explicitEnd: False)\"},\n        {\"test_id\": \"c8a95ff4-2aaa-a9d4-e33d-3262d847e05a\", \"case\": \"StructuralLoop_TwoRoundsSubmitOnlySelectedPrimaryWithFreshIdentity(explicitEnd: True)\"},\n        {\"test_id\": \"e6ed5485-3fa8-975d-99ba-7cdecb1bbc59\", \"case\": \"StructuralLoop_TwoRoundsSubmitOnlySelectedPrimaryWithFreshIdentity(explicitEnd: False)\"},\n        {\"test_id\": \"44de1881-ef12-d159-5469-941dcc230fad\", \"case\": \"ScheduledLoop_NonzeroPrimaryEntryStillWaitsForNextRound\"}\n      ],\n      \"closure_evidence\": [\n        \"PC/red/path-cutoff.trx: all five entry cases fail; actual second resource is secondary.\",\n        \"PC/green/path-cutoff.trx: all five pass, including distinct submission keys and PathLane=0.\",\n        \"PC/negative-entry/path-cutoff.trx: reverting only the two structural restart branches makes the same five cases fail; first entry remains correct.\",\n        \"PC/restored-entry/path-cutoff.trx and PC/restored/path-cutoff.trx: the five cases pass again.\",\n        \"PC/negative-entry-source-restored.json and independent byte comparison: both saved original files exactly equal the frozen current files.\",\n        \"PC/product-actual/actual-terminal-runs/run-7f32238e28d0.run.json: only primary at SequenceIndex=1, LoopIteration=0 and 1; LastScheduledRoundWait=1; zero secondary outcomes and zero resource submissions.\",\n        \"PC/product-actual/private/native-ui-source.jsonl: actual formal WPF startup and 02:23 terminal observation, with the retimed definition/revision bound to that persisted run.\",\n        \"Current Host.CreateRunner uses this shared WorkflowRunner, including the production arbitration boundary; no alternate Planner/Runner instance bypass was found.\"\n      ],\n      \"limits\": \"The five fake-boundary cases prove wrong-resource selection and fresh submission identity. The actual WPF condition flow proves shared primary entry and real round waiting; it does not prove resource/game effects or every unrelated explicit-entry permutation.\"\n    },\n    {\n      \"id\": \"LOOP-CUTOFF-TIMED-NODE-1\",\n      \"severity\": \"important\",\n      \"obligation\": \"implementation\",\n      \"status\": \"resolved_with_evidence\",\n      \"root_cause\": \"The prior pre-wait deadline check did not protect execution after an asynchronous timed-node wait. The wait could target a later node time and return execution permission after the absolute cutoff. Its shared scheduled-round expiry rule also lacked a post-node-wait application.\",\n      \"counterexample\": \"A 09:00 run with deadline 10:00 and a sequence/fixed resource at 11:00 previously invoked its prerequisite after the cutoff. A flexible node becoming idle only after cutoff also invoked it. The original expired scheduled-round case submitted late at 11:00 instead of skipping the old round.\",\n      \"paths\": [\n        \"source/MultiplayerHoeingAssistant/Services/TaskCenter/WorkflowRunner.cs:739\",\n        \"source/MultiplayerHoeingAssistant/Services/TaskCenter/WorkflowRunner.cs:772\",\n        \"source/MultiplayerHoeingAssistant/Services/TaskCenter/WorkflowRunner.cs:775\",\n        \"source/MultiplayerHoeingAssistant/Services/TaskCenter/WorkflowRunner.cs:776\",\n        \"source/MultiplayerHoeingAssistant/Services/TaskCenter/WorkflowRunner.cs:1627\",\n        \"source/MultiplayerHoeingAssistant/Services/TaskCenter/WorkflowRunner.cs:1648\",\n        \"source/MultiplayerHoeingAssistant/Services/TaskCenter/WorkflowRunner.cs:1668\",\n        \"source/MultiplayerHoeingAssistant/Services/TaskCenter/WorkflowNodeSchedule.cs:99\",\n        \"source/MultiplayerHoeingAssistant/Services/TaskCenter/WorkflowNodeSchedule.cs:117\",\n        \"source/Test/MultiplayerHoeingAssistant.UnitTest/ServiceTests/TaskCenter/PathLoopCutoffTests.cs:74\"\n      ],\n      \"repair_steps\": [\n        \"Completed: cap node waits at the earlier absolute loop deadline or applicable durable scheduled-round end.\",\n        \"Completed: sequence/fixed/flexible waits check their cutoff after wakeup; flexible polling checks around the actual idle-facts query.\",\n        \"Completed: DriveAsync reuses TrySettleLoopDeadline and SkipExpiredScheduledRound after node waiting, before condition/end handling, prerequisites or submission.\",\n        \"Completed: retain original SettleDeadlineWait checks for unresolved external facts, confirmed zero-send LocalWait, original binding and queue payload.\",\n        \"Completed: retain original stop authority, cancellation, pause records and already-started-node completion behavior.\"\n      ],\n      \"tests\": [\n        {\"test_id\": \"b2eeb1a9-d41e-0d57-a89b-6c9919631b01\", \"case\": \"TimedNode_CutoffConvergesBeforePrerequisiteAndSubmission(sequence, overshoot=False)\"},\n        {\"test_id\": \"64cc7781-a635-51b6-e456-6b3910dba24d\", \"case\": \"TimedNode_CutoffConvergesBeforePrerequisiteAndSubmission(fixed, overshoot=False)\"},\n        {\"test_id\": \"fbbdb024-3304-0309-6b97-8d074102a5cf\", \"case\": \"TimedNode_CutoffConvergesBeforePrerequisiteAndSubmission(sequence, overshoot=True)\"},\n        {\"test_id\": \"2b399b1b-9c32-7d08-6546-46447b61190a\", \"case\": \"FlexibleNode_IdleOnlyAfterCutoffDoesNotStart\"},\n        {\"test_id\": \"b0d3ab49-52d2-4544-dd10-89d759296286\", \"case\": \"ScheduledRound_TimedWaitCannotRunExpiredRemainder\"},\n        {\"test_id\": \"22401d1b-e5d1-c0b0-5f36-700ba7f29e83\", \"case\": \"StartedNodeMayFinishAfterCutoffButSuccessorDoesNotStart\"}\n      ],\n      \"closure_evidence\": [\n        \"PC/red/path-cutoff.trx: four absolute-deadline cases fail with prerequisite Expected 0/Actual 1; the old scheduled-round case fails because late was submitted at 11:00. The already-started positive case passes.\",\n        \"PC/green/path-cutoff.trx and both restored affected regressions: all six cases pass.\",\n        \"PC/negative-cutoff/path-cutoff.trx: removing the post-wait absolute deadline guard and node-wait cutoff cap makes four zero-prerequisite assertions fail with Actual 1. The scheduled-round test fails on waiting 2 hours instead of the expected 1 hour; its post-wait expiry guard remains active, so that mutant is not claimed to prove its independent absence.\",\n        \"PC/negative-cutoff-source-restored.json and independent comparison: both production files equal the saved original bytes and current frozen source.\",\n        \"PC/product-actual/fixtures-retimed/wf-own-cutoff-01a1176e.flow.json: node lower bound 02:23, loop cutoff 02:22, revision b32908d9272bb101368beaba593a0795d2456c2a3cb19d1f51d3f19fea91c580.\",\n        \"PC/product-actual/private/native-ui-source.jsonl line 118: actual WPF card shows waiting to 02:22.\",\n        \"PC/product-actual/actual-terminal-runs/run-3816f2d66d58.run.json: updated at 02:22:00.0558554+08:00, Succeeded, TailReached=true, Wait=null, StopRequested=false, no node outcomes/prerequisites/submission history, bound original deadline and terminal seal.\",\n        \"Affected regression includes original deadline/LocalWait/stop/pause/terminal/explicit-back-edge cases and retains exactly the original two unrelated LocalWait failures.\"\n      ],\n      \"limits\": \"This closes the supported timed-node waiting gap and bounded expiry behavior. The finite fake-boundary tests prove zero prerequisite/body-send calls; actual WPF observations prove shared wait/arrival settlement without resources. No gameplay acceptance, arbitrary timing stress or separate causal proof of every guard is claimed.\"\n    }\n  ],\n  \"unknowns\": [\n    {\n      \"id\": \"MANUAL-ACCEPTANCE-PENDING\",\n      \"status\": \"open\",\n      \"scope\": \"Whole-product runtime acceptance\",\n      \"detail\": \"Eight native game effects, native/group/JS/macro game execution, resource-execution SkipCurrent, correct account/redeem/team/co-op effects, game or combined exit and OS shutdown remain unaccepted.\",\n      \"evidence\": [\"U\", \"RT\", \"PC/product-actual/result.json\"],\n      \"delivery_effect\": \"Do not claim full-product runtime acceptance or complete the entire product Goal from this implementation report.\",\n      \"user_policy\": \"Await voluntary user feedback; do not demand new game/resource/stress fixtures.\"\n    },\n    {\n      \"id\": \"EXTERNAL-RUNTIME-DEPENDENCY-BOUNDARY\",\n      \"status\": \"open\",\n      \"scope\": \"Binary/native/external runtime boundary\",\n      \"detail\": \"The frozen project is textual. Recorded product/module identities and owned launches do not execute every native model or external dependency.\",\n      \"evidence\": [\"U\", \"PC/product-refresh/result.json\"],\n      \"delivery_effect\": \"Limits runtime conclusions. No concrete new missing dependency was established and no unconditional SDK certification project is required.\"\n    },\n    {\n      \"id\": \"HISTORICAL-CERTIFICATION-BOUNDARIES\",\n      \"status\": \"retained_open\"