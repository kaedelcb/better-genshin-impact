①：显式动作 + 修订对账（新修订按稳定身份重算后继；链尾亦对账，B1）\r\n700:                 (plan, occurrence) = ProcessBoundaryActions(run, plan, occurrence, control);\r\n701:                 if (occurrence is null)\r\n702:                 {\r\n703:                     // [BO-9 / R34 F5 重要；第 1 轮会诊 IMPORTANT-1 修复] 真实链尾：线性推进\r\n704:                     // （plan.Next）到不了本链的更晚义务——无循环定义时既不回绕到更高轮次停驻\r\n705:                     // （如 A@loop2），也到不了 RecomputeSuccessor 已选中但尚未履行的 rescue\r\n706:                     // （如 [A,P] + A@0 完成 + P@1/P@2 停驻 ⇒ rescue A@1）。按计划全序重建并重入\r\n707:                     // 最早的未履行恢复义务，避免「零发送义务/未执行出现被静默吞」后假成功。\r\n708:                     // 终止性：每次重入都驱动该出现一次（完成或被过滤 ⇒ 离开义务集合；再次停驻或\r\n709:                     // unknown ⇒ 驱动立即返回），义务集合严格收缩；重入后若经暂停/取消/修订边界返回，\r\n710:                     // 驱动本身结束，不构成自旋。入口即链尾（持久 TailReached）不由本路径重开。\r\n711:                     if (!enteredAtTail && TryRelocateToOutstandingObligation(run, plan, out var obligation))\r\n712:                     {\r\n713:                         Log(run, $\"链尾仍存未履行的恢复义务 {obligation!.NodeId}#{obligation.Occurrence}\"\r\n714:                                  + $\"（轮次 {obligation.LoopIteration}）：按计划全序重入重驱，不按链尾放行。\");\r\n715:                         occurrence = obligation;\r\n716:                         ApplyRelocation(run, occurrence);\r\n717:                         _runs.Update(run);\r\n718:                         continue;\r\n719:                     }\r\n720:                     break; // 链尾（TailReached 已落盘）\r\n721:                 }\r\n722: \r\n723:                 // B3-③：提交终态已观察但结果未提交（仅遗留/手工记录可达；正常路径单次写已消除窗口）\r\n724:                 // ——按提交事实补记结果，绝不重跑该节点\r\n725:                 if (run.CurrentSubmission is { ObservedTerminal: { } observed } pendingSub\r\n726:                     && pendingSub.NodeId == occurrence.NodeId\r\n727:                     && pendingSub.Occurrence == occurrence.Occurrence\r\n728:                     && pendingSub.LoopIteration == occurrence.LoopIteration)\r\n729:                 {\r\n730:                     var mapped = MapTerminal(observed);\r\n731:                     Log(run, $\"提交 {pendingSub.Key} 终态已观察（{observed}）但结果未提交，按事实补记，不重跑。\");\r\n732:                     CommitOutcome(run, plan, occurrence, mapped.Result, mapped.Reason, rawTerminal: observed); // I2：ObservedTerminal 已是原始词\r\n733:                     if (mapped.Result == \"cancelled\") throw new OperationCanceledException();\r\n734:                     if (mapped.Result is \"failed\" or \"rejected\" && !_opt.ContinueOnNodeFailure) break;\r\n735:                     occurrence = Relocate(run, plan);\r\n736:                     continue;\r\n737:                 }\r\n738: \r\n739:                 if (TrySettleLoopDeadline(run, plan)) break;\r\n740:                 if (SkipExpiredScheduledRound(run, plan, occurrence, out var nextRound))\r\n741:                 { occurrence = nextRound; continue; }\r\n742:                 // B9：轮次起点等待统一在新一轮边界（成功/过滤跳过/失败续跑同路径；不占槽位）\r\n743:                 if (occurrence.LoopIteration > 0 && plan.IsStructuralRoundEntry(occurrence)\r\n744:                     && occurrence.LoopIteration != run.LastScheduledRoundWait)\r\n745:                 {\r\n746:                     if (!await AwaitLoopRoundStartAsync(run, plan, occurrence, control, ct).ConfigureAwait(false))\r\n747:                     {\r\n748:                         if (run.LoopDeadlineAt is null) flowFailure = true;\r\n749:                         else { ApplyRelocation(run, null); _runs.Update(run); }\r\n750:                         break;\r\n751:                     }\r\n752:                     if (control.PauseRequested) return Pause(run);\r\n753:                     if (run.LoopDeadlineAt is { } deadline && _opt.Clock() >= deadline)\r\n754:                     { ApplyRelocation(run, null); _runs.Update(run); break; }\r\n755:                 }\r\n756: \r\n757:                 EnsureScheduledRoundEnd(run, plan);\r\n758: \r\n759:                 // [BO-8] 恢复点或修订重排可能落在已完成出现之前。停驻义务照常重驱，但任何已完成\r\n760:                 // 稳定出现都不得二次提交。逐步推进（每步一个出现）保留定义边界与轮次起点处理。\r\n761:                 if (HasCompletedOutcome(run, occurrence))\r\n762:                 {\r\n763:                     Log(run, $\"推进过滤已完成出现 {occurrence.NodeId}#{occurrence.Occurrence}\"\r\n764:                              + $\"（轮次 {occurrence.LoopIteration}）：按稳定身份跳过，不二次提交。\");\r\n765:                     occurrence = plan.Next(occurrence);\r\n766:                     ApplyRelocation(run, occurrence);\r\n767:                     _runs.Update(run);\r\n768:                     continue;\r\n769:                 }\r\n770: \r\n771:                 var node = plan.NodeAt(occurrence);\r\n772:                 var scheduleResult = await AwaitNodeScheduleAsync(run, plan, node, occurrence, control, ct).ConfigureAwait(false);\r\n773:                 if (control.PauseRequested) return Pause(run);\r\n774:                 // 等待醒来后重新检查持久截止，不能把到点等待当成新节点执行许可。\r\n775:                 if (TrySettleLoopDeadline(run, plan)) break;\r\n776:                 if (SkipExpiredScheduledRound(run, plan, occurrence, out var afterExpiredRound))\r\n777:                 { occurrence = afterExpiredRound; continue; }\r\n778:                 if (!scheduleResult)\r\n779:                 {\r\n780:                     CommitOutcome(run, plan, occurrence, \"skippedFilter\", \"节点固定时刻或灵活窗口已错过\");\r\n781:                     occurrence = Relocate(run, plan);\r\n782:                     continue;\r\n783:                 }\r\n784:                 if (node.Kind == \"control.condition\")\r\n785:                 {\r\n786:                     bool answer;\r\n787:                     try { answer = plan.EvaluatePathCondition(node, _opt.Clock(), run); }\r\n788:                     catch (WorkflowObservationUnknownException ex)\r\n789:                     {\r\n790:                         run.State=WorkflowRunState.Unknown;run.Note=AppendNote(run.Note,ex.Message);\r\n791:                         _runs.Update(run);return run;\r\n792:                     }\r\n793:                     CommitOutcome(run, plan, occurrence, answer ? \"branchYes\" : \"branchNo\", \"条件在本次到达求值，所选去向与结果同写落盘\");\r\n794:                     occurrence = Relocate(run, plan); continue;\r\n795:                 }\r\n796:                 if (node.Kind == \"control.end\")\r\n797:                 {\r\n798:                     CommitOutcome(run, plan, occurrence, \"succeeded\", \"已到达结束流程节点\");\r\n799:                     occurrence = Relocate(run, plan); continue;\r\n800:                 }\r\n801:                 var gate = plan.EvaluateNode(occurrence, _opt.Clock(), _boundary.SingleNativeSupported);\r\n802:                 if (gate.Action == NodeGateAction.Skip)\r\n803:                 {\r\n804:                     Log(run, $\"节点 {occurrence.NodeId}#{occurrence.LoopIteration} 过滤跳过：{gate.Reason}\");\r\n805:                     CommitOutcome(run, plan, occurrence, \"skippedFilter\", gate.Reason);\r\n806:                     occurrence = Relocate(run, plan);\r\n807:                     continue;\r\n808:                 }\r\n809:                 if (gate.Action == NodeGateAction.Reject)\r\n810:                 {\r\n811:                     Log(run, $\"节点 {occurrence.NodeId}#{occurrence.LoopIteration} 响亮拒绝：{gate.Reason}\");\r\n812:                     CommitOutcome(run, plan, occurrence, \"rejected\", gate.Reason);\r\n813:                     if (!_opt.ContinueOnNodeFailure) break;\r\n814:                     occurrence = Relocate(run, plan);\r\n815:                     continue;\r\n816:                 }\r\n817: \r\n818:                 // 前置策略（D8 + R4.6 结构化结果：Proceed/Failed/Rejected/Cancelled/Unknown；\r\n819:                 // 前置段已建立叶子令牌，SkipCurrent 可取消在飞前置并经确认链对账）\r\n820:                 if (await ExecutePrerequisitesAsync(run, node, occurrence, control, ct).ConfigureAwait(false) is { } prereqOutcome)\r\n821:                 {\r\n822:                     if (prereqOutcome.Result is \"unknown\" or \"cancelUnconfirmed\")\r\n823:                     {\r\n824:    