<UserControl x:Class="MultiplayerHoeingAssistant.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:MultiplayerHoeingAssistant.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignWidth="700"
             mc:Ignorable="d">

    <!-- 本页面复用 MainWindow.Resources 中定义的样式和颜色（GoldScrollViewer、QuestCard、GuildCheckBox、BtnGold、GoldText、White、Dim 等）。
         作为 UserControl 放在 MainWindow 内部，可视树继承父级资源，不需额外引用。 -->

    <!-- 自包含 ComboBox 样式（MainWindow 未定义，此处独立提供） -->
    <!-- 注意：所有 StaticResource 在 UserControl.Resources 内部引用父级 Window 资源时
         必须使用 DynamicResource，因为 StaticResource 在编译时解析，UserControl 的
         资源字典无法向上查找父级 Window 的 Resources。 -->
    <UserControl.Resources>
        <!-- 本 UserControl 的 StaticResource 无法向上找到 MainWindow 资源，转换器需自带（同 DodocoPage） -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 折叠卡片通用 Expander 模板：默认模板头部带虚线焦点框且不横向拉伸，
             此处自绘——整行可点、无焦点虚线框，头部内容（标题/右侧"设置项"）由 Header 提供 -->
        <Style x:Key="CardExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ToggleButton Grid.Row="0"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" Cursor="Hand"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Background="Transparent" BorderThickness="0" Padding="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Stretch"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Grid.Row="1"
                                              Visibility="Collapsed"
                                              Content="{TemplateBinding Content}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 折叠卡片头部右侧的小箭头：展开时翻转朝上 -->
        <Style x:Key="CardChevron" TargetType="Path">
            <Setter Property="Data" Value="M 0,0 L 4,4 L 8,0"/>
            <Setter Property="Stroke" Value="{DynamicResource Dim}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,1,0,0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <RotateTransform Angle="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                    <Setter Property="LayoutTransform">
                        <Setter.Value>
                            <RotateTransform Angle="180"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 设置页二态开关：用于桌宠设置，避免圆形勾选框与普通任务选择混淆。 -->
        <Style x:Key="SettingsSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="38" Height="22">
                            <Border x:Name="Track" CornerRadius="11" Background="#554F718F"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"
                                     Fill="{DynamicResource White}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource GoldBtnGrad}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PetSectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource GoldText}"/>
        </Style>

        <Style x:Key="PetSettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource White}"/>
        </Style>

        <Style x:Key="PetSettingHelp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 鎏金下拉选择框（原神风格）：ToggleButton 控制开合，Popup 显示下拉项 -->
        <Style x:Key="GoldComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="#2A1C1640"
                                                BorderBrush="#B0D4AF37"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="8,0,7,0">
                                            <Grid TextElement.Foreground="#FFFFFF"
                                                  TextElement.FontFamily="{DynamicResource ContentControlThemeFontFamily}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  TextElement.Foreground="#FFFFFF"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  IsHitTestVisible="False"/>
                                                <Path Grid.Column="1"
                                                      Data="M 0,0 L 4,4 L 8,0"
                                                      Stroke="{DynamicResource Gold}"
                                                      StrokeThickness="1.6"
                                                      StrokeLineJoin="Round"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3B2E1A40"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F0E8C96D"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#38251040"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   StaysOpen="False"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220" Margin="0,4,0,0">
                                    <Border Background="#232048"
                                            BorderBrush="{DynamicResource GoldLine}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="2"
                                            Effect="{DynamicResource CardShadow}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      Style="{DynamicResource GoldScrollViewer}">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 鎏金下拉选项 -->
        <Style x:Key="GoldComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="5" Padding="10,7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3DD4AF37"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B2E1A"/>
                                <Setter Property="Foreground" Value="{DynamicResource GoldText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{DynamicResource GoldScrollViewer}">
        <StackPanel Margin="0,0,0,24">

            <!-- ========== 顶栏（返回按钮） ========== -->
            <Grid Margin="0,0,0,16">
                <Button Content="←  返回" Style="{DynamicResource BtnGhost}" Padding="12,5"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Command="{Binding CloseSettingsCommand}"/>
            </Grid>

            <!-- ========== 卡片：房间设置 ========== -->
            <Border Style="{DynamicResource QuestCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="房间设置" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource White}"/>
                        <TextBlock Text="服务器地址、房间密码、玩家信息、UID、BGI 路径"
                                   FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="打开房间设置" Style="{DynamicResource BtnGold}"
                            Command="{Binding OpenRoomSettingsCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ========== 卡片：启动策略（折叠式，与桌宠卡片同款交互） ========== -->
            <Border Style="{DynamicResource QuestCard}" Margin="0,0,0,16">
                <Expander IsExpanded="False" Margin="0,0,0,4" Style="{StaticResource CardExpander}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="助手启动策略" FontSize="15" FontWeight="Medium"
                                       Foreground="{DynamicResource White}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,4,0,0">
                                <TextBlock Text="设置项" FontSize="12" Foreground="{DynamicResource Dim}"/>
                                <Path Style="{StaticResource CardChevron}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">

                    <!-- ① 随 BGI 启动 -->
                    <Border Background="#1E262660" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding AutoLaunchWithBgi, Mode=TwoWay}"
                                      Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Top" Margin="0,2,16,0" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="随 BGI 启动" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource White}"/>
                                <TextBlock Text="检测到 BGI 进程存在时自动启动助手"
                                           FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="2" Width="150"
                                      IsEnabled="{Binding AutoLaunchWithBgi}"
                                      SelectedIndex="{Binding AutoLaunchWithBgiModeIndex}"
                                      Style="{DynamicResource GoldComboBox}"
                                      VerticalAlignment="Center">
                                <!-- 闭合态显示两字短标签（Content），下拉经 ItemTemplate 显示完整选项（与启动中心同款交互） -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBoxItem Content="弹窗" Tag="弹窗启动" Style="{DynamicResource GoldComboItem}"/>
                                <ComboBoxItem Content="静默" Tag="静默缩小到托盘" Style="{DynamicResource GoldComboItem}"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- ② 开机自启动 -->
                    <Border Background="#1E262660" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding AutoLaunchOnBoot, Mode=TwoWay}"
                                      Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Top" Margin="0,2,16,0" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="开机自启动" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource White}"/>
                                <TextBlock Text="系统启动时自动启动助手"
                                           FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="2" Width="150"
                                      IsEnabled="{Binding AutoLaunchOnBoot}"
                                      SelectedIndex="{Binding AutoLaunchOnBootModeIndex}"
                                      Style="{DynamicResource GoldComboBox}"
                                      VerticalAlignment="Center">
                                <!-- 闭合态显示两字短标签（Content），下拉经 ItemTemplate 显示完整选项（与启动中心同款交互） -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBoxItem Content="弹窗" Tag="弹窗启动" Style="{DynamicResource GoldComboItem}"/>
                                <ComboBoxItem Content="静默" Tag="静默缩小到托盘" Style="{DynamicResource GoldComboItem}"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- ③ 守护 BGI（监控模式下隐藏：本机不创建 BGI 进程监控器） -->
                    <Border Background="#1E262660" CornerRadius="8" Padding="12,10"
                            Visibility="{Binding IsExecutorMode, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding GuardBgi, Mode=TwoWay}"
                                      Style="{DynamicResource GuildCheckBox}" VerticalAlignment="Top" Margin="0,2,16,0" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="守护 BGI" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource White}"/>
                                <TextBlock Text="助手运行时，BGI 异常退出则自动重启 BGI"
                                           FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    </StackPanel>
                </Expander>
            </Border>

            <!-- ========== 卡片：奥黛塔桌宠（Pet 挂在 Window 上，绑定走 RelativeSource Window） ========== -->
            <Border Style="{DynamicResource QuestCard}" Margin="0,0,0,16">
                <!-- 默认收起且不记忆展开状态（见代码后置 IsVisibleChanged）。
                     展开后按“总开关 → 外观 → 状态面板 → 声音与交互”阅读。 -->
                <Expander x:Name="PetSettingsExpander" IsExpanded="False" Margin="0,0,0,4"
                          Style="{StaticResource CardExpander}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="奥黛塔桌宠" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource White}"/>
                                <TextBlock Text="桌面常驻的 Q 版徽章宠物，表情随任务状态变化；拖拽移动、滚轮缩放、双击唤出主窗口"
                                           FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,4,0,0">
                                <TextBlock FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="已关闭"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Pet.Enabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Text" Value="已开启"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource GoldText}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Path Style="{StaticResource CardChevron}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="0,10,0,0">
                        <!-- 总开关保持始终可用；关闭时其他外观/面板/声音设置保留但不可编辑。 -->
                        <Border Background="#1E262660" CornerRadius="8" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="显示桌宠" Style="{StaticResource PetSettingLabel}"/>
                                    <TextBlock Text="关闭后桌宠完全隐藏，大小、位置和其他设置保持不变"
                                               Style="{StaticResource PetSettingHelp}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding Pet.Enabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                          Style="{StaticResource SettingsSwitch}"/>
                            </Grid>
                        </Border>

                        <!-- 外观与显示 -->
                        <StackPanel Margin="0,18,0,0"
                                    IsEnabled="{Binding Pet.Enabled, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock Text="外观与显示" Style="{StaticResource PetSectionHeading}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 大小：滚轮缩放与此值共用 -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <Grid>
                                        <TextBlock Text="大小" Style="{StaticResource PetSettingLabel}"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource Dim}"
                                                   Text="{Binding Pet.SizePx, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0:0} px}"/>
                                    </Grid>
                                    <Slider Minimum="50" Maximum="250" TickFrequency="10" IsSnapToTickEnabled="True"
                                            Value="{Binding Pet.SizePx, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                            Margin="0,7,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <Grid>
                                        <TextBlock Text="透明度" Style="{StaticResource PetSettingLabel}"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource Dim}"
                                                   Text="{Binding Pet.PetOpacity, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0:P0}}"/>
                                    </Grid>
                                    <Slider Minimum="0.3" Maximum="1"
                                            Value="{Binding Pet.PetOpacity, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                            Margin="0,7,0,0"/>
                                </StackPanel>

                                <Grid Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="窗口置顶" Style="{StaticResource PetSettingLabel}"/>
                                        <TextBlock Text="始终显示在其他窗口上方" Style="{StaticResource PetSettingHelp}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding Pet.Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                              Style="{StaticResource SettingsSwitch}"/>
                                </Grid>

                                <Grid Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="任务标签" Style="{StaticResource PetSettingLabel}"/>
                                        <TextBlock Text="在桌宠旁显示当前任务" Style="{StaticResource PetSettingHelp}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding Pet.ShowTaskLabel, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                              Style="{StaticResource SettingsSwitch}"/>
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="#334F4B72" Margin="0,18,0,0"/>

                        <!-- 任务状态面板：开关和从属透明度不再争抢同一行宽度。 -->
                        <StackPanel Margin="0,18,0,0"
                                    IsEnabled="{Binding Pet.Enabled, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock Text="任务状态面板" Style="{StaticResource PetSectionHeading}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="显示独立状态面板" Style="{StaticResource PetSettingLabel}"/>
                                    <TextBlock Text="展示锄地进度、线路和好感轮次，可单独拖动、调整大小或关闭"
                                               Style="{StaticResource PetSettingHelp}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding Pet.PanelEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                          Style="{StaticResource SettingsSwitch}"/>
                            </Grid>
                            <StackPanel Margin="0,14,0,0"
                                        IsEnabled="{Binding Pet.PanelEnabled, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Grid>
                                    <TextBlock Text="面板透明度" Style="{StaticResource PetSettingLabel}"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource Dim}"
                                               Text="{Binding Pet.PanelOpacity, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0:P0}}"/>
                                </Grid>
                                <Slider Minimum="0.3" Maximum="1"
                                        Value="{Binding Pet.PanelOpacity, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                        Margin="0,7,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="#334F4B72" Margin="0,18,0,0"/>

                        <!-- 声音与交互 -->
                        <StackPanel Margin="0,18,0,0">
                            <TextBlock Text="声音与交互" Style="{StaticResource PetSectionHeading}"/>
                            <Grid Margin="0,12,0,0"
                                  IsEnabled="{Binding Pet.Enabled, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Grid>
                                        <TextBlock Text="提示音量" Style="{StaticResource PetSettingLabel}"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource Dim}"
                                                   Text="{Binding Pet.SoundVolume, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0:P0}}"/>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="1"
                                            Value="{Binding Pet.SoundVolume, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                            Margin="0,7,0,0"/>
                                </StackPanel>
                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="静音" Style="{StaticResource PetSettingLabel}"/>
                                        <TextBlock Text="保留音量设置，暂停播放提示音" Style="{StaticResource PetSettingHelp}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding Pet.SoundMuted, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                              Style="{StaticResource SettingsSwitch}"/>
                                </Grid>
                            </Grid>

                            <!-- 穿透不依赖桌宠当前是否显示，保证始终可以在设置页解除。 -->
                            <Border Background="#263B3219" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="鼠标穿透" Style="{StaticResource PetSettingLabel}"/>
                                            <Border Background="#283B3219" CornerRadius="7" Padding="7,2" Margin="8,0,0,0">
                                                <TextBlock Text="需从托盘恢复" FontSize="10" Foreground="{DynamicResource GoldText}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="开启后桌宠和状态面板不再响应拖动、滚轮、双击和右键；可从助手托盘菜单或此处关闭"
                                                   Style="{StaticResource PetSettingHelp}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding Pet.ClickThrough, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                              Style="{StaticResource SettingsSwitch}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- ========== 卡片：配置迁移（一键导出/导入全部设置，跨机器搬家用） ========== -->
            <Border Style="{DynamicResource QuestCard}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="配置迁移" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource White}"/>
                        <TextBlock Text="一键导出/导入全部助手设置：房间、启动策略、启动流程方案、嘟嘟可、监控规则、桌宠、成员配置；导入自动备份原设置"
                                   FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   MaxWidth="400" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="导出全部设置" Style="{DynamicResource BtnGold}" Margin="0,0,8,0"
                                Command="{Binding ExportAllSettingsCommand}"/>
                        <Button Content="导入全部设置" Style="{DynamicResource BtnGold}"
                                Command="{Binding ImportAllSettingsCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== 卡片：关于 ========== -->
            <Border Style="{DynamicResource QuestCard}">
                <StackPanel>
                    <TextBlock Text="关于" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource White}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Nexus-BGI 联机助手 · 提瓦特生物灭绝计划"
                               FontSize="12" Foreground="{DynamicResource Dim}"/>
                    <TextBlock Text="配置保存于 assistant-config.json，修改后自动生效"
                               FontSize="11" Foreground="{DynamicResource Dim}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
