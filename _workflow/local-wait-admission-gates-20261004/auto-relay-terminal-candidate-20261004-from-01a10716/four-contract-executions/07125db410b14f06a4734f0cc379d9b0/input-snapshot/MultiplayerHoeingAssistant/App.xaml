<Application x:Class="MultiplayerHoeingAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        应用级暗色金资源：GoldComboBox/GoldComboItem 从 SettingsPage.xaml 页面级资源复制到此处，
        供代码构建的弹窗（如上线锄地「绑定」弹窗 Window，不在 MainWindow 可视树内）解析使用。
        模板内交叉引用一律用 DynamicResource（运行时从 Application.Resources 解析，
        避免 StaticResource 在独立字典中的前向引用/解析时机问题）。
        相比页面版补充了 PART_EditableTextBox：绑定弹窗的「指定任务名称」下拉框 IsEditable=True，
        缺该部件时无法手动输入。
    -->
    <Application.Resources>
        <!-- ========== 原神夜空色板（ComboBox 样式所需的最小集） ========== -->
        <SolidColorBrush x:Key="Gold" Color="#E8C96D"/>
        <SolidColorBrush x:Key="GoldText" Color="#F2E3B6"/>
        <SolidColorBrush x:Key="GoldLine" Color="#80D4AF37"/>

        <!-- 卡片阴影（下拉弹出层描边投影用） -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#0A081E"/>

        <!-- ========== 自定义滚动条（原神鎏金细窄款，供 GoldScrollViewer 用） ========== -->
        <Style x:Key="GoldVScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Width="{TemplateBinding Width}">
                                <Track.Thumb>
                                    <Thumb HorizontalAlignment="Stretch">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        CornerRadius="3"
                                                        Background="#50D4AF37"
                                                        BorderThickness="0"
                                                        HorizontalAlignment="Stretch"
                                                        SnapsToDevicePixels="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.3" Color="#D4AF37"/>
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#B0D4AF37"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#E0D4AF37"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoldHScrollBar" TargetType="ScrollBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" Orientation="Horizontal" Height="{TemplateBinding Height}">
                                <Track.Thumb>
                                    <Thumb VerticalAlignment="Stretch">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        CornerRadius="3"
                                                        Background="#50D4AF37"
                                                        BorderThickness="0"
                                                        VerticalAlignment="Stretch"
                                                        SnapsToDevicePixels="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.3" Color="#D4AF37"/>
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#B0D4AF37"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#E0D4AF37"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoldScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <!-- 滚动条列宽固定常驻，出现/消失不改变内容区宽度（与 MainWindow 版保持一致） -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Row="0" Grid.Column="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0" Grid.Column="1"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Style="{DynamicResource GoldVScrollBar}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1" Grid.Column="0"
                                       Orientation="Horizontal"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Style="{DynamicResource GoldHScrollBar}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 鎏金下拉选择框（原神风格）：ToggleButton 控制开合，Popup 显示下拉项（弹出层同为暗色） -->
        <Style x:Key="GoldComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="#2A1C1640"
                                                BorderBrush="#B0D4AF37"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="8,0,7,0">
                                            <Grid TextElement.Foreground="#FFFFFF"
                                                  TextElement.FontFamily="{DynamicResource ContentControlThemeFontFamily}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter x:Name="ContentSite"
                                                                  Grid.Column="0"
                                                                  TextElement.Foreground="#FFFFFF"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  IsHitTestVisible="False"/>
                                                <Path Grid.Column="1"
                                                      Data="M 0,0 L 4,4 L 8,0"
                                                      Stroke="{DynamicResource Gold}"
                                                      StrokeThickness="1.6"
                                                      StrokeLineJoin="Round"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3B2E1A40"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F0E8C96D"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#38251040"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                                            </Trigger>
                                            <!-- 可编辑模式：隐藏选中项展示，改由 PART_EditableTextBox 输入 -->
                                            <DataTrigger Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="True">
                                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- 可编辑下拉的输入框（默认模板契约部件，IsEditable=True 时显示） -->
                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="9,0,26,0"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FFFFFF"
                                     CaretBrush="#E8C96D"
                                     Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   StaysOpen="False"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220" Margin="0,4,0,0">
                                    <Border Background="#232048"
                                            BorderBrush="{DynamicResource GoldLine}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="2"
                                            Effect="{DynamicResource CardShadow}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      Style="{DynamicResource GoldScrollViewer}">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 鎏金下拉选项（弹出层内：深色底 + 金色悬停/选中） -->
        <Style x:Key="GoldComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="5" Padding="10,7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3DD4AF37"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B2E1A"/>
                                <Setter Property="Foreground" Value="{DynamicResource GoldText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 统一暗色鎏金右键菜单（桌宠 / 任务状态面板 / 托盘三处共用） ==========
             为什么必须连 ContextMenu 模板一起接管：Aero2 的 ContextMenu 模板在滚动内容层之上
             还叠了一组系统菜单装饰矩形——整幅底色 OpaqueRect、图标勾选栏 28 宽浅色矩形
             （实测 Fill=#FFF1F1F1）、上下 1px 边线（#FFE2E3E3 / #FFFFFFFF）。
             它们画在 ContextMenu.Background 之上，MenuItem.Background=Transparent 覆盖不到，
             运行期就会看到菜单左侧一条白色勾选栏（用户截图实测像素 #F1F1F1）。
             因此只改 MenuItem 模板无效，必须同时提供 ContextMenu 模板。 -->
        <ControlTemplate x:Key="AssistantContextMenuTemplate" TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <!-- 保留 ScrollViewer：菜单异常变长时仍可滚动；这些菜单只有几项，滚动条不会常驻 -->
                <ScrollViewer Focusable="False"
                              CanContentScroll="True"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </ScrollViewer>
            </Border>
        </ControlTemplate>

        <Style TargetType="ContextMenu">
            <!-- 与 GoldComboBox 下拉弹出层同色系：不透明深紫底 + 金色发丝描边 + 圆角
                 （ContextMenu 内部 Popup 的 AllowsTransparency 实测为 True，圆角不会露白角） -->
            <Setter Property="Background" Value="#FF232048"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GoldLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template" Value="{DynamicResource AssistantContextMenuTemplate}"/>
        </Style>

        <!-- 菜单项模板：接管勾选列（金色对勾）、行内高亮、子菜单箭头与子菜单弹出层暗底。
             勾选列改为定宽 20，勾选项与普通项的文字左缘始终对齐，不再依赖系统 SharedSizeGroup。 -->
        <ControlTemplate x:Key="AssistantMenuItemTemplate" TargetType="MenuItem">
            <Grid>
                <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="CheckMark"
                              Grid.Column="0"
                              Data="M 0,5 L 3.6,8.6 L 10,1.6"
                              Stroke="{DynamicResource Gold}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"/>
                        <ContentPresenter Grid.Column="1"
                                          ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{TemplateBinding InputGestureText}"
                                   Margin="12,0,0,0"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"/>
                        <Path x:Name="SubmenuArrow"
                              Grid.Column="3"
                              Data="M 0,0 L 4,4 L 0,8"
                              Stroke="{DynamicResource Gold}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Margin="10,0,2,0"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Right"
                       HorizontalOffset="-2"
                       VerticalOffset="-3"
                       PopupAnimation="Fade">
                    <Border Background="#FF232048"
                            BorderBrush="{DynamicResource GoldLine}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                    <Setter Property="Foreground" Value="{DynamicResource GoldText}"/>
                </Trigger>
                <Trigger Property="HasItems" Value="True">
                    <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#40D4AF37"/>
                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#66D4AF37"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#809690A8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F2E8D5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template" Value="{DynamicResource AssistantMenuItemTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#809690A8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 分隔线：金色发丝线，替代系统菜单的浅灰 1px 线（实测 #D7D7D7）。
             菜单里的 Separator 由 MenuBase 通过 MenuItem.SeparatorStyleKey 取样式，
             隐式 Style TargetType=Separator 不生效，必须按该键注册。 -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="#33D4AF37" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
