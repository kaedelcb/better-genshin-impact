+        run.NodeOutcomes.Add(new WorkflowNodeOutcome
+        { NodeId = "B", SequenceIndex = 2, Occurrence = 0, LoopIteration = 0, Result = "succeeded" });
+        run.NodeOutcomes.Add(new WorkflowNodeOutcome
